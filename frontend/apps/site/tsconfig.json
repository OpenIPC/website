{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "*.config.mjs", "*.config.ts"],
  "exclude": ["dist"]
}
