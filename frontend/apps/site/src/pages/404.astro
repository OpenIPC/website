---
/**
 * The page nginx answers with when nothing claims an address (#304).
 *
 * Rails rendered public/404.html for a SoC slug that is not in the catalogue
 * and for the few addresses its router matched with nothing behind them. Rails
 * is gone; the vhost's @fallback answers the route map's redirects and 410s
 * itself, and everything else it cannot place gets this file, with a 404
 * status, through `error_page 404 /404.html`. Most unknown addresses never get
 * here -- the route map sends them home, as Rails' catch-all did.
 *
 * One file for every address and every language, so it claims no address and
 * stays out of search results.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { DEFAULT_LOCALE } from '../lib/i18n';

const LINKS = [
  { href: '/', label: 'Home page' },
  { href: '/supported-hardware/featured', label: 'Supported hardware' },
  { href: '/get-started', label: 'Get started' },
  { href: '/open-wall', label: 'Open Wall' },
];
---
<Base locale={DEFAULT_LOCALE} path="/404" title="Page not found - OpenIPC" noindex addressless>
  <PageHeader
    title="Page not found"
    lede="There is nothing at this address. If you followed a link to a camera chip, it may have been renamed or removed from the catalogue."
  />
  <section class="py-section">
    <div class="site-container">
      <ul class="mb-0 flex list-none flex-wrap gap-3 p-0">
        {LINKS.map((l) => (
          <li>
            <a class="inline-block rounded-md border border-hairline bg-white px-4 py-2 no-underline hover:border-brand-blue" href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
