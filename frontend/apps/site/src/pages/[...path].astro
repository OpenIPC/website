---
/**
 * Every page the bundle serves, in every language (#160).
 *
 * One rest-parameter route over src/lib/pages.ts rather than a file per page
 * per locale. getStaticPaths names every address it may claim, so it cannot
 * swallow anything Rails still owns: a page is in the bundle because it is in
 * that array, and for no other reason.
 *
 * A rest parameter is also the only form that can route `/_smoke/`. Astro
 * ignores anything under src/pages whose name begins with an underscore --
 * that prefix is its convention for files that are not routes -- and `/_smoke`
 * is not ours to rename: deploy/static.sh verifies it after every install,
 * check-config.sh asserts nginx serves it from the bundle, build.sh refuses a
 * bundle without it, and two runbooks tell a reader to curl it.
 *
 * `/` is absent, deliberately and permanently. Rails renders it per
 * Accept-Language and declares `Vary: Accept-Language`; a file serves one
 * language to everyone. The locale roots `/ru/` and `/zh/` are in the bundle
 * -- they carry their language in the path and negotiate nothing -- and live
 * in ./[locale]/index.astro because a rest parameter cannot match an empty
 * path.
 */
import Base from '../layouts/Base.astro';
import { LOCALES, pathFor, useTranslations, type Locale } from '../lib/i18n';
import { pagesWithComponents, type PageSpec } from '../lib/pages';

export function getStaticPaths() {
  const pages = pagesWithComponents();

  return LOCALES.flatMap((locale) =>
    pages.map((page) => ({
      // Leading slash stripped: a rest parameter is the path relative to the
      // site root.
      params: { path: pathFor(locale as Locale, page.path).replace(/^\//, '') },
      props: { locale, page },
    })),
  );
}

const { locale, page } = Astro.props as { locale: Locale; page: PageSpec };
const t = useTranslations(locale);

// "<page> - OpenIPC", which is PagesHelper#page_title. The smoke page is the
// exception and names itself, because it is not a marketing page and its
// title is what a deploy looks for in a browser tab.
// The smoke page names itself, because it is not a page anyone reads and its
// title is what a deploy looks for in a browser tab. Everything else is titled
// for the site, `noindex` or not: the wall's shell is noindex because of the
// addresses it is served at, and a reader who lands on one still deserves a
// tab that says what they are looking at.
const title = page.path === '/_smoke'
  ? 'openipc.org static bundle'
  : `${t(page.titleKey)} - OpenIPC`;

const Content = page.component;
---
<Base
  locale={locale}
  path={page.path}
  title={title}
  description={page.descriptionKey ? t(page.descriptionKey) : undefined}
  noindex={page.noindex}
>
  <Content locale={locale} {...page.props} />
</Base>
