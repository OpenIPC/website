---
/**
 * The page shell.
 *
 * Deliberately the same head as app/views/layouts/application.html.erb, tag
 * for tag: while the seam is open, some pages are served from here and some
 * from Rails, and a visitor moving between them must not be able to tell.
 * The hreflang set is the part that matters most -- every alternate names
 * every other AND itself, or search engines discard the lot.
 */
import { alternates, pathFor, useTranslations, type Locale } from '../lib/i18n';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/app.css';

interface Props {
  locale: Locale;
  /** The page's own path, without a locale prefix: '/donate', '/'. */
  path: string;
  title: string;
  description?: string;
  /** Keep the page out of search results. Per page, because the marketing
   *  set must NOT carry it -- search discovery is most of why #142 exists. */
  noindex?: boolean;
  /**
   * This file is served at addresses it cannot know, so it claims none.
   *
   * True for the Open Wall's shell alone (#165): nginx serves that one file at
   * every `/snapshots/<id>`, its archive and its slideshow, and a canonical,
   * an hreflang set or an og:url derived from where it was BUILT would name
   * `/_shell/wall` on every one of them.
   */
  addressless?: boolean;
}

const { locale, path, title, description, noindex = false, addressless = false } = Astro.props;
const t = useTranslations(locale);

const site = 'https://openipc.org';
const alt = alternates(path);
const here = pathFor(locale, path);
const metaDescription = description ?? t('site.default_meta_description');
---
<!doctype html>
<html dir="ltr" lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>

  {/*
    These pages are not part of Rails' Turbo application, and Turbo has to be
    told so.

    The Rails half ships Turbo Drive. It intercepts a link into this bundle,
    fetches the page, swaps the body and MERGES the heads -- so Bootstrap stays
    loaded and Tailwind's stylesheet is added next to it. Measured on dev
    before this was here: clicking from /open-wall to /get-started gave the bar
    74.6px instead of 60.4, and clicking back left Tailwind's preflight applied
    to the Rails page, where `img { height: auto }` made the logo 64px and the
    navigation bar 90. A visitor who crossed the seam once had a broken site
    until they reloaded.

    `turbo-visit-control: reload` is Turbo's own way to say "do a full
    navigation to me". It belongs here rather than on the Rails links: this is
    the half that is not the application, and a rule stated once on every page
    of it cannot be forgotten on a link somebody adds later.
  */}
  <meta name="turbo-visit-control" content="reload" />

  <meta name="description" content={metaDescription} />
  <meta name="theme-color" content="#0f1422" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  {/*
    A page knows its own address and says so -- except the wall's shell, which
    does not have one. nginx serves that file at every `/snapshots/<id>`, so a
    canonical derived from where it was BUILT would tell a reader's browser,
    and anything reading og:url, that the snapshot they are looking at lives at
    /_shell/wall. Better to claim nothing than to claim the wrong thing: the
    shell is noindex, and the addresses it is served at are what a share or a
    crawl should carry.
  */}
  {!addressless && (
    <>
      <link rel="canonical" href={`${site}${here}`} />
      {Object.entries(alt).map(([code, p]) => (
        <link rel="alternate" hreflang={code} href={`${site}${p}`} />
      ))}
      <link rel="alternate" hreflang="x-default" href={`${site}${alt.en}`} />
    </>
  )}

  <meta property="og:site_name" content="OpenIPC" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  {!addressless && <meta property="og:url" content={`${site}${here}`} />}
  <meta property="og:image" content={`${site}/og-default.png`} />
  <meta name="twitter:card" content="summary_large_image" />

  {/*
    The icons, which live in the bundle's own public/ since #165 and were a
    404 before it. This markup was copied from the Rails layout, where the href
    is `asset_path 'favicon.png'` -- a digested asset. Written out literally it
    named a file that existed nowhere, so every page in the bundle asked for
    /favicon.png, fell through to Rails, and was answered 302 to the home page:
    1,027 times a day, and no icon on any migrated page.
  */}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!--
    The commit this page was built from. deploy/static/build.sh substitutes
    both tokens across every .html in the tree and check-bundle.sh refuses a
    page that still holds one, so a page without them names no commit and a
    page with them unsubstituted never ships. It is in the shell rather than on
    the smoke page alone (#160) because "which release is this?" is a question
    asked of whichever page is misbehaving.
  -->
  <meta name="build-revision" content="@@REVISION@@" />
  <meta name="build-time" content="@@BUILT@@" />

  <!--
    First-party page counting (#181). nginx proxies /api/a/c.js and
    /api/a/count to GoatCounter on 127.0.0.1:8081; nothing leaves the host and
    there is no third-party host to allow-list.

    no_onload is set at parse time rather than inside a bundle, for the same
    reason the Rails layout sets it here: count.js reading it before it is set
    would count the document load event, and a visitor who read twenty pages
    would register one.
  -->
  <script is:inline>
    (() => { window.goatcounter = { no_onload: true, endpoint: '/api/a/count' } })()
  </script>
  <script is:inline src="/api/a/c.js" data-goatcounter="/api/a/count" defer></script>
</head>

<body id="page-top" class="bg-white text-body">
  <a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-white focus:p-2" href="#main">Skip to content</a>

  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <slot />
  </main>

  <SiteFooter locale={locale} />
</body>
</html>
