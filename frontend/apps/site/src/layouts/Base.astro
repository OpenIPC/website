---
/**
 * The page shell.
 *
 * The hreflang set is the part that matters most -- every alternate names
 * every other AND itself, or search engines discard the lot.
 */
import { alternates, pathFor, useTranslations, type Locale } from '../lib/i18n';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/app.css';

interface Props {
  locale: Locale;
  /** The page's own path, without a locale prefix: '/donate', '/'. */
  path: string;
  title: string;
  description?: string;
  /** Keep the page out of search results. Per page, because the marketing
   *  set must NOT carry it -- search discovery is most of why #142 exists. */
  noindex?: boolean;
  /**
   * This file is served at addresses it cannot know, so it claims none.
   *
   * True for the Open Wall's shell alone (#165): nginx serves that one file at
   * every `/snapshots/<id>`, its archive and its slideshow, and a canonical,
   * an hreflang set or an og:url derived from where it was BUILT would name
   * `/_shell/wall` on every one of them.
   */
  addressless?: boolean;
}

const { locale, path, title, description, noindex = false, addressless = false } = Astro.props;
const t = useTranslations(locale);

const site = 'https://openipc.org';
const alt = alternates(path);
const here = pathFor(locale, path);
const metaDescription = description ?? t('site.default_meta_description');
---
<!doctype html>
<html dir="ltr" lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>

  <meta name="description" content={metaDescription} />
  <meta name="theme-color" content="#0f1422" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  {/*
    A page knows its own address and says so -- except the wall's shell, which
    does not have one. nginx serves that file at every `/snapshots/<id>`, so a
    canonical derived from where it was BUILT would tell a reader's browser,
    and anything reading og:url, that the snapshot they are looking at lives at
    /_shell/wall. Better to claim nothing than to claim the wrong thing: the
    shell is noindex, and the addresses it is served at are what a share or a
    crawl should carry.
  */}
  {!addressless && (
    <>
      <link rel="canonical" href={`${site}${here}`} />
      {Object.entries(alt).map(([code, p]) => (
        <link rel="alternate" hreflang={code} href={`${site}${p}`} />
      ))}
      <link rel="alternate" hreflang="x-default" href={`${site}${alt.en}`} />
    </>
  )}

  <meta property="og:site_name" content="OpenIPC" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  {!addressless && <meta property="og:url" content={`${site}${here}`} />}
  <meta property="og:image" content={`${site}/og-default.png`} />
  <meta name="twitter:card" content="summary_large_image" />

  {/*
    The icons, which live in the bundle's own public/ since #165. Before that
    the href named a file that existed nowhere, so every page asked for
    /favicon.png and was answered 302 to the home page: 1,027 times a day, and
    no icon on any page.
  */}
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!--
    The commit this page was built from. deploy/static/build.sh substitutes
    both tokens across every .html in the tree and check-bundle.sh refuses a
    page that still holds one, so a page without them names no commit and a
    page with them unsubstituted never ships. It is in the shell rather than on
    the smoke page alone (#160) because "which release is this?" is a question
    asked of whichever page is misbehaving.
  -->
  <meta name="build-revision" content="@@REVISION@@" />
  <meta name="build-time" content="@@BUILT@@" />

  {/*
    First-party page counting (#181). nginx proxies /api/a/c.js and
    /api/a/count to GoatCounter on 127.0.0.1:8081; nothing leaves the host and
    there is no third-party host to allow-list.

    count.js counts once on load, and this is a plain multi-page site: every
    navigation is a full document load, so that on-load count is exactly one hit
    per page a visitor reads -- the twenty pages of a session are twenty loads
    and twenty counts. The previous stack ran a client-side router that swapped
    pages without a load event, so it suppressed the on-load count and re-counted
    on each swap; there is no such router here, so the built-in counter is left
    enabled and the settings below carry only the endpoint. If Astro's
    ClientRouter is ever adopted, restore a manual goatcounter.count() on
    astro:page-load, or client-side navigations go uncounted again.

    This is a JSX comment, not an HTML one, so it is stripped from the page
    rather than shipped to every reader.
  */}
  <script is:inline>
    (() => { window.goatcounter = { endpoint: '/api/a/count' } })()
  </script>
  <script is:inline src="/api/a/c.js" data-goatcounter="/api/a/count" defer></script>
  <script>
    import { initEvents } from '../lib/events';
    initEvents(document, location.hostname);
  </script>
</head>

<body id="page-top" class="bg-white text-body">
  <a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-white focus:p-2" href="#main">Skip to content</a>

  <SiteHeader locale={locale} path={path} />

  <main id="main">
    <slot />
  </main>

  <SiteFooter locale={locale} />

  {/*
    The landing tag (#183, restored in #360). The project posts links to itself
    with ?ref=<tag> -- Telegram pins, READMEs, the camera WebUI's link home --
    because many readers arrive with no referrer at all. The tag is recorded as
    one `ref:<tag>` event and stripped from the address before count.js counts
    the page, so the page is one row in the report instead of one per channel.
    Only a well-formed tag is recorded, so a junk ?ref= cannot mint rows.

    Inline and LAST in the body, and both halves matter. Inline scripts run
    while the document parses and count.js is deferred until parsing ends, so
    this still strips the address before count.js reads it. And last, because
    the home page's language redirect (pages/index.astro) runs earlier in the
    body: it must see ?ref= to carry it to /ru or /zh, where this records it.
    Stripped in the head, a Russian reader's /?ref=tg-ru would be counted
    nowhere -- the redirect leaves before `load`. `openipcLeaving` is how that
    redirect says so, so the tag is not counted on the page being left too.
  */}
  <script is:inline>
    (() => {
      const url = new URL(location.href)
      if (window.openipcLeaving || !url.searchParams.has('ref')) return
      const tag = (url.searchParams.get('ref') || '').toLowerCase()
      url.searchParams.delete('ref')
      history.replaceState(history.state, '', url.pathname + url.search + url.hash)
      if (!/^[a-z0-9-]{1,24}$/.test(tag)) return
      addEventListener('load', () => window.goatcounter.count?.({ path: 'ref:' + tag, event: true }))
    })()
  </script>
</body>
</html>
