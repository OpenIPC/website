---
/**
 * The low latency page (#160).
 *
 * The air-unit builds section (#190) exists because the FPV copy above it
 * tells the reader to "pick your ground station" and the site never said what
 * there was to pick from. Since #390 each build can be installed from here:
 * the stacks are editions the installer takes from OpenIPC/builder, and every
 * card links the SoCs it is published for into their installer with the
 * edition chosen (../../data/fpv-stacks.ts, corrected on load from the
 * availability feed). Named in the order people meet them: the OpenIPC link
 * first, Waybeam on the same link, then the two that replace it.
 *
 * The latency chart is one measure across four receive paths, so the bars are
 * one hue on a shared scale rather than four colours -- the reader is
 * comparing magnitude, not telling series apart. The track is decoration for
 * the value beside it and is hidden from screen readers; the unit is carried
 * per value as well as once under the axis, because a screen reader reaches
 * the numbers one at a time and would otherwise hear "26 to 67" with nothing
 * saying what of.
 *
 * The support block (#193) is the test of whether FPV builders pay. It sells
 * the Open Collective "Technical support" tier as it stands -- an hour with a
 * core developer -- and says nothing the tier page does not. It sits under the
 * builds because that is where a builder has just picked one; the wizard's
 * download step sends FPV chips here (`#support`) rather than to /business.
 * Both links name their events, which the monthly memo counts as the FPV
 * segment's business clicks.
 *
 * The flight sits under the latency chart, as the evidence for it rather than
 * the page's opening: the page sells the stack first, and the reader who wants
 * to see it gets one real flight recorded on the drone and on the ground
 * station, cut onto one timeline by tools/flight-ab and compared frame by
 * frame (../flight/FlightCompare.tsx). Nothing loads until play.
 */
import Icon from '../Icon.astro';
import PageHeader from '../PageHeader.astro';
import CtaBand from '../CtaBand.astro';
import { pathFor, useTranslations, type Locale } from '../../lib/i18n';
import { LATENCY_PATHS, LATENCY_SCALE_MAX, latencyBarStyle } from '../../data/latency';
import { getImage } from 'astro:assets';
import FlightCompare, { type FlightLabels } from '../flight/FlightCompare';
import { FLIGHT, rndPlayerUrl } from '../../data/flight';
import flightPoster from '../../assets/pages/flight-mabur-2026-10.jpg';
import { FPV_STACKS } from '../../data/fpv-stacks';
import { VENDORS } from '../../lib/hardware';

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const k = (s: string) => t(`pages.low_latency.${s}`);

const CHAIN: [string, string][] = [
  ['camera-video', 'how_tx'],
  ['broadcast-pin', 'how_link'],
  ['display', 'how_rx'],
];

const GUIDE = 'https://github.com/OpenIPC/wiki/blob/master/en/fpv.md';
const FPV_CHAT = 'https://t.me/+BMyMoolVOpkzNWUy';
const SUPPORT_HOURS = 'https://opencollective.com/openipc/contribute/technical-support-56715/checkout';

// Every SoC by slug, as [vendor slug, model]: the stacks' lists are corrected
// on load from the availability feed, which may name any of them.
const SOCS: Record<string, [string, string]> = Object.fromEntries(
  VENDORS.flatMap((v) => v.socs.map((s) => [s.urlname, [v.urlname, s.model]])),
);
const VENDOR_BASE = pathFor(locale, '/cameras/vendors');
// The FPV builds are 16 MB images: on a chip the wizard would open as 8 MB
// only Lite is offered, and the edition asked for would quietly become Lite.
const installHref = (slug: string, edition: string) =>
  `${VENDOR_BASE}/${SOCS[slug]?.[0]}/socs/${slug}?rom=nor16m&ver=${edition}`;

const poster = await getImage({ src: flightPoster, width: 1920, format: 'webp', quality: 80 });
const flightLabels: FlightLabels = {
  play: k('flight_play'),
  pause: k('flight_pause'),
  loading: k('flight_loading'),
  error: k('flight_error'),
  failed: k('flight_failed'),
  onboard: k('flight_onboard'),
  gs: k('flight_gs'),
  original: k('flight_original'),
  reduced: k('flight_reduced'),
  copy: k('flight_copy'),
  fullscreen: k('flight_fullscreen'),
  frameBack: k('flight_frame_back'),
  frameForward: k('flight_frame_forward'),
  handle: k('flight_handle'),
  seek: k('flight_seek'),
  openRnd: k('flight_open_rnd'),
};
---
<PageHeader title={k('hero_title')} lede={k('hero_lede')} />

<div class="site-container">
  <article>
    <h2 class="mb-6 text-2xl">{k('how_title')}</h2>
    <div class="mb-4 grid gap-6 text-center md:grid-cols-3">
      {CHAIN.map(([icon, key]) => (
        <div class="h-full rounded-lg border border-hairline bg-white p-5">
          <Icon name={icon} class="mx-auto size-7 text-brand-blue" />
          <h3 class="mt-3 mb-2 text-base font-semibold">{k(`${key}_title`)}</h3>
          <p class="mb-0 text-sm text-body-secondary" set:html={k(`${key}_text_html`)} />
        </div>
      ))}
    </div>
    <p class="mb-12 text-center text-sm text-body-secondary">TX&nbsp;&rarr;&nbsp;devourer&nbsp;&rarr;&nbsp;RX</p>

    <div class="mb-12 grid gap-12 lg:grid-cols-2" id="fpv">
      <div>
        <h2 class="mb-3 text-2xl">{k('fpv_title')}</h2>
        <p class="mb-4 text-body-secondary">{k('fpv_text')}</p>
        <p class="flex flex-wrap gap-3">
          <a class="site-btn site-btn-primary" href={GUIDE}>{k('cta_guide')}</a>
          <a class="site-btn site-btn-outline-primary" href={FPV_CHAT}>{k('cta_chat')}</a>
        </p>
      </div>
      <div>
        <h2 class="mb-3 text-2xl">{k('robotics_title')}</h2>
        <p class="mb-3 text-body-secondary">{k('robotics_text1')}</p>
        <p class="mb-4 text-body-secondary">{k('robotics_text2')}</p>
        <p class="mb-4 flex flex-wrap gap-3">
          <a class="site-btn site-btn-outline-primary" href={pathFor(locale, '/teleoperation')}>
            {k('robotics_cta')}
          </a>
        </p>
        <p class="mb-0" set:html={k('business_bridge_html')} />
      </div>
    </div>

    <div class="mb-12" id="builds">
      <h2 class="mb-1 text-2xl">{k('builds_title')}</h2>
      <p class="mb-6 text-body-secondary">{k('builds_lede')}</p>
      <div class="grid gap-6 md:grid-cols-2">
        {FPV_STACKS.map((stack) => (
          <div class="flex h-full flex-col rounded-lg border border-hairline p-5" data-stack={stack.key}>
            <h3 class="mb-2 text-base font-semibold">{k(`build_${stack.key}_name`)}</h3>
            <p class="mb-3 text-sm text-body-secondary">{k(`build_${stack.key}_text`)}</p>
            <p class="mb-3 text-sm"><a href={stack.upstream}>{k('build_upstream')}</a></p>
            <p class="mt-auto mb-1 text-sm font-semibold">{k('build_install_on')}</p>
            <p class="stack-socs mb-0 flex flex-wrap gap-2 text-sm">
              {Object.keys(stack.socs).length === 0 && (
                <span class="text-body-secondary">{k('build_not_built')}</span>
              )}
              {Object.entries(stack.socs).map(([slug, edition]) => (
                <a class="site-btn site-btn-sm site-btn-outline-primary" href={installHref(slug, edition)}
                  data-event={`lowlat:try:${stack.key}:${slug}`}>{SOCS[slug]?.[1] ?? slug}</a>
              ))}
            </p>
          </div>
        ))}
      </div>
    </div>

    <div
      class="mb-12 grid items-center gap-x-10 gap-y-5 rounded-lg border border-hairline bg-surface-alt p-6 md:grid-cols-[minmax(0,1fr)_auto]"
      id="support"
    >
      <div>
        <h2 class="mb-1 text-2xl">{k('support_title')}</h2>
        <p class="mb-3 text-body-secondary">{k('support_text')}</p>
        <p class="mb-0 font-mono text-[.8125rem] text-body-secondary" set:html={k('support_rate_html')} />
      </div>
      <div class="flex flex-col items-start gap-3">
        <a class="site-btn site-btn-primary" href={SUPPORT_HOURS} data-event="lowlat:offer">{k('support_cta')}</a>
        <a
          href={`${pathFor(locale, '/business')}?ref=lowlat&segment=fpv`}
          data-event="lowlat:offer:business"
        >{k('support_business')}</a>
      </div>
    </div>

    <div class="mb-12 grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="mb-3 text-2xl">{k('latency_title')}</h2>
        <p class="mb-4 text-body-secondary">{k('latency_intro')}</p>
        <p class="mb-0 text-sm text-body-secondary">{k('latency_note')}</p>
      </div>
      <div class="lg:col-span-7">
        <div class="grid grid-cols-[auto_auto_1fr] items-center gap-x-4 gap-y-3">
          {LATENCY_PATHS.map((path) => (
            <>
              <span class="text-sm">{k(`latency_path_${path.key}`)}</span>
              <span class="font-mono text-sm whitespace-nowrap">
                {`${path.low}–${path.high}`}<span class="sr-only"> {k('latency_axis_unit')}</span>
              </span>
              <span class="relative block h-3 rounded-full bg-surface-alt" aria-hidden="true">
                <span class="absolute inset-y-0 rounded-full bg-brand-blue" style={latencyBarStyle(path)}></span>
              </span>
            </>
          ))}
          <span class="col-start-3 flex justify-between text-xs text-body-secondary" aria-hidden="true">
            <span>0</span><span>{LATENCY_SCALE_MAX / 2}</span><span>{LATENCY_SCALE_MAX}</span>
          </span>
          <span class="col-start-3 text-xs text-body-secondary" aria-hidden="true">{k('latency_axis_unit')}</span>
        </div>
      </div>
    </div>

    <div class="mb-12 flex flex-wrap items-center gap-8 border-t border-hairline pt-8" id="flight">
      <div class="min-w-0 grow-[2] basis-[520px]">
        <FlightCompare
          client:idle
          base={FLIGHT.base}
          poster={poster.src}
          start={FLIGHT.start}
          end={FLIGHT.end}
          rndPlayer={rndPlayerUrl(Astro.site!.origin)}
          labels={flightLabels}
        />
      </div>
      <div class="-order-1 min-w-0 grow basis-[300px] lg:order-none">
        <h3 class="mb-2 text-xl font-semibold">{k('flight_title')}</h3>
        <p class="mb-3 text-body-secondary">{k('flight_text')}</p>
        <p class="mb-0 text-sm text-body-secondary" set:html={k('flight_credit_html')} />
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="mb-2 text-xl">{k('hardware_title')}</h2>
        <p class="mb-0 text-body-secondary" set:html={k('hardware_text_html')} />
      </div>
      <div>
        <h2 class="mb-2 text-xl">{k('credits_title')}</h2>
        <p class="mb-0 text-body-secondary" set:html={k('credits_text_html')} />
      </div>
    </div>
  </article>
</div>

<CtaBand
  title={k('fpv_title')}
  primaryLabel={k('cta_guide')}
  primaryHref={GUIDE}
  secondaryLabel={k('cta_chat')}
  secondaryHref={FPV_CHAT}
  noteHtml={k('business_bridge_html')}
/>

<script
  is:inline
  define:vars={{
    stacks: Object.fromEntries(FPV_STACKS.map((s) => [s.key, s.editions])),
    socs: SOCS,
    base: VENDOR_BASE,
    notBuilt: k('build_not_built'),
  }}
>
  // The lists above are what builder published when the page was built; the
  // availability feed's `fpv` map is the same answer, live (#390).
  (async () => {
    let live;
    try {
      const response = await fetch('/api/v1/hardware/availability.json', { headers: { accept: 'application/json' } });
      if (!response.ok) return;
      live = await response.json();
    } catch {
      return;
    }
    if (!live || typeof live.fpv !== 'object' || live.fpv === null) return;

    for (const card of document.querySelectorAll('[data-stack]')) {
      const editions = stacks[card.dataset.stack] || [];
      const list = card.querySelector('.stack-socs');
      const links = [];
      for (const [slug, published] of Object.entries(live.fpv)) {
        const edition = editions.find((e) => published.includes(e));
        if (!edition || !socs[slug]) continue;
        const a = document.createElement('a');
        a.className = 'site-btn site-btn-sm site-btn-outline-primary';
        a.href = `${base}/${socs[slug][0]}/socs/${slug}?rom=nor16m&ver=${edition}`;
        a.dataset.event = `lowlat:try:${card.dataset.stack}:${slug}`;
        a.textContent = socs[slug][1];
        links.push(a);
      }
      list.textContent = '';
      if (links.length === 0) {
        const span = document.createElement('span');
        span.className = 'text-body-secondary';
        span.textContent = notBuilt;
        list.append(span);
      } else {
        list.append(...links);
      }
    }
  })();
</script>
