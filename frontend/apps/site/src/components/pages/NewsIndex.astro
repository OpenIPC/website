---
/**
 * /news (#212): every post, newest first, from data/news. A post is shown in
 * the reader's language where it has been translated, and in English where it
 * has not -- marked lang="en" so a screen reader or a translator knows.
 */
import PageHeader from '../PageHeader.astro';
import { formatDate, inLocale, newsPath, POSTS } from '../../lib/news';
import { feedPath } from '../../lib/news-feed';
import { pathFor, useTranslations, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const shown = POSTS.map((post) => ({ post, text: inLocale(post, locale) }));
---
<PageHeader title={t('pages.news.title')} lede={t('pages.news.lede')} />
<div class="site-container pb-16">
  <p class="mb-8">
    <a href={feedPath(locale)} type="application/atom+xml">{t('pages.news.subscribe')}</a>
  </p>
  {shown.length === 0
    ? <p class="text-body-secondary">{t('pages.news.empty')}</p>
    : (
      <ol class="max-w-[68ch] divide-y divide-hairline border-t border-hairline">
        {shown.map(({ post, text }) => (
          <li class="py-6">
            <time datetime={post.date} class="text-sm text-body-secondary">{formatDate(post.date, locale)}</time>
            <h2 class="mt-1 mb-2 text-h3 leading-[1.3]" lang={text.lang === locale ? undefined : text.lang}>
              <a href={pathFor(locale, newsPath(post))} class="text-body no-underline hover:underline">{text.title}</a>
            </h2>
            <p class="mb-0 text-body-secondary" lang={text.lang === locale ? undefined : text.lang}>{text.summary}</p>
          </li>
        ))}
      </ol>
    )}
</div>
