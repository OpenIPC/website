---
/**
 * /news (#212): every post, newest first, from data/news. The posts are in
 * English under every prefix; the page around them is translated.
 */
import PageHeader from '../PageHeader.astro';
import { formatDate, newsPath, POSTS } from '../../lib/news';
import { pathFor, useTranslations, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<PageHeader title={t('pages.news.title')} lede={t('pages.news.lede')} />
<div class="site-container pb-16">
  <p class="mb-8">
    <a href="/news.atom" type="application/atom+xml">{t('pages.news.subscribe')}</a>
  </p>
  {POSTS.length === 0
    ? <p class="text-body-secondary">{t('pages.news.empty')}</p>
    : (
      <ol class="max-w-[68ch] divide-y divide-hairline border-t border-hairline">
        {POSTS.map((post) => (
          <li class="py-6" lang={locale === 'en' ? undefined : 'en'}>
            <time datetime={post.date} class="text-sm text-body-secondary">{formatDate(post.date, locale)}</time>
            <h2 class="mt-1 mb-2 text-h3 leading-[1.3]">
              <a href={pathFor(locale, newsPath(post))} class="text-body no-underline hover:underline">{post.title}</a>
            </h2>
            <p class="mb-0 text-body-secondary">{post.summary}</p>
          </li>
        ))}
      </ol>
    )}
</div>
