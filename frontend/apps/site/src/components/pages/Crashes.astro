---
/**
 * The kernel crashes cameras recovered from (service/internal/crashes), one
 * row per bug, worst first. Static: the island asks /api/v1/crashes.
 */
import CrashList from '../crashes/CrashList.tsx';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<div class="site-container mt-10 mb-16">
  <p class="mb-1 text-xs font-semibold tracking-[.08em] text-body-secondary uppercase">{t('pages.crashes.eyebrow')}</p>
  <h1 class="mb-0 text-h1 font-semibold text-balance">{t('pages.crashes.title')}</h1>
  <p class="mt-3 mb-0 max-w-[62ch] text-lg text-body-secondary">{t('pages.crashes.lede')}</p>
  <CrashList client:load locale={locale} />
</div>
