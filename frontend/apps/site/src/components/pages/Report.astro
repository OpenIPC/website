---
/**
 * How a new board reaches the catalogue: the owner's report, sent by ipctool
 * from the camera or by an AI coding agent working on it, and -- with ?id= --
 * that report's receipt, which is the address ipctool prints.
 *
 * Stock camera firmware has no curl and no TLS, so the shell route never
 * says curl: uget, pasted in as text over telnet, fetches ipctool from
 * http://openipc.org/ipctool (plain HTTP, no redirect: uget follows none),
 * a firmware with busybox's wget fetches the same file without it, and one
 * with an NFS client mounts the same files instead
 * (service/internal/tools, service/internal/nfsro).
 *
 * Read on openipc.ru, the commands name openipc.ru: in Russia the TSPU
 * freezes a connection to the origin after ~20 KB, and the mirror's port 80
 * proxies ipctool and the report (deploy/nginx/mirrors/ru.openipc.snippet).
 * NFS is not mirrored, so there it is not offered.
 *
 * #new is the way without a shell: the camera's maker, its marking and
 * photos of it, sent from the browser (club/NewCameraForm). The catalogue's
 * empty searches and /club link here.
 */
import Terminal from '../Terminal.astro';
import UgetCopy from '../reports/UgetCopy.tsx';
import Receipt from '../reports/Receipt.tsx';
import NewCameraForm from '../club/NewCameraForm.tsx';
import { useTranslations, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const p = (key: string) => t(`pages.report.${key}`);
const flags: [string, string][] = [
  ['upload', p('flag_upload')],
  ['--backup', p('flag_backup')],
  ['--backup --public', p('flag_public')],
  ['--note "…"', p('flag_note')],
  ['--note club-XXXX-XXXX', p('flag_club')],
];
---
<div class="site-container mt-10 mb-16">
  <p class="mb-1 text-xs font-semibold tracking-[.08em] text-body-secondary uppercase">{p('eyebrow')}</p>
  <h1 class="mb-0 text-h1 font-semibold text-balance">{p('title')}</h1>
  <p class="mt-3 mb-0 max-w-[62ch] text-lg text-body-secondary">{p('lede')}</p>

  <Receipt client:load locale={locale} />

  <section id="new" class="mt-8 flex flex-col gap-3" aria-labelledby="report-new">
    <h2 id="report-new" class="mb-0 text-xl font-semibold">{p('new_title')}</h2>
    <NewCameraForm client:visible locale={locale} />
  </section>

  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    <section class="flex min-w-0 flex-col gap-3 rounded-xl border border-hairline p-6" aria-labelledby="report-shell">
      <h2 id="report-shell" class="mb-0 text-xl font-semibold">{p('shell_title')}</h2>
      <p class="mb-0 text-sm text-body-secondary" set:html={p('shell_lede_html')} />
      <UgetCopy client:visible locale={locale} label={p('step_uget')} />
      <div>
        <p class="mb-0 text-[.9375rem] font-semibold text-ink">{p('step_fetch')}</p>
        <Terminal id="report-fetch" title="telnet" code={'/tmp/uget openipc.org/ipctool > /tmp/ipctool\nchmod +x /tmp/ipctool\n/tmp/ipctool upload'} />
      </div>
      <details class="text-sm">
        <summary class="cursor-pointer text-brand-blue">{p('wget_title')}</summary>
        <Terminal id="report-wget" title="telnet" code={'wget -O /tmp/ipctool http://openipc.org/ipctool\nchmod +x /tmp/ipctool\n/tmp/ipctool upload'} />
        <p class="mb-0 text-body-secondary" set:html={p('wget_hint_html')} />
      </details>
      <details class="text-sm" id="report-nfs-route">
        <summary class="cursor-pointer text-brand-blue">{p('nfs_title')}</summary>
        <Terminal id="report-nfs" title="telnet" code={'mkdir /tmp/o && mount -o nolock openipc.org:/ipctool /tmp/o\n/tmp/o/ipctool upload'} />
        <p class="mb-0 text-body-secondary" set:html={p('nfs_hint_html')} />
      </details>
      <dl class="m-0 grid grid-cols-1 gap-x-4 gap-y-1 text-sm sm:grid-cols-[max-content_1fr]">
        {flags.map(([flag, what]) => (
          <>
            <dt class="font-mono text-ink">{flag}</dt>
            <dd class="mb-2 text-body-secondary sm:mb-0">{what}</dd>
          </>
        ))}
      </dl>
    </section>

    <section class="flex min-w-0 flex-col gap-3 rounded-xl border border-hairline p-6" aria-labelledby="report-agent">
      <h2 id="report-agent" class="mb-0 text-xl font-semibold">{p('agent_title')}</h2>
      <p class="mb-0 text-sm text-body-secondary">{p('agent_lede')}</p>
      <Terminal id="report-agent-prompt" title="prompt" code={p('agent_prompt')} wrap />
      <ol class="m-0 grid gap-2 ps-5 text-[.9375rem] [&_code]:rounded [&_code]:border [&_code]:border-hairline [&_code]:bg-surface-alt [&_code]:px-1 [&_code]:text-[13.5px]">
        <li set:html={p('agent_step1_html')} />
        <li>{p('agent_step2')}</li>
        <li set:html={p('agent_step3_html')} />
      </ol>
    </section>
  </div>

  <div class="mt-9 grid gap-x-7 gap-y-4 border-t border-hairline pt-7 md:grid-cols-3">
    <div>
      <h3 class="mb-1 text-[.9375rem] font-semibold">{p('fact1_title')}</h3>
      <p class="mb-0 text-sm text-body-secondary">{p('fact1')}</p>
    </div>
    <div>
      <h3 class="mb-1 text-[.9375rem] font-semibold">{p('fact2_title')}</h3>
      <p class="mb-0 text-sm text-body-secondary">{p('fact2')}</p>
    </div>
    <div>
      <h3 class="mb-1 text-[.9375rem] font-semibold">{p('fact3_title')}</h3>
      <p class="mb-0 text-sm text-body-secondary" set:html={p('fact3_html')} />
    </div>
  </div>
</div>

<script>
  import { cameraHost, forCameraHost } from '../../lib/reports';

  const host = cameraHost(location.host);
  if (host !== 'openipc.org') {
    for (const id of ['report-fetch', 'report-wget']) {
      const code = document.getElementById(id);
      if (code?.textContent) code.textContent = forCameraHost(code.textContent, host);
    }
    document.getElementById('report-nfs-route')?.setAttribute('hidden', '');
  }
</script>
