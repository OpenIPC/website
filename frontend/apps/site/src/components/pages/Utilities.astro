---
/**
 * app/views/pages/utilities.html.erb (#160).
 *
 * The tool names, versions and the text around the links are English in the
 * Rails view too -- they are file names and vendor product names, and only the
 * page title and the opening paragraph come from the catalogue.
 *
 * The /dl/ links are left unprefixed. `locale_path('/dl/...')` returns the path
 * unchanged for a non-page address, which is what production serves on both
 * /utilities and /ru/utilities, and nginx has its own `location /dl/`.
 */
import Container from '../Container.astro';
import PageTitle from '../PageTitle.astro';
import { useTranslations, type Locale } from '../../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const k = (s: string) => t(`pages.utilities.${s}`);

const link = 'text-brand-blue';
---
<Container>
  <article>
    <PageTitle>{k('title')}</PageTitle>
    <p class="mb-4">{k('paragraph1')}</p>

    <dl class="mb-4">
      <div>
        <dt class="mb-1 font-semibold">Ingenic Cloner v2.5.43 (OpenIPC edition)</dt>
        <dd class="mb-2 text-body-secondary">
          <a class={link} href="/dl/cloner-2.5.43-windows_alpha_openipc.zip">version for Windows</a> |
          <a class={link} href="/dl/cloner-2.5.43-ubuntu_alpha_openipc.tar.gz">version for Linux</a> |
          <a class={link} href="/dl/cloner.ingenic">extra configs</a> |
          <a class={link} href="/dl/USBCloner_The_Burn_tool_Quick_Guide.pdf">Quick Guide in PDF</a>
        </dd>
      </div>
      <div>
        <dt class="mb-1 font-semibold">HiSilicon PQTool v5.18.6</dt>
        <dd class="mb-2 text-body-secondary">
          <a class={link} href="/dl/HiPQTools_V5.18.6.zip">version for Windows</a>
        </dd>
      </div>
      <div>
        <dt class="mb-1 font-semibold">SigmaStarCam IQTool v2.01.114</dt>
        <dd class="mb-2 text-body-secondary">
          <p class="mb-2">
            <a class={link} href="/dl/SSCamIQTool-2.01.114.zip">version for Windows</a> |
            <a class={link} href="/dl/micross.ttf">font for running under Wine</a>
          </p>
          <p class="mb-0">
            Enable the iqserver on the camera: <code class="rounded bg-surface-alt px-1 font-mono text-sm">cli -s .isp.iqServer true</code>.
            Start <code class="rounded bg-surface-alt px-1 font-mono text-sm">SSCamIQTool.exe</code>, enter the camera IP address and click the connect button.
          </p>
        </dd>
      </div>
      <div>
        <dt class="mb-1 font-semibold">HiSilicon HiTool v4.0.18</dt>
        <dd class="mb-2 text-body-secondary">
          <a class={link} href="/dl/HiTool-BVT-4.0.18.zip">version for Windows</a>
        </dd>
      </div>
      <div>
        <dt class="mb-1 font-semibold">HiSilicon HiTool v5.0.61</dt>
        <dd class="mb-2 text-body-secondary">
          <a class={link} href="/dl/HiTool-BVT-5.0.61.zip">version for Windows</a>
        </dd>
      </div>
      <div>
        <dt class="mb-1 font-semibold">NeoProgrammer v2.2.0.10</dt>
        <dd class="mb-2 text-body-secondary">
          <a class={link} href="/dl/NeoProgrammer_2.2.0.10.zip">version for Windows</a>
        </dd>
      </div>
      <div>
        <dt class="mb-1 font-semibold">ToolPlatform v1.0.0</dt>
        <dd class="mb-2 text-body-secondary">
          <a class={link} href="/dl/ToolPlatform-1.0.0-win32-x86_64.zip">version for Windows</a>
        </dd>
      </div>
    </dl>
  </article>
</Container>
