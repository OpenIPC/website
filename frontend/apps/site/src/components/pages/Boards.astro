---
/**
 * The board catalogue: camera and recorder boards with their photos, pinouts,
 * specifications, flash dumps and console captures, from every source that
 * describes them. The island credits the sources, as the API names them.
 *
 * The page is the hardware tab strip, a heading and one island; the island
 * reads /api/v1/boards, which the Go web role answers from what was imported
 * (service/internal/boards), so there is nothing about the boards to
 * prerender. It is handed the catalogue's SoCs so a board built on one links
 * to that SoC's installation wizard.
 */
import HardwareTabs from '../HardwareTabs.astro';
import ZoomDialog from '../ZoomDialog.astro';
import Boards from '../boards/Boards.tsx';
import { VENDORS, socPath } from '../../lib/hardware';
import { pathFor, useTranslations, type Locale } from '../../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const socs = Object.fromEntries(VENDORS.flatMap((vendor) => vendor.socs.map((soc) => [
  soc.urlname,
  { model: soc.model, href: pathFor(locale, socPath(vendor, soc)) },
])));
---
<div class="site-container mt-4">
  <HardwareTabs locale={locale} view="boards" />
  <h1 class="mt-7 mb-0 text-h1 font-semibold text-balance">{t('pages.boards.heading')}</h1>
  <p class="mt-2.5 mb-0 max-w-[65ch] text-lg">{t('pages.boards.lede')}</p>
</div>
<Boards client:load locale={locale} socs={socs} />
<ZoomDialog />
