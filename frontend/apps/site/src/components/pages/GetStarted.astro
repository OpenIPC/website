---
/**
 * app/views/pages/get_started.html.erb (#160).
 *
 * The terminal is step 1's command, so it sits directly after step 1 in the
 * markup and a narrow screen reads 1, command, 2, 3. On a desktop it moves to
 * the end of the row, where the three steps are side by side and the command
 * wants the full width beneath them.
 *
 * It used to live inside the step-1 column, where the ipctool URL is longer
 * than a third of the article is wide: the visible line ended at
 * "https://github.com/OpenI" and the rest sat behind a horizontal scrollbar
 * most systems do not draw.
 *
 * The four WebUI screenshots are the first four in the manifest rather than a
 * chosen set. An earlier draft hardcoded four filenames; the gallery was
 * reshot and every one of them stopped existing, which is what a hardcoded
 * list buys you. Taking the first four means a screen leaving the manifest
 * cannot leave a hole here either.
 */
import Icon from '../Icon.astro';
import PageHeader from '../PageHeader.astro';
import CtaBand from '../CtaBand.astro';
import Terminal from '../Terminal.astro';
import WebuiTile from '../WebuiTile.astro';
import ZoomDialog from '../ZoomDialog.astro';
import { pathFor, useTranslations, type Locale } from '../../lib/i18n';
import { SCREENS } from '../../lib/webui';

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const k = (s: string) => t(`pages.get_started.${s}`);

const IPCTOOL = 'curl -L -o /tmp/ipctool https://github.com/OpenIPC/ipctool/releases/download/latest/ipctool\n'
  + 'chmod +x /tmp/ipctool && /tmp/ipctool';
---
<PageHeader title={k('hero_title')} lede={k('hero_lede')} />

<div class="site-container">
  <article>
    <div class="mb-10 grid gap-6 lg:grid-cols-3">
      <div>
        <h2 class="mb-2 text-xl"><span class="mr-2 font-mono text-brand-blue">1</span>{k('step1_title')}</h2>
        <p class="mb-0 text-body-secondary" set:html={k('step1_text_html')} />
      </div>
      {/*
        min-w-0, or the page scrolls sideways on a phone. A grid item's
        min-width is `auto`, which means "at least as wide as my content" --
        and this item's content is a 96-character curl command. The <pre>
        inside has `overflow-x: auto` and never gets to use it, because the
        track it sits in has already been widened to fit the line: 815px of
        page in a 390px viewport, with the whole document scrolling rather
        than the code block.
      */}
      <div class="min-w-0 lg:order-last lg:col-span-3">
        <Terminal id="ipctool-cmd" title="camera shell" code={IPCTOOL} />
      </div>
      <div>
        <h2 class="mb-2 text-xl"><span class="mr-2 font-mono text-brand-blue">2</span>{k('step2_title')}</h2>
        <p class="mb-4 text-body-secondary">{k('step2_text')}</p>
        <p class="mb-0">
          <a class="inline-block rounded-md bg-brand-blue px-5 py-2.5 font-medium text-white no-underline hover:bg-btn-blue-hover" href={pathFor(locale, '/supported-hardware')}>
            {k('cta_find_soc')}
          </a>
        </p>
      </div>
      <div>
        <h2 class="mb-2 text-xl"><span class="mr-2 font-mono text-brand-blue">3</span>{k('step3_title')}</h2>
        <p class="mb-0 text-body-secondary">{k('step3_text')}</p>
      </div>
    </div>

    {/* Honesty box. */}
    <div class="mb-10 flex gap-4 rounded-lg border border-accent/40 bg-accent/10 p-5">
      <Icon name="exclamation-triangle-fill" class="size-6 shrink-0 text-ink" />
      <div>
        <h2 class="mb-1 text-base font-semibold">{k('warning_title')}</h2>
        <p class="mb-0" set:html={k('warning_text_html')} />
      </div>
    </div>

    <div class="mb-10 grid items-start gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="mb-3 text-2xl">{k('what_title')}</h2>
        <p class="mb-6 text-body-secondary">{k('what_text')}</p>
        <h3 class="mb-2 text-base font-semibold">{k('editions_title')}</h3>
        <p class="mb-0 text-body-secondary">{k('editions_text')}</p>
      </div>
      <div class="lg:col-span-7">
        <h2 class="mb-4 text-2xl">
          <a class="text-body no-underline hover:underline" href={pathFor(locale, '/web-interface')}>{k('webui_title')}</a>
        </h2>
        <div class="grid grid-cols-2 gap-4">
          {SCREENS.slice(0, 4).map((screen) => <WebuiTile screen={screen} frame />)}
        </div>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="mb-2 text-xl">{k('wall_title')}</h2>
        <p class="mb-0 text-body-secondary" set:html={k('wall_text_html')} />
      </div>
      <div>
        <h2 class="mb-2 text-xl">{k('stuck_title')}</h2>
        <p class="mb-0 text-body-secondary" set:html={k('stuck_text_html')} />
      </div>
    </div>
  </article>
</div>

<CtaBand
  title={k('hero_title')}
  primaryLabel={k('cta_find_soc')}
  primaryHref={pathFor(locale, '/supported-hardware')}
/>

<ZoomDialog />
