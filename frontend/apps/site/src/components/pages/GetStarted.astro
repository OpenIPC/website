---
/**
 * The get started page (#160).
 *
 * Step 1 is getting a camera OpenIPC runs on, by the four ways on the
 * supported hardware page. It was "run ipctool on the camera", which needs a
 * UART or a way into the vendor's Linux: the step a newcomer could not take.
 * ipctool is offered to reverse engineers there instead.
 *
 * The four WebUI screenshots are the first four in the manifest rather than a
 * chosen set. An earlier draft hardcoded four filenames; the gallery was
 * reshot and every one of them stopped existing, which is what a hardcoded
 * list buys you. Taking the first four means a screen leaving the manifest
 * cannot leave a hole here either.
 */
import Icon from '../Icon.astro';
import PageHeader from '../PageHeader.astro';
import CtaBand from '../CtaBand.astro';
import WebuiTile from '../WebuiTile.astro';
import ZoomDialog from '../ZoomDialog.astro';
import { pathFor, useTranslations, type Locale } from '../../lib/i18n';
import { SCREENS } from '../../lib/webui';

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const k = (s: string) => t(`pages.get_started.${s}`);

---
<PageHeader title={k('hero_title')} lede={k('hero_lede')} />

<div class="site-container">
  <article>
    <div class="mb-12 grid gap-6 lg:grid-cols-3">
      <div id="identify">
        <h2 class="mb-2 text-xl leading-6 font-semibold"><span class="mr-2 text-brand-blue">1</span>{k('step1_title')}</h2>
        <p class="mb-4 text-body-secondary">{k('step1_text')}</p>
        <p class="mb-4">
          <a class="site-btn site-btn-primary" href={pathFor(locale, '/supported-hardware/featured')}>
            {k('cta_ways')}
          </a>
        </p>
      </div>
      <div>
        <h2 class="mb-2 text-xl leading-6 font-semibold"><span class="mr-2 text-brand-blue">2</span>{k('step2_title')}</h2>
        <p class="mb-4 text-body-secondary">{k('step2_text')}</p>
      </div>
      <div>
        <h2 class="mb-2 text-xl leading-6 font-semibold"><span class="mr-2 text-brand-blue">3</span>{k('step3_title')}</h2>
        <p class="mb-4 text-body-secondary">{k('step3_text')}</p>
      </div>
    </div>

    {/* Honesty box. */}
    <div class="mb-12 flex gap-4 rounded-lg border border-[#f8dfc0] bg-[#faecd8] p-4 text-[#5d4018]">
      <Icon name="exclamation-triangle-fill" class="size-6 shrink-0" />
      <div>
        <h2 class="mb-1 text-base font-semibold">{k('warning_title')}</h2>
        <p class="mb-0" set:html={k('warning_text_html')} />
      </div>
    </div>

    <div class="mb-12 grid items-start gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="mb-3 text-2xl">{k('what_title')}</h2>
        <p class="mb-6 text-body-secondary">{k('what_text')}</p>
        <h3 class="mb-2 text-base font-semibold">{k('editions_title')}</h3>
        <p class="mb-0 text-body-secondary">{k('editions_text')}</p>
      </div>
      <div class="lg:col-span-7">
        <h2 class="mb-4 text-2xl">
          <a class="text-body" href={pathFor(locale, '/web-interface')}>{k('webui_title')}</a>
        </h2>
        <div class="grid grid-cols-2 gap-4">
          {SCREENS.slice(0, 4).map((screen) => <WebuiTile screen={screen} frame />)}
        </div>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="mb-2 text-xl">{k('wall_title')}</h2>
        <p class="mb-0 text-body-secondary" set:html={k('wall_text_html')} />
      </div>
      <div>
        <h2 class="mb-2 text-xl">{k('stuck_title')}</h2>
        <p class="mb-0 text-body-secondary" set:html={k('stuck_text_html')} />
      </div>
    </div>
  </article>
</div>

<CtaBand
  title={k('hero_title')}
  primaryLabel={k('cta_ways')}
  primaryHref={pathFor(locale, '/supported-hardware/featured')}
/>

<ZoomDialog />
