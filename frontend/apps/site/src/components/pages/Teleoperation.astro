---
/**
 * app/views/pages/teleoperation.html.erb (#160).
 *
 * The hero render carries its own alpha fade on all four edges and a
 * background matched to ink, so it sits on the dark section without a
 * rectangle around it.
 *
 * Both mailto subjects are deliberate and English on every locale: the subject
 * is what lets the business mailbox count these without any analytics, and the
 * second one's body opens with the four lines an engineer needs in order to
 * answer with a plan.
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { pathFor, useTranslations, type Locale } from '../../lib/i18n';
import hero from '../../assets/pages/teleoperation-hero.webp';

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const k = (s: string) => t(`pages.teleoperation.${s}`);

const BRINGS: [string, string][] = [
  ['latency', 'stopwatch'],
  ['link', 'broadcast-pin'],
  ['time', 'clock-history'],
  ['stream', 'layers'],
];

const NODES: [string, string][] = [
  ['operator', 'headset-vr'],
  ['link', 'broadcast-pin'],
  ['robot', 'robot'],
  ['recorder', 'record-circle'],
  ['dataset', 'database'],
];

const PILOT_MAIL = 'mailto:business@openipc.org?subject=Teleoperation%20pilot';
const PARTNER_MAIL = 'mailto:business@openipc.org?subject=Teleoperation%20design%20partner'
  + '&body=Robot%3A%20%0ACamera%20chip%3A%20%0AHeadset%3A%20%0AWhat%20you%20want%20to%20teach%20it%3A%20%0A';
---

{/* ---- Cover: the thesis, and the operator mirrored by the robot ---- */}
<section class="bg-ink py-section text-white lg:py-section-lg">
  <div class="mx-auto max-w-[1240px] px-4">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="mb-3 text-sm tracking-[.08em] text-accent uppercase">{k('eyebrow')}</p>
        <h1 class="mb-3 text-4xl font-bold lg:text-5xl">{k('hero_title')}</h1>
        <p class="mb-6 text-lg text-white/80">{k('hero_lede')}</p>
        <p class="mb-0 flex flex-wrap gap-3">
          <a class="rounded-md bg-brand-blue px-6 py-3 text-base font-medium text-white no-underline hover:bg-btn-blue-hover" href={PILOT_MAIL}>
            {k('hero_cta_pilot')}
          </a>
          <a class="rounded-md border border-white/70 px-6 py-3 text-base font-medium text-white no-underline hover:border-white hover:bg-white/10" href={pathFor(locale, '/low-latency')}>
            {k('hero_cta_link')}
          </a>
        </p>
      </div>
      <div>
        <Image src={hero} alt={k('hero_art_alt')} widths={[836, 1672]} sizes="(min-width: 1024px) 50vw, 100vw" class="h-auto w-full" />
      </div>
    </div>
  </div>
</section>

{/* ---- Three figures, each with its source under it ---- */}
<section class="border-b border-hairline py-8">
  <div class="mx-auto max-w-[1240px] px-4">
    <div class="grid gap-6 text-center md:grid-cols-3 lg:text-left">
      {['market', 'units', 'latency'].map((key) => (
        <div>
          <span class="block font-mono text-3xl font-bold text-brand-blue">{k(`stat_${key}_n`)}</span>
          <span class="block text-sm text-body-secondary">{k(`stat_${key}_l`)}</span>
        </div>
      ))}
    </div>
    <p class="mt-4 mb-0 text-center text-sm text-body-secondary lg:text-left" set:html={k('stats_source_html')} />
  </div>
</section>

{/* ---- The landscape: the strategy is settled, the rig is not ---- */}
<section class="py-section">
  <div class="mx-auto max-w-[1240px] px-4">
    <h2 class="mb-6 text-2xl">{k('landscape_title')}</h2>
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="mb-4">{k('landscape_p1')}</p>
        <p class="mb-0">{k('landscape_p2')}</p>
      </div>
      <div>
        <p class="mb-4">{k('landscape_p3')}</p>
        <p class="mb-0">{k('landscape_p4')}</p>
      </div>
    </div>
    <blockquote class="mt-12 mb-0 border-l-4 border-accent pl-6 text-xl text-body-secondary italic">
      <p class="mb-0">{k('pull_quote')}</p>
    </blockquote>
  </div>
</section>

{/* ---- Four things the stack brings, in benefit language ---- */}
<section class="bg-surface-alt py-section">
  <div class="mx-auto max-w-[1240px] px-4">
    <h2 class="mb-2 text-2xl">{k('brings_title')}</h2>
    <p class="mb-6 max-w-[70ch] text-body-secondary">{k('brings_intro')}</p>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {BRINGS.map(([key, icon]) => (
        <div class="flex h-full flex-col rounded-lg border border-hairline bg-white p-5">
          <Icon name={icon} class="size-7 text-brand-blue" />
          <h3 class="mt-3 mb-2 text-base font-semibold">{k(`bring_${key}_title`)}</h3>
          <p class="mb-0 text-sm text-body-secondary">{k(`bring_${key}_text`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ---- The flywheel, and what a pilot looks like ---- */}
<section class="py-section">
  <div class="mx-auto max-w-[1240px] px-4">
    <h2 class="mb-2 text-2xl">{k('loop_title')}</h2>
    <p class="mb-10 max-w-[70ch] text-body-secondary">{k('loop_intro')}</p>

    {/* The arrows are decoration between list items, so they are not in the list. */}
    <div class="flex flex-col items-stretch gap-3 lg:flex-row lg:items-center" role="list">
      {NODES.map(([key, icon], i) => (
        <>
          {i > 0 && (
            <div class="flex shrink-0 justify-center text-body-secondary lg:rotate-0 rotate-90" aria-hidden="true">
              <Icon name="arrow-right" class="size-5" />
            </div>
          )}
          <div class="flex-1 rounded-lg border border-hairline bg-white p-4 text-center" role="listitem">
            <Icon name={icon} class="mx-auto size-6 text-brand-blue" />
            <h3 class="mt-2 mb-1 text-base font-semibold">{k(`node_${key}_title`)}</h3>
            <p class="mb-0 text-sm text-body-secondary">{k(`node_${key}_text`)}</p>
          </div>
        </>
      ))}
    </div>
    <p class="mt-4 mb-12 flex items-center justify-center gap-2 text-body-secondary">
      <Icon name="arrow-repeat" class="size-4" />{k('loop_return')}
    </p>

    <h3 class="mb-6 text-xl">{k('pilot_title')}</h3>
    <div class="grid gap-6 md:grid-cols-3">
      {[1, 2, 3].map((i) => (
        <div>
          <div class="mb-2 font-mono text-2xl text-brand-blue/40">0{i}</div>
          <h4 class="mb-2 text-base font-semibold">{k(`pilot${i}_title`)}</h4>
          <p class="mb-0 text-body-secondary">{k(`pilot${i}_text`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ---- Why OpenIPC ---- */}
<section class="bg-surface-alt py-section">
  <div class="mx-auto max-w-[1240px] px-4">
    <h2 class="mb-6 text-2xl">{k('why_title')}</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {[1, 2, 3].map((i) => (
        <div>
          <h3 class="mb-2 text-base font-semibold">{k(`why${i}_title`)}</h3>
          <p class="mb-0 text-sm text-body-secondary">{k(`why${i}_text`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ---- The ask. No top gap: the band follows a tinted full-bleed section. ---- */}
<section class="bg-ink py-section text-white">
  <div class="mx-auto max-w-[1240px] px-4 text-center">
    <h2 class="mb-4 text-3xl">{k('cta_title')}</h2>
    <p class="mx-auto mb-6 max-w-[62ch] text-white/70">{k('cta_text')}</p>
    <p class="mb-0 flex flex-wrap justify-center gap-3">
      <a class="rounded-md bg-brand-blue px-6 py-3 text-base font-medium text-white no-underline hover:bg-btn-blue-hover" href={PARTNER_MAIL}>
        {k('cta_primary')}
      </a>
      <a class="rounded-md border border-white/70 px-6 py-3 text-base font-medium text-white no-underline hover:border-white hover:bg-white/10" href="https://t.me/openipc">
        {k('cta_secondary')}
      </a>
    </p>
    <p class="mx-auto mt-8 mb-0 max-w-[62ch] text-sm text-white/60" set:html={k('cta_note_html')} />
  </div>
</section>
