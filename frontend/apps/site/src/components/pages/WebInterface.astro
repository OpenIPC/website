---
/**
 * The web interface page (#160).
 *
 * Shot from a real camera by tools/webui-gallery; run it again when the WebUI
 * changes shape. The list of screens and the captions come from
 * data/webui_gallery.yml -- through the JSON export -- so the tool and this
 * page cannot disagree about what the gallery
 * contains.
 *
 * The two pages with a live player show a beach rather than the bench of
 * cables the lab camera actually faces; see the credit under the grid. The
 * scene is laid over the <video> in the DOM at capture time, the same way the
 * lab's address and MAC are rewritten out of the text.
 */
import Container from '../Container.astro';
import PageTitle from '../PageTitle.astro';
import WebuiTile from '../WebuiTile.astro';
import ZoomDialog from '../ZoomDialog.astro';
import { useTranslations, type Locale } from '../../lib/i18n';
import { SCREENS } from '../../lib/webui';

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const k = (s: string) => t(`pages.web_interface.${s}`);
---
<Container>
  <article>
    <PageTitle>{k('title')}</PageTitle>
    <p class="mb-6 text-xl font-light lg:w-2/3">{k('intro')}</p>

    <div id="screens" class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {SCREENS.map((screen) => <WebuiTile screen={screen} />)}
    </div>

    <p class="mt-4 text-sm text-body-secondary lg:w-2/3" set:html={k('scene_credit_html')} />
  </article>
</Container>

<ZoomDialog />
