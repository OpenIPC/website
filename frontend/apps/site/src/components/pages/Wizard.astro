---
/**
 * One SoC's installation wizard (#164).
 *
 * The page is prerendered per SoC and per locale, and everything on it is the
 * island's: which of the two views a visitor sees depends on the query
 * string, and which menus the form offers depends on what upstream has
 * published -- a release index a cron refreshes hourly, which a page built in
 * CI cannot know. So this file resolves what the catalogue knows, hands it
 * over, and renders nothing itself.
 *
 * What the commands say is never decided here or in the island: they are
 * rendered by the Go service and fetched as data (#163).
 */
import Wizard from '../wizard/Wizard.tsx';
import KnownBoards from '../boards/KnownBoards.tsx';
import ZoomDialog from '../ZoomDialog.astro';
import { pathFor, type Locale } from '../../lib/i18n';
import { STATUS_WORDS, VENDORS, fullName, socPath, vendorPath, type Soc, type Vendor } from '../../lib/hardware';
import { useTranslations } from '../../lib/i18n';
import { SUPPORT_GOAL } from '../../data/support-goal';

const STAGE_ICONS = import.meta.glob<ImageMetadata>(
  '../../assets/stages/stage-*.svg',
  { eager: true, import: 'default' },
);
const WARNING = await import('../../assets/icons/pose/warning_front.png');

/** `Soc::SEGMENTS`. Anything else is `unknown`, as `segment_name` has it. */
const SEGMENTS = ['fpv', 'cctv', 'consumer', 'unknown'];

interface Props { locale: Locale; vendor: string; soc: string }
const { locale, vendor: vendorSlug, soc: socSlug } = Astro.props;

const vendor: Vendor | undefined = VENDORS.find((v) => v.urlname === vendorSlug);
if (!vendor) throw new Error(`No vendor "${vendorSlug}" in the catalogue.`);
const soc: Soc | undefined = vendor.socs.find((s) => s.urlname === socSlug);
if (!soc) throw new Error(`No SoC "${socSlug}" under ${vendorSlug}.`);

const t = useTranslations(locale);
const p = (path: string) => pathFor(locale, path);

const stage = STAGE_ICONS[`../../assets/stages/stage-${soc.status}.svg`];
if (!stage) throw new Error(`No stage-${soc.status}.svg in src/assets/stages.`);

const here = p(socPath(vendor, soc));
const notes = soc.community_notes;
---

{/*
  The whole page is the island, header and breadcrumb included, because the
  form and the instructions are two different pages at one address and only the
  query string says which. It is server-rendered here in the state a visitor
  arriving without one sees, so the page a crawler reads and the page that
  arrives with JavaScript off are both the form.
*/}
<Wizard
  client:load
  locale={locale}
  source={`/api/v1/wizard/${soc.urlname}.json`}
  here={here}
  warningSrc={WARNING.default.src}
  supportGoal={SUPPORT_GOAL}
  supportLabels={{
    count: t('support.count_html'),
    countMet: t('support.count_met_html'),
    meter: t('support.meter_label'),
    monthly: t('support.monthly_html'),
    split: t('support.split_html'),
  }}
  links={{
    business: p('/business'),
    donate: p('/donate'),
    wall: p('/open-wall'),
    community: p('/community'),
    lowLatency: p('/low-latency'),
  }}
  facts={{
    fullName: fullName(vendor, soc),
    model: soc.model,
    status: soc.status,
    statusTitle: STATUS_WORDS[soc.status] ?? soc.status,
    stageSrc: stage.src,
    segment: SEGMENTS.includes(soc.segment ?? '') ? soc.segment! : 'unknown',
    vendorName: vendor.name,
    vendorHref: p(vendorPath(vendor)),
    socHref: here,
    vendorsHref: p('/supported-hardware/featured'),
    homeHref: p('/'),
    stagesHref: `${p('/supported-hardware/full-list')}#stages`,
  }}
/>

{/*
  What a community expert has said about this chip, point by point, each point
  linking the messages it comes from (data/catalogue's community_notes). Plain
  HTML after the wizard, so a crawler and a reader without JavaScript see it.
*/}
{notes && (
  <section class="site-container mt-12 grid gap-3" aria-labelledby="community-notes">
    <h2 id="community-notes" class="mb-0 text-h3 font-semibold">{t('cameras.socs.soc.community_title', { chip: soc.model })}</h2>
    <p class="mb-0 max-w-[75ch] text-sm text-body-secondary">{t('cameras.socs.soc.community_intro', { by: notes.by })}</p>
    <ul class="m-0 grid max-w-[85ch] gap-2 pl-5">
      {notes.points.map((pt) => (
        <li>
          {pt.text}{' '}
          <span class="text-sm text-body-secondary">
            ({pt.sources.map((url, i) => (<>{i > 0 && ', '}<a href={url} rel="noopener" target="_blank">{t('cameras.socs.soc.community_source', { n: i + 1 })}</a></>))})
          </span>
        </li>
      ))}
    </ul>
  </section>
)}

{/*
  The boards on record with this SoC (/cameras/boards), after the wizard. It
  renders nothing until it has boards to show, and nothing at all when there
  are none or the catalogue cannot be fetched, so the wizard never waits on it.
*/}
<KnownBoards client:idle locale={locale} soc={soc.urlname} model={soc.model} catalogueHref={p('/cameras/boards')} />
<ZoomDialog locale={locale} />
