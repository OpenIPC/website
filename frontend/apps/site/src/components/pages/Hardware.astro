---
/**
 * The SoC catalogue: recommended, one vendor, or the full list (#162).
 *
 * The three hardware views, rendered from the same
 * template and differs only in which rows it is given. The data is
 * ../../lib/hardware.ts -- data/catalogue/*.yml, baked -- so this page needs no
 * database.
 *
 * One column is not in the catalogue and cannot be. `Soc#availability` asks
 * what upstream has published, which a cron learns hourly, so a page built on
 * Tuesday would tell Friday's visitor that a chip has no firmware when it got
 * some on Wednesday. The page states what was true when it was built and
 * corrects itself on load from /api/v1/hardware/availability.json. The baked
 * value is what a crawler and a reader without JavaScript see, which is why it
 * is baked at all rather than left blank.
 *
 * "Generate an installation guide" links to each SoC's wizard page (#164).
 *
 * It is written for the owner of a camera rather than for a firmware
 * developer: it opens with the question they came with and three ways to
 * answer it, and each row says whether the chip can be installed before it
 * says anything else about it.
 */
import { allRows, featuredRows, vendorRows, vendorBySlug, fullName, socPath, vendorPath, STATUS_WORDS, VENDORS, type Availability, type Row, type Vendor } from '../../lib/hardware';
import availability from '../../data/availability.json';
import { pathFor, useTranslations, type Locale } from '../../lib/i18n';
import { Image } from 'astro:assets';
import StageList from '../StageList.astro';
import HardwareTabs from '../HardwareTabs.astro';
import FourWays from '../FourWays.astro';
import Icon from '../Icon.astro';

const STAGE_ICONS = import.meta.glob<ImageMetadata>(
  '../../assets/stages/stage-*.svg',
  { eager: true, import: 'default' },
);
const stageIcon = (status: string) => {
  const found = STAGE_ICONS[`../../assets/stages/stage-${status}.svg`];
  if (!found) throw new Error(`No stage-${status}.svg in src/assets/stages.`);
  return found;
};

interface Props {
  locale: Locale;
  /** Which of the three the page is: the tab strip marks it current. */
  view: 'featured' | 'full-list' | 'vendor';
  /** For a vendor page, its urlname. */
  vendor?: string;
}
const { locale, view, vendor: vendorSlug } = Astro.props;

const t = useTranslations(locale);
const k = (key: string) => t(`cameras.socs.index.${key}`);
const rowKey = (key: string) => t(`cameras.socs.soc.${key}`);

/**
 * Why a chip cannot be installed, in words. The row says it from the status
 * because "we have the SDK and no board" and "we have the board and need a
 * developer" are different things and one of them a reader can act on; a
 * status with no sentence of its own falls back to the general one, which is
 * what the original partial's `default:` did.
 */
const unavailableFor = (status: string) =>
  t(`cameras.socs.soc.unavailable_${status}`, { fallback: rowKey('unavailable') });

const states = availability.socs as Record<string, Availability>;
const stateOf = (urlname: string): Availability => states[urlname] ?? 'none';
const installable = (v: Vendor) => v.socs.filter((s) => stateOf(s.urlname) !== 'none').length;

const rows: Row[] =
  view === 'featured' ? featuredRows() : view === 'vendor' ? vendorRows(vendorSlug!) : allRows();

const vendor = view === 'vendor' ? vendorBySlug(vendorSlug!) : null;

const listTitle =
  view === 'featured' ? k('list_featured')
    : view === 'vendor' ? k('list_vendor').replace('{vendor}', vendor!.name)
      : k('list_full');

/**
 * What a camera owner came to learn, before anything else about the chip:
 * can I install it? The answer is the availability state, as a word, beside
 * the link or the reason. The stage is how the project tracks a chip, and a
 * reader of the recommended list, where every one is DONE, learned nothing
 * from it; it stays on the full list and the vendor pages, in words. The load
 * address is for someone typing bootloader commands, and the wizard gives it
 * to them: here it is on the full list only.
 */
const showStage = view !== 'featured';
const showLoadAddress = view === 'full-list';

const p = (path: string) => pathFor(locale, path);

/**
 * How many of the catalogue's chips can be installed, over all of them. Baked
 * from the build's availability and corrected on load with the rows and the
 * badges; the numbers are in their own elements so the script can reach them.
 */
const installableTotal = VENDORS.reduce((sum, v) => sum + installable(v), 0);
const socTotal = VENDORS.reduce((sum, v) => sum + v.socs.length, 0);
const installableSentence = k('chip_installable_html')
  .replace('{count}', `<strong data-installable-count>${installableTotal}</strong>`)
  .replace('{total}', String(socTotal));

/**
 * The row's own address. It was /supported-hardware#<soc>, which redirects to
 * the recommended list and so lost every chip that is not on it.
 */
const here = p(view === 'featured' ? '/supported-hardware/featured'
  : view === 'vendor' ? vendorPath(vendor!) : '/supported-hardware/full-list');
---

<div class="site-container mt-4 mb-6">
<article class="hardware">
  {view === 'featured' ? (
    <>
      <header class="mb-8">
        <p class="mt-3 mb-2 text-sm font-semibold tracking-[.08em] text-brand-blue uppercase">{t('nav.supported_hardware')}</p>
        <h1 class="mb-0 text-h1 font-bold tracking-tight text-balance lg:text-5xl">{t('ways.title')}</h1>
        <p class="mt-3 mb-0 max-w-[65ch] text-lg text-body-secondary">{t('ways.lede')}</p>
      </header>
      <FourWays locale={locale} variant="full" />
      <section id="socs" class="border-t border-hairline pt-10">
        <h2 class="mb-1 text-h2 font-bold">{k('chip_title')}</h2>
        <p class="mb-6 text-body-secondary" data-installable-sentence set:html={installableSentence} />
      </section>
    </>
  ) : (
    <header id="socs" class="mb-6">
      <p class="mt-3 mb-2 text-sm">
        <a class="inline-flex items-center gap-1.5 font-medium no-underline" href={p('/supported-hardware/featured')}>
          <Icon name="arrow-left" />{k('ways_link')}
        </a>
      </p>
      <h1 class="mb-1 text-h1 font-bold tracking-tight">{listTitle}</h1>
      <p class="mb-0 text-body-secondary">{k('chip_lede')}</p>
    </header>
  )}

  <HardwareTabs locale={locale} view={view} vendor={vendorSlug} />

  {view === 'featured' && (
    <>
      <h3 class="mb-1 text-xl font-semibold">{listTitle}</h3>
      <p class="mb-4 text-body-secondary">{k('list_featured_intro')}</p>
    </>
  )}

  {vendor && installable(vendor) === 0 && (
    <div class="site-alert site-alert-warning flex gap-4" data-empty-vendor={vendor.urlname}>
      <span class="size-5 shrink-0 text-xl leading-[1.6]">&#9432;</span>
      <p
        class="mb-0"
        set:html={k('nothing_installable_html')
          .replace('{vendor}', vendor.name)
          .replace('{total}', String(vendor.socs.length))}
      />
    </div>
  )}

  <table class="socs mb-6">
    <thead>
      <tr>
        <th scope="col">{k('th_soc_model')}</th>
        {showLoadAddress && <th scope="col">{k('th_baseaddr')}</th>}
        {showStage && <th scope="col" class="stage">{k('th_stage')}</th>}
        <th scope="col">{k('th_docs')}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(({ vendor: v, soc }) => (
        <tr id={soc.urlname}>
          <th scope="row" class="chip">
            <span class="vendor">{v.name}</span> <span class="model">{soc.model}</span>
            <a class="chip-link" href={`${here}#${soc.urlname}`} title={k('copy_link')} data-copied={k('link_copied')}>
              <Icon name="link-45deg" class="size-4" />
              <span class="sr-only">{k('copy_link_to').replace('{chip}', fullName(v, soc))}</span>
            </a>
          </th>
          {showLoadAddress && <td class="addr" data-label={k('th_baseaddr')}>{soc.load_address}</td>}
          {showStage && (
            <td class="stage">
              <Image src={stageIcon(soc.status)} alt={STATUS_WORDS[soc.status]} title={STATUS_WORDS[soc.status]} width={34} height={20} />
            </td>
          )}
          <td
            class="verdict"
            data-soc={soc.urlname}
            data-state={stateOf(soc.urlname)}
            data-href={p(socPath(v, soc))}
            data-unavailable={unavailableFor(soc.status)}
          >
            <span class={`soc-verdict soc-verdict-${stateOf(soc.urlname)}`}>{k(`verdict_${stateOf(soc.urlname)}`)}</span>
            <span class="soc-action">
              {stateOf(soc.urlname) === 'wizard' ? (
                <a href={p(socPath(v, soc))}>{rowKey('generate_guide')}</a>
              ) : stateOf(soc.urlname) === 'firmware_only' ? (
                <a href={p(socPath(v, soc))}>{rowKey('firmware_only')}</a>
              ) : (
                <span class="text-body-secondary">{unavailableFor(soc.status)}</span>
              )}
            </span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  {/*
    The stages page used to be its own page and its own menu entry. It is how
    the project tracks a chip, which a camera owner does not need to read the
    table, so it lives here, closed, and /stages-of-firmware-development
    redirects to #stages -- which opens it.
  */}
  <details id="stages" class="stages">
    <summary class="mb-4 cursor-pointer font-medium text-brand-blue">{k('stages_details')}</summary>
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7"><StageList locale={locale} /></div>
      <div class="text-body-secondary lg:col-span-5">
        <h3 class="mb-3 text-lg font-semibold text-body">{t('pages.stages_of_firmware_development.subtitle')}</h3>
        <p class="mb-3">{t('pages.stages_of_firmware_development.paragraph1')}</p>
        <p class="mb-3">{t('pages.stages_of_firmware_development.paragraph2')}</p>
        <p class="mb-0">{t('pages.stages_of_firmware_development.paragraph3')}</p>
      </div>
    </div>
  </details>
</article>
</div>

{/*
  What the build could not know. The words for each state are already on the
  page in this locale, so the script moves cells between them rather than
  fetching sentences.
*/}
<p id="copy-status" class="sr-only" aria-live="polite"></p>

<script is:inline>
  // /stages-of-firmware-development redirects to #stages: open what it names.
  if (location.hash === '#stages') document.getElementById('stages').open = true;

  // A row's link icon copies the row's address. It is a real link underneath,
  // so with no clipboard (plain http, an old browser, a refusal) it does what a
  // link does and puts the address in the bar instead.
  const copyStatus = document.getElementById('copy-status');
  document.addEventListener('click', (event) => {
    const link = event.target.closest('.chip-link');
    if (!link || !navigator.clipboard) return;
    event.preventDefault();
    navigator.clipboard.writeText(link.href).then(() => {
      history.replaceState(null, '', link.hash);
      link.classList.add('is-copied');
      copyStatus.textContent = link.dataset.copied;
      setTimeout(() => {
        link.classList.remove('is-copied');
        copyStatus.textContent = '';
      }, 2000);
    }, () => {
      location.hash = link.hash;
    });
  });
</script>

<script
  is:inline
  define:vars={{
    words: {
      wizard: t('cameras.socs.soc.generate_guide'),
      firmware_only: t('cameras.socs.soc.firmware_only'),
      installable_title: t('cameras.socs.index.installable_title'),
    },
    verdicts: {
      wizard: t('cameras.socs.index.verdict_wizard'),
      firmware_only: t('cameras.socs.index.verdict_firmware_only'),
      none: t('cameras.socs.index.verdict_none'),
    },
    // Which SoCs belong to which vendor. The badges count every chip a vendor
    // has, and this page shows thirty of a hundred and twenty-six -- counting
    // the rows on screen gave Goke 4 where the origin says 12. About 2 KB, and
    // the alternative is a second endpoint that knows the catalogue.
    catalogue: Object.fromEntries(VENDORS.map((v) => [v.urlname, v.socs.map((s) => s.urlname)])),
  }}
>
  (async () => {
    let live;
    try {
      const response = await fetch('/api/v1/hardware/availability.json', {
        headers: { accept: 'application/json' },
      });
      if (!response.ok) return;
      live = await response.json();
    } catch {
      // Offline, or the origin is down. The page keeps what it was built with,
      // which is the last state anybody knew to be true.
      return;
    }
    if (!live || typeof live.socs !== 'object') return;

    for (const cell of document.querySelectorAll('[data-soc]')) {
      // A state this page has no words for is one it cannot offer: none.
      const state = live.socs[cell.dataset.soc] in verdicts ? live.socs[cell.dataset.soc] : 'none';
      if (cell.dataset.state === state) continue;
      cell.dataset.state = state;

      const verdict = cell.querySelector('.soc-verdict');
      verdict.className = `soc-verdict soc-verdict-${state}`;
      verdict.textContent = verdicts[state];

      const action = cell.querySelector('.soc-action');
      action.textContent = '';
      if (state === 'none') {
        const span = document.createElement('span');
        span.className = 'text-body-secondary';
        span.textContent = cell.dataset.unavailable;
        action.append(span);
      } else {
        const anchor = document.createElement('a');
        anchor.href = cell.dataset.href;
        anchor.textContent = words[state];
        action.append(anchor);
      }
    }

    // The sentence over the recommended list counts the same answer.
    const total = document.querySelector('[data-installable-count]');
    if (total) {
      total.textContent = String(Object.values(catalogue).flat()
        .filter((urlname) => (live.socs[urlname] || 'none') !== 'none').length);
    }

    // The tab badges count the same answer -- over the whole catalogue, not
    // over the rows this page happens to show.
    for (const badge of document.querySelectorAll('[data-vendor]')) {
      const socs = catalogue[badge.dataset.vendor];
      if (!socs) continue;

      const count = socs.filter((urlname) => (live.socs[urlname] || 'none') !== 'none').length;

      badge.textContent = String(count);
      badge.classList.toggle('site-badge-primary', count > 0);
      // A vendor with nothing installable has no tab (../HardwareTabs.astro),
      // except the one this page is about.
      const tab = badge.closest('li');
      if (tab && !tab.querySelector('[aria-current]')) tab.hidden = count === 0;
      badge.title = words.installable_title
        .replace('{count}', String(count))
        .replace('{total}', badge.dataset.total);
    }
  })();
</script>
