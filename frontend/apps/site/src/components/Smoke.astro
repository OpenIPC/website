---
/**
 * Proof that the seam works, in three languages.
 *
 * deploy/static/README.md: "a page is extracted when its index.html is in the
 * bundle". Until #160 moves the marketing pages, the only thing in the bundle
 * is this -- so it has to exercise every part of the chain #160 depends on,
 * while claiming nothing a visitor reads:
 *
 *   * three locale trees at the addresses #154 settled;
 *   * strings from the real catalogue, exported from config/locales;
 *   * the English fallback, shown working rather than described;
 *   * @openipc/ui rendering, both prerendered and hydrated;
 *   * the design tokens the package ships.
 *
 * It replaces deploy/static/src/_smoke/index.html, which proved only that
 * nginx served a file.
 */
import Base from '../layouts/Base.astro';
import { MainButton } from '@openipc/ui';
import Counter from './Counter.tsx';
import { LOCALES, useTranslations, pathFor, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const revision = '@@REVISION@@';
const built = '@@BUILT@@';

// A key every locale has, and one only English has. The fallback is the
// behaviour most likely to rot unnoticed, so the page shows it working:
// support.array.words_connector is one of the three keys in en.json with no
// ru or zh translation.
const translated = t('site.default_meta_description');
const fallback = t('support.array.words_connector');

const rows: [string, string][] = [
  ['locale', locale],
  ['built from', revision],
  ['built at', built],
];
---
<Base
  locale={locale}
  path="/_smoke"
  title={`Static bundle smoke — ${locale}`}
  description="Proof that the static bundle, its three locale trees and the component library are alive."
>
  <div class="mx-auto flex max-w-3xl flex-col gap-6 p-6">
    <header class="flex flex-col gap-1">
      <h1 class="text-2xl font-bold text-brand-blue">Static bundle smoke</h1>
      <p class="text-sm text-dark-grey">
        Served by nginx out of the bundle, not by Rails. Built by Astro (#159).
      </p>
    </header>

    <dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-1 font-mono text-sm">
      {rows.map(([k, v]) => (
        <>
          <dt class="text-dark-grey">{k}</dt>
          <dd class="break-all">{v}</dd>
        </>
      ))}
    </dl>

    <section class="flex flex-col gap-2">
      <h2 class="font-bold">From the exported catalogue</h2>
      <p class="text-sm">{translated}</p>
      <p class="text-xs text-dark-grey">
        <code>config/locales/*.yml</code> is the source. <code>bin/rails i18n:export</code> writes
        the JSON this reads, and <code>test/i18n_export_test.rb</code> fails if the two disagree.
      </p>
      <p class="text-xs text-dark-grey">
        <code>support.array.words_connector</code> in <code>{locale}</code>:
        <b>{`"${fallback}"`}</b>
        {locale === 'en'
          ? ' — its own string.'
          : ' — English, because this language has none. That is config.i18n.fallbacks, kept.'}
      </p>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="font-bold">From @openipc/ui</h2>
      <p class="text-xs text-dark-grey">
        The first button is prerendered: if it is styled before any JavaScript runs, the package's
        tokens carried over. The second is an island: if it counts, hydration works.
      </p>
      <div class="flex flex-row flex-wrap items-center gap-3">
        <MainButton size="m" caption={t('button.find')} />
        <Counter client:load />
      </div>
    </section>

    <nav class="flex flex-row gap-3 text-sm" aria-label="This page in every language">
      {LOCALES.map((l) => (
        <a class="text-brand-blue underline" href={pathFor(l, '/_smoke')}>{pathFor(l, '/_smoke')}</a>
      ))}
    </nav>
  </div>
</Base>
