---
/**
 * The full-size viewer for any image carrying data-zoom: a full-screen
 * gallery (../lib/gallery.ts) over every such picture in the image's nearest
 * [data-zoom-group], or on the page when it has none, opened on the one
 * clicked. Arrows, the arrow keys and a swipe move through them; a pinch, a
 * double tap or the zoom button goes to full resolution.
 *
 * Opened by delegation, so adding a tile costs nothing, and with JavaScript
 * off the tiles are simply images. data-zoom-width and data-zoom-height give
 * the full picture's size (how far it zooms); data-zoom-caption the line
 * under it, else its alt.
 *
 * It also writes the viewer's labels in the page's language, which the board
 * catalogue's island reads when it opens a board's photos itself.
 */
import { useTranslations, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const labels = Object.fromEntries(
  (['close', 'zoom', 'prev', 'next', 'original', 'error', 'of'] as const).map((k) => [k, t(`site.gallery.${k}`)]),
);
---
<script type="application/json" id="gallery-labels" set:html={JSON.stringify(labels)} />

<script>
  import { domGroup, openGallery } from '../lib/gallery';

  document.addEventListener('click', (event) => {
    const img = (event.target as HTMLElement | null)?.closest<HTMLImageElement>('img[data-zoom]');
    if (!img) return;
    event.preventDefault();
    const { items, index } = domGroup(img);
    void openGallery(items, index);
  });
</script>
