---
/**
 * The site's navbar, to the pixel (#160).
 *
 * Not @openipc/ui's HeaderMenu. That component is fancyweb-ng's navigation and
 * it cannot express this one: the brand is 116x32 at x=72, the links are
 * 16px/25.6 with 8px of padding, the language control is a 16px globe at
 * x=1320 and the bar is exactly 60px tall. Measured off the origin rather than
 * guessed, because "indistinguishable from the page it replaced" is the one thing
 * #160 has to deliver and the header is on every page of it.
 *
 * The package still draws the pages -- the timer, the QR code -- which is
 * what #158 extracted it for.
 *
 * Bootstrap's own numbers, for anyone checking this against the origin:
 *   .navbar            padding .5rem 0, background $ink, 60px tall here
 *   .navbar-brand      padding .3rem 0, font-size 1.25rem
 *   .nav-link          padding .5rem, colour rgba(255,255,255,.78)
 *   .dropdown-toggle   a .3em caret with .255em of spacing before it
 *   .dropdown-menu     $ink-2, .5rem radius, .5rem 0 padding
 *
 * The dropdowns open on click, as Bootstrap's do -- not on hover. The whole
 * tree is in the markup and hidden with CSS, so every address is crawlable and
 * reachable without JavaScript, which is the property #160 needs and the thing
 * the package's menu did not do.
 */
import { LOCALE_NAMES, alternates, pathFor, useTranslations, type Locale } from '../lib/i18n';
import { CLUB_MENU, isCurrent, menuFor } from '../lib/nav';
import ClubMenu from './club/ClubMenu.tsx';
import logo from '../assets/openipc-logo-white.svg';
import translate from '../assets/icons/translate.svg?raw';
import github from '../assets/icons/github.svg?raw';

interface Props { locale: Locale; path: string }
const { locale, path } = Astro.props;

const t = useTranslations(locale);
const items = menuFor(locale);
const alt = alternates(path);

// The entry for the page being built, and the group it sits in: a reader on
// /teleoperation sees "Use cases" marked, and the link itself inside it.
type Item = (typeof items)[number];
const leaves = (item: Item): Item[] => item.type === 'link' ? [item] : (item.children ?? []).flatMap(leaves);
const current = (item: Item) => leaves(item).some((leaf) => isCurrent(leaf.url, locale, path));

const clubLabels = Object.fromEntries(
  [...CLUB_MENU.map((e) => e.key), 'sign_out', 'sign_out_failed', 'member_menu'].map((key) => [key, t(`nav.${key}`)]),
);
---

<nav class="site-nav sticky top-0 z-[1020] border-b border-white/[.08] bg-ink py-2" aria-label="Main">
  <div class="site-container flex flex-wrap items-center">
    <a class="site-brand py-[.3rem] text-xl leading-8 text-white no-underline" href={pathFor(locale, '/')}>
      <img class="inline align-middle" src={logo.src} alt="Image: OpenIPC logo" height="32" width="116" />
    </a>

    {/*
      The toggler, and the block it opens. Bootstrap's own markup: a button
      that is gone from 1200px up, and a container that is a block below that
      and the row itself above it.

      `navbar-expand-xl`, as the original navbar had it and for its reason:
      the entries, the member's chip and the language control do not fit an lg
      breakpoint without wrapping, and a wrapped navbar reads as broken rather
      than as full. lib/pages.build.test.ts keeps the entries within what
      fits at 1200px. Collapsing at 992 put this bar in a state the origin never has --
      the full row at 1100px -- which is the width a laptop actually uses.
    */}
    <button
      type="button"
      class="site-nav-toggler"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={t('nav.menu')}
    >
      <svg class="site-nav-toggler-open" width="24" height="24" viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 7h22M4 15h22M4 23h22" />
      </svg>
      <svg class="site-nav-toggler-close" width="24" height="24" viewBox="0 0 30 30" fill="none" aria-hidden="true">
        <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M7 7l16 16M23 7L7 23" />
      </svg>
    </button>

    <div class="site-nav-collapse" id="site-menu">
    <ul class="flex list-none flex-col gap-0 p-0 xl:flex-row xl:items-center">
      {items.filter((item) => item.id !== 'github').map((item) => (
        <li class="site-nav-item relative">
          {item.type === 'link' ? (
            <a class="site-nav-link" href={item.url} aria-current={current(item) ? 'page' : undefined}>{item.label}</a>
          ) : (
            <>
              <a class="site-nav-link site-caret" href="#" role="button" aria-expanded="false" aria-haspopup="true" data-active={current(item) ? '' : undefined}>{item.label}</a>
              <ul class="site-dropdown">
                {item.children?.map((child) => (
                  child.type === 'parent' ? (
                    <>
                      <li><hr class="site-divider" /></li>
                      <li><h6 class="site-dropdown-header">{child.label}</h6></li>
                      {child.children?.map((leaf) => (
                        <li><a class="site-dropdown-item" href={leaf.url} aria-current={isCurrent(leaf.url, locale, path) ? 'page' : undefined}>{leaf.label}</a></li>
                      ))}
                      <li><hr class="site-divider" /></li>
                    </>
                  ) : (
                    <li><a class="site-dropdown-item" href={child.url} aria-current={isCurrent(child.url, locale, path) ? 'page' : undefined}>{child.label}</a></li>
                  )
                ))}
              </ul>
            </>
          )}
        </li>
      ))}

      <li class="site-nav-item relative">
        <ClubMenu client:idle locale={locale} labels={clubLabels} />
      </li>

      <li class="site-nav-item">
        <a class="site-nav-link" href="https://github.com/OpenIPC" title="OpenIPC on GitHub">
          <span class="inline-block size-5 align-[-.25rem]" set:html={github} />
          <span class="ms-2 xl:sr-only">GitHub</span>
        </a>
      </li>

      {/*
        The language control, where the original navbar put it: a globe at the
        end of the bar rather than a strip above it. The strip cost 18px of
        height on every page, which pushed the whole document down by that much
        against the origin.
      */}
      <li class="site-nav-item relative hidden xl:block">
        <a class="site-nav-link site-caret" href="#" role="button" aria-expanded="false" aria-haspopup="true" aria-label={`${t('nav.language')}: ${LOCALE_NAMES[locale]}`}>
          <span class="inline-block size-4 align-[-.15rem]" set:html={translate} />
        </a>
        <ul class="site-dropdown site-dropdown-end site-dropdown-lang">
          {Object.entries(alt).map(([code, target]) => (
            <li>
              <a
                class="site-dropdown-item"
                href={target}
                hreflang={code}
                aria-current={code === locale ? 'true' : undefined}
              >{LOCALE_NAMES[code as Locale]}</a>
            </li>
          ))}
        </ul>
      </li>

      {/*
        In the collapsed menu the languages are a row of their own rather
        than a dropdown: one tap to switch instead of two, and three short
        names fit a phone's width.
      */}
      <li class="site-nav-item site-lang-row xl:hidden">
        <span class="inline-block size-4 shrink-0 text-white/55" set:html={translate} aria-hidden="true" />
        <ul class="flex list-none flex-wrap gap-1 p-0" aria-label={t('nav.language')}>
          {Object.entries(alt).map(([code, target]) => (
            <li>
              <a
                class="site-lang-chip"
                href={target}
                hreflang={code}
                lang={code}
                aria-current={code === locale ? 'true' : undefined}
              >{LOCALE_NAMES[code as Locale]}</a>
            </li>
          ))}
        </ul>
      </li>
    </ul>
    </div>
  </div>
</nav>

<script>
  // Bootstrap's dropdown, in the lines this needs: one open at a time,
  // click to toggle, click away or Escape to close.
  // An anchor with role="button", which is the control the original navbar used.
  // Not cosmetic: Bootstrap focuses the control when the panel opens, and a
  // browser draws its focus ring for an activated link where it withholds one
  // from a button clicked with a mouse. With a <button> here the origin
  // outlined the open control and this bar did not.
  //
  // Delegated from the bar rather than bound to each control: the member's
  // chip (club/ClubMenu.tsx) is an island that renders after this has run, and
  // it must open, close and take the arrow keys like every other panel.
  const nav = document.querySelector<HTMLElement>('.site-nav');

  // The toggler, below 1200px. `data-open` rather than a class, so the CSS
  // that shows the block and the CSS that hides it live next to each other.
  const toggler = document.querySelector<HTMLButtonElement>('.site-nav-toggler');
  const collapse = document.getElementById('site-menu');

  const menuOpen = () => collapse?.hasAttribute('data-open') ?? false;

  function closeMenu() {
    collapse?.removeAttribute('data-open');
    toggler?.setAttribute('aria-expanded', 'false');
  }

  toggler?.addEventListener('click', (event) => {
    event.stopPropagation();
    if (menuOpen()) {
      closeMenu();
      return;
    }
    collapse?.setAttribute('data-open', '');
    toggler.setAttribute('aria-expanded', 'true');
  });

  function toggles(): HTMLAnchorElement[] {
    return nav ? [...nav.querySelectorAll<HTMLAnchorElement>('.site-caret')] : [];
  }

  function closeAll(except?: Element) {
    for (const t of toggles()) {
      if (t === except) continue;
      t.setAttribute('aria-expanded', 'false');
    }
  }

  function toggleOf(target: EventTarget | null): HTMLAnchorElement | null {
    return target instanceof Element ? target.closest<HTMLAnchorElement>('.site-caret') : null;
  }

  nav?.addEventListener('click', (event) => {
    const toggle = toggleOf(event.target);
    if (!toggle) return;
    event.preventDefault();
    event.stopPropagation();
    const open = toggle.getAttribute('aria-expanded') === 'true';
    closeAll(toggle);
    toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
    toggle.focus();
  });

  // A click away closes any panel; one outside the bar altogether -- on the
  // page the collapsed menu is covering -- closes the menu too.
  document.addEventListener('click', (event) => {
    closeAll();
    if (menuOpen() && !(event.target instanceof Node && nav?.contains(event.target))) closeMenu();
  });

  function itemsOf(toggle: HTMLAnchorElement): HTMLAnchorElement[] {
    const panel = toggle.nextElementSibling;
    return panel ? [...panel.querySelectorAll<HTMLAnchorElement>('a')] : [];
  }

  // On the menu item rather than on the control: the panel's links take focus
  // as soon as it opens, and a listener bound to the control alone stops
  // hearing the arrow keys at that point -- so the reader could open a menu and
  // then not move through it.
  nav?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
    const item = (event.target as Element | null)?.closest<HTMLElement>('.site-nav-item');
    const toggle = item?.querySelector<HTMLAnchorElement>('.site-caret');
    if (!toggle) return;

    const items = itemsOf(toggle);
    if (items.length === 0) return;

    event.preventDefault();
    const open = toggle.getAttribute('aria-expanded') === 'true';

    if (!open) {
      closeAll(toggle);
      toggle.setAttribute('aria-expanded', 'true');
      (event.key === 'ArrowDown' ? items[0] : items[items.length - 1]).focus();
      return;
    }

    const here = items.indexOf(document.activeElement as HTMLAnchorElement);
    const step = event.key === 'ArrowDown' ? 1 : -1;
    // From the control itself, the first press goes to the first item rather
    // than wrapping to the last.
    const next = here === -1
      ? (event.key === 'ArrowDown' ? 0 : items.length - 1)
      : (here + step + items.length) % items.length;
    items[next].focus();
  });

  // Escape closes the innermost thing open: a panel first, then the collapsed
  // menu itself. Focus goes back to the control that opened it, or it lands
  // on the page behind a menu the reader has just dismissed.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const owner = toggles().find((t) => t.getAttribute('aria-expanded') === 'true');
    if (owner) {
      closeAll();
      owner.focus();
      return;
    }
    if (menuOpen()) {
      closeMenu();
      toggler?.focus();
    }
  });

</script>
