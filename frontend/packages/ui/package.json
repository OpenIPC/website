{
  "name": "@openipc/ui",
  "version": "0.1.0",
  "description": "OpenIPC's Preact component library: the widgets, design tokens and typefaces openipc.org is built from.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenIPC/website.git",
    "directory": "frontend/packages/ui"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/openipc-ui.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-styles.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static --disable-telemetry",
    "gallery": "node scripts/render-gallery.mjs"
  },
  "peerDependencies": {
    "preact": ">=10.27"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.17.3",
    "@eslint/js": "^9.39.1",
    "@preact/preset-vite": "^2.10.2",
    "@storybook/preact-vite": "^10.5.3",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-storybook": "10.5.3",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.0.1",
    "preact": "10.27.2",
    "preact-render-to-string": "6.6.2",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.0.18"
  }
}
