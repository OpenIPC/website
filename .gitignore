# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded files in development.
/storage/*
!/storage/.keep

# The Open Wall's frames. These moved out of public/ on 2026-09-23 -- Rails
# serves everything under public/ whatever nginx does, which was the door the
# transport change exists to close -- and moving them took them out of the
# /public/wall ignore they used to sit under. They are other people's cameras;
# they must never reach a commit.
/wall/*
!/wall/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore generated binaries
# Firmware#generate writes here: the assembled images, and a lock file per
# image so two requests cannot build the same one at once. *.bin already
# covers the images and the half-built .tmp-<image>-*.bin files; the locks are
# named .<image>.bin.lock and need their own line.
/public/files/*.bin
/public/files/*.lock

# Written by an older route_not_found; kept ignored so a stale copy on a
# developer machine is never committed again.
/public/notfound.txt

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/apache*.conf
/sbin/*

/app/assets/builds/*
!/app/assets/builds/.keep

# Any node_modules, at any depth. Anchored to the root it was not enough:
# tools/ gets one from the Playwright container that runs tools/turbo-check.mjs,
# and a `git add -A` swept 448 of those files onto master on 2026-09-20.
node_modules/

/config/credentials/production.key
/config/credentials/development.key

# Yarn Berry install state (regenerated locally).
/.yarn/install-state.gz


# Local overrides for the dev compose stack (DEV_UID/DEV_GID); never committed.
/.env
/dist/
