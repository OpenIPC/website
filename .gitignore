# Any node_modules, at any depth. Anchored to the root it was not enough:
# tools/ gets one from the Playwright container that runs tools/turbo-check.mjs,
# and a `git add -A` swept 448 of those files onto master on 2026-09-20.
node_modules/

# The Go service binary, built by service/run.sh.
/service/bin/

# The static bundle, built by deploy/static/build.sh.
/dist/

# The Open Wall's frames, if a local run writes them here. They are other
# people's cameras; they must never reach a commit.
/wall/*
!/wall/.keep

# What the retired application tree left behind on developer machines
# (#304): its uploads, its keys and its logs. These keep a stale copy out of
# a commit.
/storage/
/log/
/tmp/
/public/
/config/master.key
/config/credentials/*.key

# Local environment overrides; never committed.
/.env
