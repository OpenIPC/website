
server {
    listen 80;
    server_name openipc.org;
    #
    access_log /var/log/nginx/org.openipc.access.log openipc;
    error_log /var/log/nginx/org.openipc.error.log info;

    # limit_conn perip 10;

    location ^~ /.well-known/acme-challenge {
        proxy_redirect off;
        default_type "text/plain";
        alias   /var/lib/dehydrated/acme-challenges;
        allow all;
    }

    # The same exception on port 80. A check that asks for http://.../up is
    # redirected here and logged here, so silencing /up only in the TLS server
    # leaves the line it was meant to remove -- written by the redirect rather
    # than by the app, which is harder to notice, not easier.
    location = /up {
        access_log off;
        return 301 https://$host$request_uri;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}


server {
    listen 443 ssl http2;
    server_name openipc.org;
    #
    access_log /var/log/nginx/org.openipc.access.log openipc;
    error_log /var/log/nginx/org.openipc.error.log info;
    #
    ssl_certificate /var/lib/dehydrated/certs/openipc.org/fullchain.pem;
    ssl_certificate_key /var/lib/dehydrated/certs/openipc.org/privkey.pem;
    #
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_stapling off;
    ssl_stapling_verify on;
    ssl_session_tickets off;
    add_header Strict-Transport-Security max-age=15768000;
    resolver 1.1.1.1;

    # Declared crawlers that ignore robots.txt get the explicit version.
    if ($openipc_blocked_crawler) {
        return 403;
    }

    # The Open Wall scraper, which declares nothing and rotates its user agent.
    # Recognised by address instead. See conf.d/openipc-datacentre-block.conf
    # for the ranges and for the beacon test that says no reader is in them.
    if ($openipc_datacentre_client) {
        return 403;
    }

    location /dl/ {
        alias /srv/www/shared/dl/;
        allow all;
    }

    # Assembled firmware images. Rails decides who may have one and names the
    # file; nginx sends the bytes, so a slow client holds an nginx connection
    # instead of one of Puma's sixteen threads.
    #
    # `internal` means this is reachable only through X-Accel-Redirect, never by
    # asking for it. The browsable listing that used to be at /files/ goes with
    # it: images are reached through the download action, which is what applies
    # the flash-size and edition rules.
    # Nothing serves /files/ any more. Without this the request falls through to
    # the app, which serves public/ itself (RAILS_SERVE_STATIC_FILES=1), so every
    # image would still be fetchable by name -- straight through a Puma thread,
    # which is the cost handing them to nginx above exists to avoid.
    location /files/ {
        return 404;
    }

    # The optional (ru|zh)/ prefix on this and the two cache locations below is
    # not decoration. These regexes are anchored at ^/ and every rule they carry
    # -- the firmware rate limit here, the microcache and the concurrency caps
    # further down -- simply stops applying to a path that does not match. #154
    # localized /open-wall and that alone already opened the gap: /open-wall was
    # microcached and capped, /ru/open-wall was neither. Localizing the rest of
    # the catalogue without this would turn the firmware limit into a formality,
    # since /ru/cameras/.../download_full_image would be the same expensive
    # action with no limit_req in front of it. The list must stay in step with
    # Multilang::IN_PATH; a test asserts it does.
    #
    # Only the action that produces a firmware image. NOT `location /`:
    # proxy_set_header applies to everything a location serves, and
    # Rack::Sendfile acts on any response whose body responds to to_path --
    # which with RAILS_SERVE_STATIC_FILES=1 is every file under public/assets.
    # Setting these globally answered every stylesheet with an X-Accel-Redirect
    # to a path nginx has no location for, and took both sites down to unstyled
    # text on 2026-08-24.
    #
    # No URI part on proxy_pass: nginx forbids one in a regex location, and the
    # full original URI is what should reach the app anyway.
    location ~ ^/(?:(?:ru|zh)/)?cameras/vendors/[^/]+/socs/[^/]+/download_full_image {
        limit_conn site_conc 10;
        limit_conn_status 429;

        # Per address, where site_conc above is keyed on $server_name -- one
        # global pool of ten that a single client can take all of. See
        # conf.d/openipc-firmware-rate.conf for where the numbers come from.
        #
        # The bursts are what make them safe. Measured on dev with these exact
        # directives: nine plain requests go through back to back and the tenth
        # is shed; fifteen range requests in a row are not counted by fw_start
        # at all; and a client that sets a Range header to get round it gets
        # thirty-two through before fw_all sheds it. Real traffic's worst
        # minute in fifteen days was four plain requests, or thirty ranges of
        # one file.
        limit_req zone=fw_start burst=8 nodelay;
        limit_req zone=fw_all burst=30 nodelay;
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-Sendfile-Type X-Accel-Redirect;
        proxy_set_header X-Accel-Mapping /rails/public/files/=/protected-files/;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;
    }

    location /protected-files/ {
        internal;
        alias /srv/www/shared/files/;
    }

    # config/routes.rb redirects this one to the CDN, and the /images/ alias
    # below would otherwise swallow it: the file is not in that directory, so
    # nginx answered 404 where the app meant to redirect. An exact-match
    # location outranks a prefix one, so this reaches the app.
    location = /images/logo_openipc.png {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Four badges and logos from 2022-2023, embedded on pages this project does
    # not control. Nothing on this site references them. Kept in the repository
    # under deploy/legacy-images and installed here by deploy.sh, because this
    # directory is host-only and in no backup.
    location /images/ {
        alias /srv/www/shared/images/;
    }

    # Fingerprinted static assets and fonts, served by Rails but cached here
    # long-term (names change when content does). Deliberately outside the
    # site_conc cap: an HTTP/2 page load multiplexes many parallel asset
    # requests, and those must never compete with page renders for slots.
    # Analytics beacon (#181). GoatCounter runs on the loopback and these are
    # the only two paths of it the public site exposes.
    #
    # Two exact locations, deliberately not `location /api/a/`. GoatCounter is a
    # whole application behind this port -- dashboard, login, site settings, CSV
    # export -- and a prefix match would publish all of it under the site's own
    # name, where it would inherit the site's certificate and look like part of
    # openipc.org. The dashboard has a vhost of its own for that reason.
    #
    # Host is rewritten because GoatCounter picks the site from it, and these
    # requests arrive as openipc.org, openipc.ru or openipc.kz. Without this
    # each name would need a site of their own, or most of the traffic would be
    # dropped as unknown. openipc.eu was a fourth until 2026-09-21, when it
    # stopped being a mirror and became a 301 -- see sites-available/eu.openipc.
    # The backer count the donate page prints (#198).
    #
    # A static file written hourly by openipc-oc-stats, served straight off
    # disk: Rails never sees the request, so the mirrors can cache it and an
    # Open Collective outage cannot reach either. An exact location, ahead of
    # everything else under /api/, for the same reason the two beacon paths are
    # exact -- a prefix here would decide the shape of a namespace this file
    # has no business owning.
    #
    # An hour, matching the cron. A number that is up to an hour old is the
    # honest resolution of the thing being measured; the page refuses it
    # entirely past 48 hours, which is Rails' job, not nginx's.
    location = /api/v1/support/stats.json {
        alias /srv/www/shared/support-stats.json;
        default_type application/json;
        # Repeated, not inherited: add_header at location level replaces the
        # whole set the server block sends, so a location that adds one of its
        # own drops HSTS from everything it serves unless it says so again.
        add_header Strict-Transport-Security max-age=15768000;
        add_header Cache-Control "public, max-age=3600" always;
        add_header Access-Control-Allow-Origin "*" always;

        # Before the file exists, and between the write and the rename. The
        # page treats a 404 the same as a stale file: it renders without a
        # number, which is how it rendered before this existed.
        error_page 404 = @no_support_stats;
    }

    # The wizard's command blocks, one file per SoC (#164).
    #
    # The installation page is prerendered and its commands are not: what a
    # bootloader is told to do depends on what upstream has published, which a
    # publisher refreshes hourly, and a page built on Tuesday must not tell
    # Friday's visitor to flash a tarball that now exists in a different
    # edition. So the page fetches the SoC it is for.
    #
    # A regex location rather than a prefix, and the capture is a slug: the
    # name that arrives here becomes a filename, and Vendor/Soc validate the
    # same shape before one is ever written (#275). Anything else does not
    # match this location at all and falls through to the catch-all.
    location ~ ^/api/v1/wizard/(?<soc_slug>[a-z0-9][a-z0-9._-]*)\.json$ {
        alias /srv/www/shared/wizard/$soc_slug.json;
        default_type application/json;
        # Repeated, not inherited, for the reason given above the backer count.
        add_header Strict-Transport-Security max-age=15768000;
        # An hour, matching the publisher. A file up to an hour old is the
        # honest resolution of the thing being described.
        add_header Cache-Control "public, max-age=3600" always;

        # A SoC with nothing published has no file, and the page says so
        # itself rather than showing commands that name tarballs nobody built.
        error_page 404 = @no_wizard_export;
    }

    location @no_wizard_export {
        default_type application/json;
        return 404 '{"error":"not available"}';
    }

    location @no_support_stats {
        return 404 '{"error":"not available"}';
    }

    location = /api/a/c.js {
        proxy_pass http://127.0.0.1:8081/count.js;
        proxy_set_header Host analytics.openipc.org;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/a/count {
        # A plain GET with a query string: anything that can read the page can
        # replay it, without running any JavaScript. GoatCounter has a limit of
        # its own (4/s per address) and this one sits deliberately above it --
        # see conf.d/openipc-beacon-rate.conf. This keeps a flood off the Go
        # process; that keeps the numbers honest.
        limit_req zone=beacon burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8081/count;
        proxy_set_header Host analytics.openipc.org;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Never cached. A cached count is a count that happened once and was
        # then reported as many, or not reported at all.
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location ~ ^/(assets|fonts)/ {
        # Same carve-out as /wall/, and the reason this block was written in
        # the first place: an HTTP/2 page load multiplexes many parallel asset
        # requests, and those must never compete with page renders for slots.
        # It was taken out of site_conc in September and left inheriting the
        # http-level cap, which is the half that was missed.
        limit_conn per_subnet 100;
        limit_conn_status 429;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache openipc_micro;
        proxy_cache_key $scheme$host$uri;
        proxy_cache_valid 200 7d;
        proxy_cache_lock on;
        proxy_ignore_headers Set-Cookie;
        proxy_hide_header Set-Cookie;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # Per-snapshot pages (/snapshots/<id>, /oneday, /camera, /download): the
    # 2026-09-03 flood iterates ids with a rotating locale param, so keying
    # the cache on the full request URI never hits. Key on the path alone --
    # one cached copy per id, whichever locale rendered first; during a flood
    # that trade is free. Held 5 minutes, and 404s are cached too so probing
    # dead ids costs Rails one render per id per 2 minutes, not one per hit.
    # A snapshot page carries the translated navbar, footer and copy like any
    # other unprefixed path, so it has the same hazard the Open Wall location
    # below documents -- for five minutes rather than sixty seconds. Vary is
    # honoured and a session-carrying request stays out of the cache for the
    # same reasons.
    #
    # Monitoring, kept out of the log.
    #
    # /up is config/routes.rb:11 -- a rack proc answering "ok", no controller,
    # no view, no database. The container healthcheck and openipc-deploy poll
    # it on the loopback and never come through here, so today this location
    # silences four requests. It exists for what comes next: it is the right
    # target for the mirrors' monitoring, which currently fetches the full
    # home page every three seconds, and pointing 27,600 requests a day at
    # /up would only move the noise from one line of the log to another.
    #
    # An exact location, so nothing else can fall into it. access_log off and
    # nothing more: the endpoint still answers, it just stops being counted
    # among the requests anybody reads the log to understand.
    location = /up {
        access_log off;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The retired numeric form, answered here rather than by Rails. A walk of
    # the id space is the whole reason the ids changed, and every probe it
    # makes is a distinct URL -- so proxying them would mean one render per id
    # per cache TTL, which is the cost this change exists to remove. nginx
    # answers 410 without a proxy_pass, a cache entry or a limit_conn slot.
    #
    # Safe against a real id because Snapshot.generate_public_id refuses an
    # all-digit token: anything numeric here is a row id and nothing else, and
    # a token cannot reach the boundary character -- it always has a letter
    # before it.
    #
    # The boundary takes a dot as well as a slash. Without it /snapshots/1.json
    # falls past this location, matches the hexadecimal one below by its
    # numeric prefix, and is proxied: Rails answers 410 in the end, but the
    # probe has already cost a render slot under the concurrency cap, and a
    # 410 is not in proxy_cache_valid so the next probe costs another.
    # The gallery's older address, retired for readers (#165). See
    # conf.d/openipc-wall-shell.conf for the two maps, and for why only a read
    # is redirected: POST here is a camera uploading a frame.
    location ~ "^/(?:(?:ru|zh)/)?snapshots$" {
        if ($snapshots_alias_read) {
            return 301 $snapshots_alias_read;
        }

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The upload limit, which is the origin's and is what a camera POSTs
        # against.
        client_max_body_size 1m;

        add_header Strict-Transport-Security max-age=15768000;
    }

    # --- The Open Wall is files now (#165) ---------------------------------
    #
    # Five addresses, one shell per locale. `/open-wall` is a page of its own
    # in the bundle; every other wall address -- a page of the gallery, a
    # camera permalink, a snapshot, its archive, its slideshow -- carries an id
    # that changes by the hour and cannot be a file, so nginx serves them all
    # from `_shell/wall/index.html` and the island reads the address to learn
    # what it is. `$wall_shell` is the per-locale path; see
    # conf.d/openipc-wall-shell.conf.
    #
    # Ahead of the Rails wall locations below and stricter than any of them: an
    # id that is not twenty hex characters, a numeric one, and anything ending
    # .jpg all fall past these to the answers they already had.
    #
    # Both patterns are QUOTED. `{20}` is a repetition count to a regex and the
    # start of a block to nginx's parser, which truncates the pattern at the
    # brace and fails with "missing closing parenthesis" pointing at a regex
    # that plainly has one.
    #
    # `try_files ... @rails` is what makes a rollback safe. Roll the bundle
    # back and the file is gone, the request falls through, and Rails renders
    # the page it has always rendered -- which is why the caps below are here
    # rather than only in the Rails locations: on that day these addresses are
    # Rails' again and the September floods are what the caps are for.
    location ~ "^/(?:(?:ru|zh)/)?open-wall/?$" {
        if ($openipc_gallery_crawler) {
            return 403;
        }

        limit_conn media_conc 12;
        limit_conn_status 429;
        limit_req zone=snapshot_pages burst=48 nodelay;
        limit_req_status 429;

        root /srv/www/static/prod/current;
        try_files $wall_gallery_read @rails;

        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By static always;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location ~ "^/(?:(?:ru|zh)/)?open-wall/(?:[0-9]+|camera/[0-9a-f]{16})$" {
        if ($openipc_gallery_crawler) {
            return 403;
        }

        limit_conn media_conc 12;
        limit_conn_status 429;
        limit_req zone=snapshot_pages burst=48 nodelay;
        limit_req_status 429;

        root /srv/www/static/prod/current;
        try_files $wall_shell_read @rails;

        # add_header at location level replaces the whole inherited set.
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By static always;
        # A shell is one file serving many addresses, and it changes on every
        # deploy. Revalidate rather than cache: a conditional request and a 304
        # off nginx's Last-Modified, which is what the bundle's pages do.
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location ~ "^/(?:(?:ru|zh)/)?snapshots/[0-9a-f]{20}(?:/(?:archive|oneday|slideshow))?$" {
        if ($openipc_gallery_crawler) {
            return 403;
        }

        limit_conn media_conc 12;
        limit_conn_status 429;
        limit_req zone=snapshot_pages burst=48 nodelay;
        limit_req_status 429;

        root /srv/www/static/prod/current;
        try_files $wall_shell_read @rails;

        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By static always;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
        # Asked for by #165 and true of the content rather than of the file: a
        # snapshot lives two days, and 3,210 pages that die within 48 hours are
        # crawl budget spent on nothing. The gallery above carries no such
        # header and stays indexable.
        add_header X-Robots-Tag noindex always;
    }

    location ~ ^/(?:(?:ru|zh)/)?snapshots/[0-9]+(?:[./]|$) {
        return 410;
    }

    # The three addresses that used to hand over image bytes, answered here
    # rather than by Rails, for the same reason the numeric form above is.
    #
    # `download` returned the ORIGINAL upload -- full resolution, EXIF
    # unstripped. In the 24 hours to 2026-09-23 it was asked for 18,007 times
    # and served 5,825 of them: 1,182 MB, covering 2,341 of the 2,820 snapshots
    # that existed, which is 83% of every frame on the wall. 7,296 of those
    # requests carried the Azure fleet's user agent, and 14 of the 10,630
    # requesting addresses had ever executed the page beacon.
    #
    # Rails no longer routes any of them, so without this they fall to the
    # catch-all and cost a 302 through Ruby -- eighteen thousand of those a day
    # to answer a question whose answer is "no". 410 says gone rather than
    # moved, which is the honest status and the one a crawler is supposed to
    # stop retrying. Ahead of the hexadecimal location below, because nginx
    # takes the first matching regex.
    location ~ ^/(?:(?:ru|zh)/)?snapshots/[^/]+/download {
        return 410;
    }

    location ~ ^/(?:(?:ru|zh)/)?snapshots/camera(?:[./]|$) {
        return 410;
    }

    location ~ ^/(?:(?:ru|zh)/)?open-wall/camera/[^/]+\.jpg$ {
        return 410;
    }

    # The id is twenty hex characters, not digits. It was `[0-9]+` until the
    # ids stopped being sequential, and that regex is load-bearing twice over:
    # everything this location carries -- the microcache and the concurrency
    # cap that ended the 2026-09-03 outage -- applies only to paths it matches.
    # A snapshot address it does not match falls through to the catch-all,
    # uncached and uncapped, which is the exact seam that took the site down
    # three times in September. Kept wide enough to match the numeric form too,
    # so that the 410 the app answers to a walk is also shed and cached here
    # rather than reaching Rails once per probe.
    location ~ ^/(?:(?:ru|zh)/)?snapshots/[0-9a-f]+ {
        # Not for training. See $openipc_gallery_crawler in
        # conf.d/openipc-crawler-block.conf; robots.txt disallows these paths
        # for everyone and this is the same rule, answered now rather than
        # whenever the crawler next reads that file.
        if ($openipc_gallery_crawler) {
            return 403;
        }

        limit_conn snapshot_conc 10;
        limit_conn_status 429;

        # Per address, where limit_conn above is per site. The two answer
        # different questions: the pool bounds how many renders run at once,
        # this bounds how fast one client may walk the id space. See
        # conf.d/openipc-snapshot-rate.conf for where 60r/m and burst 48 come
        # from -- burst alone clears the busiest real reader ever measured.
        limit_req zone=snapshot_pages burst=48 nodelay;
        limit_req_status 429;

        proxy_buffer_size 128k;
        proxy_buffers 8 128k;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;

        proxy_cache openipc_micro;
        proxy_cache_key $scheme$host|$locale_key|$uri;
        proxy_cache_valid 200 301 302 300s;
        proxy_cache_valid 404 120s;
        proxy_cache_lock on;
        proxy_cache_lock_age 30s;
        proxy_cache_lock_timeout 30s;
        proxy_cache_use_stale updating error timeout;

        # Do not serve a cached copy to anyone carrying a session. Since #155
        # that is a much smaller group than it was -- public pages set no
        # cookie at all now -- so this costs almost nothing, and what it buys
        # is that a signed-in admin reaches Rails and sees the uploader
        # details and moderation controls rather than an anonymous copy
        # somebody else's request put in the cache.
        #
        # #204 added this because session[:locale] could change the render.
        # That reason went with #155; this one replaces it. Storing is handled
        # separately: proxy_no_cache below for the admin render, and nothing
        # in proxy_ignore_headers, so a response that sets a cookie is not
        # stored either way.
        proxy_cache_bypass $cookie__openipc_session;
        proxy_hide_header Set-Cookie;
        # Never store a response Rails rendered for a signed-in admin: this page
        # shows the uploader's IP and MAC to admins, and the cache key is the
        # path alone, so a cached copy would go to everyone who asks for it. See
        # ApplicationController#refuse_shared_caching_for_admins. The admin is
        # not served an anonymous copy in return either -- proxy_cache_bypass
        # above sends anyone carrying a session to Rails, which since #155 is
        # essentially only admins.
        proxy_no_cache $upstream_http_x_admin_view;
        proxy_hide_header X-Admin-View;

        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # /wall/ is gone, and so is every other address that returned a frame.
    #
    # #146 put the Open Wall's four variants here as plain files, and it was
    # right about what it fixed: ActiveStorage's redirect mode was 293,785
    # requests on 2026-09-18, 62% of everything served and 18,041 of that day's
    # 21,291 429s. What it could not fix is that a file nginx hands to anyone
    # who asks has no session behind it, so there is no way to say "this client
    # has taken five hundred frames". Four rounds of hardening failed on
    # exactly that: opaque ids (#235), a JavaScript gate (#261), an address
    # block (#262), a rate limit. Each made the frames dearer; none made them
    # absent.
    #
    # Frames now leave over a WebSocket, which is a session that can be counted
    # and refused -- see app/channels/wall_channel.rb. The files moved out of
    # public/ at the same time, because RAILS_SERVE_STATIC_FILES=1 meant Rails
    # served this path itself whatever was written here.
    #
    # 410, not 404: these addresses existed for a month and are in caches and
    # crawl frontiers. Answered here so the 13,725 daily requests that will
    # keep arriving cost nothing.
    location ^~ /wall/ {
        return 410;
    }
    # The wall as data: the home page's mosaic, and the four addresses the
    # gallery's own pages are moving onto (#165).
    #
    # The prerendered home pages -- /ru and /zh -- are files, so nothing renders
    # them a WallGrant the way WallHelper renders one into `/`. They showed five
    # "no signal" tiles while the same page in the same language showed live
    # cameras at `/`, and the only way to reach the broken one was to click your
    # own language.
    #
    # This location is every wall address EXCEPT the socket, which has its own
    # longer prefix below and wins on length whatever the order here. The split
    # is the whole point: the socket's block forbids caching and sets an hour's
    # timeout, which is right for a connection and wrong for a document, and
    # #165's four JSON addresses would otherwise have inherited it -- reaching
    # Rails on every request and minting a grant each time, outside the rate
    # limit every wall page has. Found by review on #281.
    #
    # burst 48 and not the 8 this carried when it was the mosaic alone: these
    # addresses ARE the gallery pages now, one fetch per page view, and 48 is
    # the number conf.d/openipc-snapshot-rate.conf derives from the busiest
    # real reader ever measured. A smaller burst here would refuse readers the
    # pages they replace serve today.
    #
    # Microcached for a minute on the same key the pages use. One body serves
    # every reader, which is what WallGrant's cache-window bucketing exists for:
    # the same ids in the same five minutes sign to the same bytes, so a cached
    # response carries a grant that is still valid when it is served.
    location ^~ /api/v1/wall/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The wall's own per-address budget, shared with the gallery pages,
        # because a reader who loads a wall page and a reader who fetches its
        # data are the same reader. The cache absorbs the rest, except for a
        # request carrying a session cookie -- which anybody can send, and
        # which bypasses it.
        limit_req zone=snapshot_pages burst=48 nodelay;
        limit_req_status 429;

        proxy_cache openipc_micro;
        # $locale_key even though this body carries no language: the ids, the
        # grant and the SoC names read the same in every one. The rule it obeys
        # is the one that exists because ignoring Vary served the Russian Open
        # Wall to English visitors for a minute at a time, and three entries
        # holding identical bytes is a cheaper thing to keep than an exemption
        # somebody has to re-derive.
        proxy_cache_key $scheme$host|$locale_key|$uri;
        proxy_cache_valid 200 60s;
        proxy_cache_lock on;
        # An admin reaches Rails, as everywhere else that is cached. Nothing on
        # this response differs for one today; the bypass costs almost nothing
        # since #155 and is what stops that being a decision made per location.
        proxy_cache_bypass $cookie__openipc_session;

        # HSTS is repeated because add_header at location level replaces the
        # whole inherited set. Cache-Control and Access-Control-Allow-Origin
        # are NOT repeated: they come from Rails, pass through this proxy, and
        # are replayed from the cache with the rest of the response. Adding
        # them here too sent each one twice, and the second of them is the
        # drift ApplicationController::FRESHNESS exists to prevent -- nginx
        # deciding a lifetime the application already declared.
        add_header Strict-Transport-Security max-age=15768000;
    }


    # The frame channel. A WebSocket, so everything about this location is
    # different from the rest of the file.
    #
    # Under /api/ deliberately: #142 has the mirrors proxying only /api/,
    # /wall/i/ and /dl/firmware/ to the origin, and deploy/static/reserved-paths
    # already reserves the prefix so the static bundle cannot shadow it.
    #
    # Its own limit_conn zone, and this is the trap worth naming. site_conc,
    # snapshot_conc and media_conc are all keyed on $server_name -- ONE global
    # pool each, sized so the three together sum to Puma's 32 threads. A
    # long-lived socket holds its slot for the whole connection, so ten readers
    # on a $server_name-keyed pool would 429 the entire site. Keyed per address
    # instead.
    #
    # The first version of this said "nothing legitimate needs four" and set the
    # limit there. Production disagreed within two hours: a socket here lives up
    # to proxy_read_timeout (1h), so a slot is held for as long as a tab is
    # open, not for as long as a request takes. One reader with four tabs on the
    # wall consumed the whole pool and then 429'd their own reconnects -- 173
    # refusals from a single address, steady at three a minute, until a tab
    # closed. Behind NAT or CGNAT the same arithmetic locks out four separate
    # people.
    #
    # This pool is NOT what stops bulk collection; WallChannel's per-address
    # frame budget is, and that budget is keyed on the address too, so opening
    # more sockets buys a harvester no extra frames. All this limit has to do is
    # bound nginx's own connection slots (a proxied socket costs two), so it can
    # be generous.
    location ^~ /api/v1/wall/cable {
        limit_conn wall_sockets 16;
        limit_conn_status 429;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Buffering would hold frames until the buffer filled, which for a
        # socket means holding them until the connection closed.
        proxy_buffering off;

        # The default proxy_read_timeout of 180s elsewhere in this file would
        # drop an idle socket after three minutes -- a reader who leaves the
        # wall open loses their frames and gets no error. ActionCable pings on
        # its own; this is the ceiling above that.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        # A socket must never enter the microcache. It is not a document and
        # there is nothing to replay.
        proxy_no_cache 1;
        proxy_cache_bypass 1;

        add_header Strict-Transport-Security max-age=15768000;
    }

    # Open Wall pages. The ActiveStorage image URLs these used to embed are
    # gone -- nothing renders one, and /rails/active_storage/* answers 410 --
    # but the prefix stays in the regex so an old link still lands somewhere
    # rate limited rather than in the catch-all.
    # the 2026-08-30 flood hammers. Cached 60s for everyone; these pages are
    # identical for all anonymous visitors. Set-Cookie is stripped so one
    # visitor's session can never be handed to another from the cache; no
    # form on these pages needs a session. POST /snapshots (camera uploads)
    # matches this location too but proxy_cache only ever caches GET/HEAD.
    location ~ ^/(?:(?:ru|zh)/)?(open-wall|snapshots|rails/active_storage) {
        # Not for training. See $openipc_gallery_crawler in
        # conf.d/openipc-crawler-block.conf; robots.txt disallows these paths
        # for everyone and this is the same rule, answered now rather than
        # whenever the crawler next reads that file.
        if ($openipc_gallery_crawler) {
            return 403;
        }

        limit_conn media_conc 12;
        limit_conn_status 429;
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;

        proxy_cache openipc_micro;
        proxy_cache_key $scheme$host$request_uri;
        proxy_cache_valid 200 301 302 60s;
        proxy_cache_lock on;
        proxy_cache_lock_age 30s;
        proxy_cache_lock_timeout 30s;
        proxy_cache_use_stale updating error timeout;

        # Do not serve a cached copy to anyone carrying a session. Since #155
        # that is a much smaller group than it was -- public pages set no
        # cookie at all now -- so this costs almost nothing, and what it buys
        # is that a signed-in admin reaches Rails and sees the uploader
        # details and moderation controls rather than an anonymous copy
        # somebody else's request put in the cache.
        #
        # #204 added this because session[:locale] could change the render.
        # That reason went with #155; this one replaces it. Storing is handled
        # separately: proxy_no_cache below for the admin render, and nothing
        # in proxy_ignore_headers, so a response that sets a cookie is not
        # stored either way.
        proxy_cache_bypass $cookie__openipc_session;
        proxy_hide_header Set-Cookie;
        # As above: /open-wall/camera/<id> reaches the same template, so an
        # admin's rendering of it must not be stored either.
        proxy_no_cache $upstream_http_x_admin_view;
        proxy_hide_header X-Admin-View;

        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # The seam between a static bundle and Rails (#157). A page is extracted
    # when its index.html exists under the root below -- nothing else: no
    # nginx edit per page, no header, no feature flag. Rollback is deleting
    # that file, or repointing `current` at the previous bundle.
    #
    # The fallback direction is the property worth protecting, and try_files
    # enforces it rather than convention doing so: every element that misses
    # continues to the next, and the last element is a named location, so this
    # block cannot answer 404 or 403 of its own. Only Rails can. A missing
    # /ru/donate/index.html falls through and Rails renders Russian from the
    # YAML -- a partial locale build degrades to the working old site, never
    # to the wrong language.
    #
    # NOT `try_files $uri $uri/ @rails`. try_files decides file-test versus
    # directory-test from the literal element at parse time, so only an element
    # written with a trailing slash tests for a directory -- and a directory
    # that matches is handed to the index module, which answers "directory
    # index of ... is forbidden" when there is no index.html in it. With an
    # empty bundle the directory that always exists is the bundle root, so that
    # form answers 403 for the front page. Measured on nginx 1.26.3, empty
    # bundle:
    #
    #            $uri $uri/index.html   $uri $uri/
    #   /        rails 200              403
    #   /ru/     rails 200              403
    #
    # `index` would be dead configuration here for the same reason -- the index
    # module can only run once a directory element has matched -- and is
    # deliberately absent.
    #
    # A file cannot Vary. Rails declares `Vary: Accept-Language` on every
    # unprefixed page and the microcache honours it; a bundle file serves one
    # language to everyone. That is why #154 had to land first: the bare path
    # is English by decision now, so a page in the bundle carries its language
    # in its path. It is also why deploy/static/check-bundle.sh refuses a root
    # index.html -- what `/` means is #160's decision, not a build product.
    # The bundle's own hashed assets (#159). Astro fingerprints every file it
    # writes under /_astro/, so the name changes whenever the bytes do and the
    # old name is never reused -- which is exactly the condition `immutable`
    # asks for. Without this they inherited no Cache-Control at all and every
    # visit re-fetched or revalidated the stylesheet, the island and four
    # woff2 faces.
    #
    # ^~ so it wins over the regex locations below it, and so these never take
    # a site_conc slot: an HTTP/2 page load opens several of them in parallel
    # and they must not compete with page renders, which is the same reasoning
    # the /assets|fonts/ block above was written on.
    #
    # try_files still ends at @rails rather than =404. A rollback can leave a
    # page referencing an asset the older bundle does not carry, and the seam's
    # rule is that only Rails answers 404 -- so that miss shows up in the Rails
    # log like every other one, instead of vanishing into nginx.
    location ^~ /_astro/ {
        limit_conn per_subnet 100;
        limit_conn_status 429;

        root /srv/www/static/prod/current;
        try_files $uri @rails;

        # add_header in a location REPLACES every inherited one, so HSTS is
        # repeated here exactly as it is in the seam below.
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By static always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        # The cap has to be here and cannot be in @rails, and that is a fact
        # about phase order rather than a preference. limit_conn runs in the
        # preaccess phase and try_files in precontent, so the configuration
        # that counts is whichever location the request landed in FIRST --
        # this one -- and ngx_http_limit_conn_handler returns early on every
        # pass after it. Measured on nginx 1.26.3 with the cap set to 1 and
        # four concurrent slow transfers:
        #
        #   cap in `location /`   429 429 429 200   binds
        #   cap in `@rails`       200 200 200 200   never runs
        #   cap in both           429 429 429 200   the @rails copy is dead
        #
        # The middle row is why this matters: @rails alone looks correct, and
        # would silently replace the site_conc pool that ended the 2026-09-03
        # outage with the http-level per-address twenty this location would
        # otherwise inherit.
        #
        # The cost of that ordering, stated so it is owned: a request answered
        # from the bundle also takes a site_conc slot, because nginx decides
        # admission before it knows which side will answer. Identical to today
        # while the bundle holds one page nobody links to. It is the number to
        # revisit when it holds the marketing set.
        limit_conn site_conc 10;
        limit_conn_status 429;

        root /srv/www/static/prod/current;
        try_files $uri $uri/index.html @rails;

        # `add_header` in a location REPLACES every inherited one, so the
        # server-level HSTS has to be repeated here exactly as it is in @rails
        # below -- otherwise every page the bundle serves loses it.
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By static always;
        # Pages, unlike the assets above, keep their address when their content
        # changes -- a deploy rewrites /donate/index.html in place. So they may
        # be cached but never used without asking: max-age=0 with
        # must-revalidate means a conditional request and, almost always, a
        # 304 off nginx's Last-Modified. Nothing here should ever serve the
        # previous release's wording after a rollback.
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    # Everything the bundle does not hold, which today is everything. This is
    # the block that was `location /` until #157; it is unchanged apart from
    # the proxy_pass URI part and the X-Served-By witness.
    location @rails {
        # No limit_conn here. See `location /` above: it would never execute.
        proxy_buffer_size 128k;

        # Increase the number and size of additional buffers for the response body
        # This example allocates 8 buffers, each 128 KB
        proxy_buffers 8 128k;

        # No URI part. nginx refuses one inside a named location, and none is
        # needed: with an empty URI part the request line sent upstream is
        # $request_uri when the URI is simple, and the same normalised, escaped
        # path as before when it is not. Rails receives what it received when
        # this was `location /`.
        proxy_pass http://127.0.0.1:3000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;

        # The pages themselves (#233).
        #
        # On 2026-09-20 the front page took 62,588 requests and every one was
        # cache=- : not one served by nginx, every one a Rails render, for
        # 1,787 distinct clients. Assets hit 89%, the snapshots and the Open
        # Wall are cached, and the largest class on the site was the one class
        # that was not. 25,525 of those arrived from openipc.kz, openipc.ru and
        # openipc.eu, which proxy without caching -- so caching here is what
        # stops a mirror visitor costing a render, without touching three
        # configs this repository does not own.
        #
        # Rails has been asking for this for days. Since #155 a GET on / comes
        # back `public, max-age=300, stale-while-revalidate=3600`, and a
        # catalogue page `max-age=3600, stale-while-revalidate=86400`, and
        # nothing was listening.
        proxy_cache openipc_micro;

        # The whole URI, query included. Only 444 of 63,032 front-page requests
        # carry one, so there is nothing to gain by dropping it -- and dropping
        # it is what produced the bug the microcache conf documents at length,
        # where a key that ignored ?locale= served Russian to English readers.
        #
        # Unchanged by the seam: $request_uri is the original request line and
        # an internal redirect to a named location does not rewrite it, so the
        # keys are the strings they were and the entries already on disk stay
        # warm across the reload.
        proxy_cache_key $scheme$host$request_uri;

        # No proxy_cache_valid, deliberately. Rails decides what may be cached
        # and for how long, and it is the only thing that can: it knows about
        # the flash, the signed-in admin and the CSRF token. A page it declares
        # `max-age=0, private` -- /admin, anything with a flash, any non-200 --
        # nginx will not store, and a proxy_cache_valid here would be a second
        # opinion that silently overrides the first on exactly those pages.
        #
        # For the same reason there is no `proxy_hide_header Set-Cookie`, which
        # every other cached location has. Those serve pages that never need a
        # cookie; this one serves /admin and Devise, which must be able to set
        # a session. nginx already refuses to store a response carrying
        # Set-Cookie, which is the right answer rather than one to suppress.
        proxy_cache_lock on;
        proxy_cache_lock_age 30s;
        proxy_cache_lock_timeout 30s;
        proxy_cache_use_stale updating error timeout;

        # An admin reaches Rails rather than an anonymous copy, and an admin's
        # render is never stored for anyone else. Same pair as the locations
        # above; see ApplicationController#refuse_shared_caching_for_admins.
        proxy_cache_bypass $cookie__openipc_session;
        proxy_no_cache $upstream_http_x_admin_view;
        proxy_hide_header X-Admin-View;

        # `add_header` in a location REPLACES every inherited one, so the
        # server-level HSTS has to be repeated here or adding X-Cache-Status
        # would quietly remove it. Rails sends a stronger HSTS of its own on
        # every page, so the loss would not have shown up in a browser -- which
        # is exactly why it is worth being explicit about.
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Cache-Status $upstream_cache_status;
        add_header X-Served-By rails always;
    }

}
