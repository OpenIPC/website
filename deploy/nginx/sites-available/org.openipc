
server {
    listen 80;
    server_name openipc.org;
    #
    access_log /var/log/nginx/org.openipc.access.log openipc;
    error_log /var/log/nginx/org.openipc.error.log info;

    # limit_conn perip 10;

    location ^~ /.well-known/acme-challenge {
        proxy_redirect off;
        default_type "text/plain";
        alias   /var/lib/dehydrated/acme-challenges;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}


server {
    listen 443 ssl http2;
    server_name openipc.org;
    #
    access_log /var/log/nginx/org.openipc.access.log openipc;
    error_log /var/log/nginx/org.openipc.error.log info;
    #
    ssl_certificate /var/lib/dehydrated/certs/openipc.org/fullchain.pem;
    ssl_certificate_key /var/lib/dehydrated/certs/openipc.org/privkey.pem;
    #
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_stapling off;
    ssl_stapling_verify on;
    ssl_session_tickets off;
    add_header Strict-Transport-Security max-age=15768000;
    resolver 1.1.1.1;

    # Declared crawlers that ignore robots.txt get the explicit version.
    if ($openipc_blocked_crawler) {
        return 403;
    }

    location /dl/ {
        alias /srv/www/shared/dl/;
        allow all;
    }

    # Assembled firmware images. Rails decides who may have one and names the
    # file; nginx sends the bytes, so a slow client holds an nginx connection
    # instead of one of Puma's sixteen threads.
    #
    # `internal` means this is reachable only through X-Accel-Redirect, never by
    # asking for it. The browsable listing that used to be at /files/ goes with
    # it: images are reached through the download action, which is what applies
    # the flash-size and edition rules.
    # Nothing serves /files/ any more. Without this the request falls through to
    # the app, which serves public/ itself (RAILS_SERVE_STATIC_FILES=1), so every
    # image would still be fetchable by name -- straight through a Puma thread,
    # which is the cost handing them to nginx above exists to avoid.
    location /files/ {
        return 404;
    }

    # The optional (ru|zh)/ prefix on this and the two cache locations below is
    # not decoration. These regexes are anchored at ^/ and every rule they carry
    # -- the firmware rate limit here, the microcache and the concurrency caps
    # further down -- simply stops applying to a path that does not match. #154
    # localized /open-wall and that alone already opened the gap: /open-wall was
    # microcached and capped, /ru/open-wall was neither. Localizing the rest of
    # the catalogue without this would turn the firmware limit into a formality,
    # since /ru/cameras/.../download_full_image would be the same expensive
    # action with no limit_req in front of it. The list must stay in step with
    # Multilang::IN_PATH; a test asserts it does.
    #
    # Only the action that produces a firmware image. NOT `location /`:
    # proxy_set_header applies to everything a location serves, and
    # Rack::Sendfile acts on any response whose body responds to to_path --
    # which with RAILS_SERVE_STATIC_FILES=1 is every file under public/assets.
    # Setting these globally answered every stylesheet with an X-Accel-Redirect
    # to a path nginx has no location for, and took both sites down to unstyled
    # text on 2026-08-24.
    #
    # No URI part on proxy_pass: nginx forbids one in a regex location, and the
    # full original URI is what should reach the app anyway.
    location ~ ^/(?:(?:ru|zh)/)?cameras/vendors/[^/]+/socs/[^/]+/download_full_image {
        limit_conn site_conc 10;
        limit_conn_status 429;

        # Per address, where site_conc above is keyed on $server_name -- one
        # global pool of ten that a single client can take all of. See
        # conf.d/openipc-firmware-rate.conf for where the numbers come from.
        #
        # The bursts are what make them safe. Measured on dev with these exact
        # directives: nine plain requests go through back to back and the tenth
        # is shed; fifteen range requests in a row are not counted by fw_start
        # at all; and a client that sets a Range header to get round it gets
        # thirty-two through before fw_all sheds it. Real traffic's worst
        # minute in fifteen days was four plain requests, or thirty ranges of
        # one file.
        limit_req zone=fw_start burst=8 nodelay;
        limit_req zone=fw_all burst=30 nodelay;
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-Sendfile-Type X-Accel-Redirect;
        proxy_set_header X-Accel-Mapping /rails/public/files/=/protected-files/;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;
    }

    location /protected-files/ {
        internal;
        alias /srv/www/shared/files/;
    }

    # config/routes.rb redirects this one to the CDN, and the /images/ alias
    # below would otherwise swallow it: the file is not in that directory, so
    # nginx answered 404 where the app meant to redirect. An exact-match
    # location outranks a prefix one, so this reaches the app.
    location = /images/logo_openipc.png {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Four badges and logos from 2022-2023, embedded on pages this project does
    # not control. Nothing on this site references them. Kept in the repository
    # under deploy/legacy-images and installed here by deploy.sh, because this
    # directory is host-only and in no backup.
    location /images/ {
        alias /srv/www/shared/images/;
    }

    # Fingerprinted static assets and fonts, served by Rails but cached here
    # long-term (names change when content does). Deliberately outside the
    # site_conc cap: an HTTP/2 page load multiplexes many parallel asset
    # requests, and those must never compete with page renders for slots.
    # Analytics beacon (#181). GoatCounter runs on the loopback and these are
    # the only two paths of it the public site exposes.
    #
    # Two exact locations, deliberately not `location /api/a/`. GoatCounter is a
    # whole application behind this port -- dashboard, login, site settings, CSV
    # export -- and a prefix match would publish all of it under the site's own
    # name, where it would inherit the site's certificate and look like part of
    # openipc.org. The dashboard has a vhost of its own for that reason.
    #
    # Host is rewritten because GoatCounter picks the site from it, and these
    # requests arrive as openipc.org, openipc.ru, openipc.kz or openipc.eu.
    # Without this the four mirrors would each need a site of their own, or
    # three quarters of the traffic would be dropped as unknown.
    location = /api/a/c.js {
        proxy_pass http://127.0.0.1:8081/count.js;
        proxy_set_header Host analytics.openipc.org;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/a/count {
        # A plain GET with a query string: anything that can read the page can
        # replay it, without running any JavaScript. GoatCounter has a limit of
        # its own (4/s per address) and this one sits deliberately above it --
        # see conf.d/openipc-beacon-rate.conf. This keeps a flood off the Go
        # process; that keeps the numbers honest.
        limit_req zone=beacon burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8081/count;
        proxy_set_header Host analytics.openipc.org;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Never cached. A cached count is a count that happened once and was
        # then reported as many, or not reported at all.
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location ~ ^/(assets|fonts)/ {
        # Same carve-out as /wall/, and the reason this block was written in
        # the first place: an HTTP/2 page load multiplexes many parallel asset
        # requests, and those must never compete with page renders for slots.
        # It was taken out of site_conc in September and left inheriting the
        # http-level cap, which is the half that was missed.
        limit_conn per_subnet 100;
        limit_conn_status 429;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache openipc_micro;
        proxy_cache_key $scheme$host$uri;
        proxy_cache_valid 200 7d;
        proxy_cache_lock on;
        proxy_ignore_headers Set-Cookie;
        proxy_hide_header Set-Cookie;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # Per-snapshot pages (/snapshots/<id>, /oneday, /camera, /download): the
    # 2026-09-03 flood iterates ids with a rotating locale param, so keying
    # the cache on the full request URI never hits. Key on the path alone --
    # one cached copy per id, whichever locale rendered first; during a flood
    # that trade is free. Held 5 minutes, and 404s are cached too so probing
    # dead ids costs Rails one render per id per 2 minutes, not one per hit.
    # A snapshot page carries the translated navbar, footer and copy like any
    # other unprefixed path, so it has the same hazard the Open Wall location
    # below documents -- for five minutes rather than sixty seconds. Vary is
    # honoured and a session-carrying request stays out of the cache for the
    # same reasons.
    location ~ ^/(?:(?:ru|zh)/)?snapshots/[0-9]+ {
        limit_conn snapshot_conc 10;
        limit_conn_status 429;
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;

        proxy_cache openipc_micro;
        proxy_cache_key $scheme$host|$locale_key|$uri;
        proxy_cache_valid 200 301 302 300s;
        proxy_cache_valid 404 120s;
        proxy_cache_lock on;
        proxy_cache_lock_age 30s;
        proxy_cache_lock_timeout 30s;
        proxy_cache_use_stale updating error timeout;
        proxy_hide_header Set-Cookie;
        # Never store a response Rails rendered for a signed-in admin: this page
        # shows the uploader's IP and MAC to admins, and the cache key is the
        # path alone, so a cached copy would go to everyone who asks for it. See
        # ApplicationController#refuse_shared_caching_for_admins. An admin may
        # in return be served an anonymous copy already in the cache, for up to
        # the TTL above; reaching the controls then means waiting it out.
        proxy_no_cache $upstream_http_x_admin_view;
        proxy_hide_header X-Admin-View;

        add_header X-Cache-Status $upstream_cache_status;
    }

    # The Open Wall's images, as plain files (2026-09, issue #146).
    #
    # These were 293,785 requests on 2026-09-18 -- 62% of everything the site
    # served, and 18,041 of the day's 21,291 429s -- because ActiveStorage's
    # redirect mode answers each one with a 302 to a URL signed with a five
    # minute expiry. Two Rails requests per image, both private, neither
    # cacheable by anything. Almost none of it is people: 22,504 addresses
    # presenting a handful of spoofed mobile user agents.
    #
    # ProcessImagesJob now writes the four variants here as ordinary files, so
    # nginx answers without waking Ruby. immutable is honest: a snapshot's
    # image never changes, and the id is in the path.
    #
    # No limit_conn. These are sendfile of a small JPEG already in page cache,
    # which is the whole point -- capping them would only reintroduce the
    # queueing this removes.
    # alias and no try_files. Combining the two is a long-standing nginx trap
    # that resolves the path twice; alias on its own already answers 404 for a
    # file that is not there, which is the honest answer here -- a snapshot
    # whose job has not run is never linked to this path at all, because the
    # view falls back to ActiveStorage until the column is set.
    location ^~ /wall/ {
        alias /srv/www/shared/wall/;
        add_header Cache-Control "public, max-age=31536000, immutable";

        # Declaring any limit_conn here REPLACES the http-level `limit_conn
        # per_subnet 20` this would otherwise inherit -- which is per address,
        # not per subnet, and which concurrent HTTP/2 streams each consume a
        # slot of. Sixteen thumbnails plus stylesheets, fonts and a favicon put
        # a cold first visit near that twenty, so the page could shed its own
        # images. These are sendfile of a small JPEG already in page cache and
        # never reach Rails, so they have no business competing for slots that
        # exist to bound concurrent renders. High enough not to bind on any
        # real page, low enough to stay a bound.
        limit_conn per_subnet 100;
        limit_conn_status 429;
    }

    # Open Wall pages and the ActiveStorage image URLs they embed: the paths
    # the 2026-08-30 flood hammers. Cached 60s for everyone; these pages are
    # identical for all anonymous visitors. Set-Cookie is stripped so one
    # visitor's session can never be handed to another from the cache; no
    # form on these pages needs a session. POST /snapshots (camera uploads)
    # matches this location too but proxy_cache only ever caches GET/HEAD.
    location ~ ^/(?:(?:ru|zh)/)?(open-wall|snapshots|rails/active_storage) {
        limit_conn media_conc 12;
        limit_conn_status 429;
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;

        proxy_cache openipc_micro;
        proxy_cache_key $scheme$host$request_uri;
        proxy_cache_valid 200 301 302 60s;
        proxy_cache_lock on;
        proxy_cache_lock_age 30s;
        proxy_cache_lock_timeout 30s;
        proxy_cache_use_stale updating error timeout;
        proxy_hide_header Set-Cookie;
        # As above: /open-wall/camera/<id> reaches the same template, so an
        # admin's rendering of it must not be stored either.
        proxy_no_cache $upstream_http_x_admin_view;
        proxy_hide_header X-Admin-View;

        add_header X-Cache-Status $upstream_cache_status;
    }

    location / {
        limit_conn site_conc 10;
        limit_conn_status 429;
        # Increase the size of the main buffer for the response header/start
        proxy_buffer_size 128k;

        # Increase the number and size of additional buffers for the response body
        # This example allocates 8 buffers, each 128 KB
        proxy_buffers 8 128k;

        proxy_pass http://127.0.0.1:3000/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;
    }

}
