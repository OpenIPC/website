# The GoatCounter dashboard (#181).
#
# The counting endpoints are NOT here: they are two exact locations on the
# public vhosts, /api/a/c.js and /api/a/count, so a visitor's browser never
# contacts a second hostname and the beacon keeps working through the mirrors.
# This vhost exists only so a person can read the numbers.
#
# It publishes an application that was previously reachable only over an SSH
# tunnel, so what guards it is GoatCounter's own login -- which is the decision
# #181 took. GoatCounter rate-limits that login to 20 attempts a minute per
# address by default; the zone below is the cheaper outer gate, and the two
# counting paths are deliberately absent from this server block so a flood
# aimed at the dashboard cannot reach them through it.
server {
    listen 80;
    server_name analytics.openipc.org;
    #
    access_log /var/log/nginx/org.openipc.analytics.access.log openipc;
    error_log /var/log/nginx/org.openipc.analytics.error.log info;
    #
    # Stays ahead of everything below: dehydrated renews this certificate over
    # HTTP-01 on port 80, and `^~` beats the regex locations as well as the
    # prefix one. A redirect here would fail every renewal.
    location ^~ /.well-known/acme-challenge {
        proxy_redirect off;
        default_type "text/plain";
        alias   /var/lib/dehydrated/acme-challenges;
        allow all;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}


server {
    listen 443 ssl http2;
    server_name analytics.openipc.org;
    #
    access_log /var/log/nginx/org.openipc.analytics.access.log openipc;
    error_log /var/log/nginx/org.openipc.analytics.error.log info;
    #
    ssl_certificate /var/lib/dehydrated/certs/analytics.openipc.org/fullchain.pem;
    ssl_certificate_key /var/lib/dehydrated/certs/analytics.openipc.org/privkey.pem;
    #
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security max-age=15768000;

    # A dashboard, not a site: nothing here should ever be indexed, and it is
    # the one page on this host that names paths, referrers and countries.
    add_header X-Robots-Tag "noindex, nofollow" always;

    client_max_body_size 1m;

    # The account pages -- sign in, password reset, user settings -- get the
    # narrow column back.
    #
    # backend.css ships `.page, .center { max-width: calc((1em*2) + (86mm*4) + 10mm) }`,
    # which is the dashboard sized to fit four 86mm chart columns and is right
    # there. It applies to every page though, so the sign-in form sits against
    # the left edge of a 1370px box with the heading centred above it, which
    # reads as a broken page rather than a deliberate one. Upstream CSS, not
    # anything this deployment does.
    #
    # Scoped to /user/ so the dashboard keeps the width it needs. Accept-Encoding
    # is cleared because sub_filter cannot rewrite a gzipped body; that costs a
    # little bandwidth on the handful of pages a maintainer signs in through.
    location ^~ /user/ {
        limit_req zone=dashboard burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";

        sub_filter_types text/html;
        sub_filter_once on;
        sub_filter '</head>' '<style>.page,.center{max-width:54rem}</style></head>';
    }

    location / {
        limit_req zone=dashboard burst=20 nodelay;
        limit_req_status 429;
        limit_conn per_subnet 20;
        limit_conn_status 429;

        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CSV export of a year of data is not a fast request.
        proxy_read_timeout 300;
    }
}
