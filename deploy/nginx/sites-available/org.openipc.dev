
server {
    listen 80;
    server_name dev.openipc.org;
    #
    access_log /var/log/nginx/org.openipc.dev.access.log openipc;
    error_log /var/log/nginx/org.openipc.dev.error.log info;

    # limit_conn perip 10;

    #
    location ^~ /.well-known/acme-challenge {
        proxy_redirect off;
        default_type "text/plain";
        alias   /var/lib/dehydrated/acme-challenges;
        allow all;
    }
    # The same exception on port 80. A check that asks for http://.../up is
    # redirected here and logged here, so silencing /up only in the TLS server
    # leaves the line it was meant to remove -- written by the redirect rather
    # than by the app, which is harder to notice, not easier.
    location = /up {
        access_log off;
        return 301 https://$host$request_uri;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}


server {
    listen 443 ssl http2;
    server_name dev.openipc.org;
    #
    access_log /var/log/nginx/org.openipc.dev.access.log openipc;
    error_log /var/log/nginx/org.openipc.dev.error.log info;
    #
    ssl_certificate /var/lib/dehydrated/certs/dev.openipc.org/fullchain.pem;
    ssl_certificate_key /var/lib/dehydrated/certs/dev.openipc.org/privkey.pem;
    #
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_stapling off;
    ssl_stapling_verify on;
    ssl_session_tickets off;
    add_header Strict-Transport-Security max-age=15768000;
    resolver 1.1.1.1;

   # Real staging site: the dev container on :3001, not a mirror of production.
   auth_basic           "openipc.org staging";
   auth_basic_user_file /etc/nginx/.htpasswd-dev;

   add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

   # Nightly audience reports (#180). Here and never on org.openipc, because
   # they name the pages people read and the countries they read them from, and
   # the basic auth above is the only thing standing in front of them. Served
   # from disk: the report is a self-contained HTML file with no server behind
   # it, and autoindex is what makes yesterday's reachable without a link.
    # Monitoring, kept out of the log -- the same rule as the production
    # vhost, so a check pointed at dev does not read differently.
    location = /up {
        access_log off;

        proxy_pass http://127.0.0.1:3012;  # the Go web process (#304)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

   location /_reports/ {
       alias /srv/www/shared/reports/;
       autoindex on;
       autoindex_localtime on;
       # A report is written once and never changed; the directory listing is.
       # Repeated, not inherited: add_header at location level replaces the
       # whole set the server block sends, so a location that adds one of its
       # own drops HSTS from everything it serves unless it says so again.
       add_header Strict-Transport-Security max-age=15768000;
       add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
       add_header Cache-Control "no-cache" always;
   }

    # Analytics beacon (#181). GoatCounter runs on the loopback and these are
    # the only two paths of it the public site exposes.
    #
    # Two exact locations, deliberately not `location /api/a/`. GoatCounter is a
    # whole application behind this port -- dashboard, login, site settings, CSV
    # export -- and a prefix match would publish all of it under the site's own
    # name, where it would inherit the site's certificate and look like part of
    # openipc.org. The dashboard has a vhost of its own for that reason.
    #
    # Host is rewritten because GoatCounter picks the site from it, and these
    # requests arrive as openipc.org, openipc.ru or openipc.kz. Without this
    # each name would need a site of their own, or most of the traffic would be
    # dropped as unknown. openipc.eu was a fourth until 2026-09-21, when it
    # stopped being a mirror and became a 301 -- see sites-available/eu.openipc.
    # The backer count the donate page and the home band print (#198), served
    # here as it is on the origin so the static pages can be validated on dev
    # before they land. Without it the request fell through to the route map,
    # the catch-all answered 302, and the count silently rendered as nothing --
    # which is the page's correct behaviour for a missing file and therefore
    # indistinguishable from the feature being broken.
    #
    # The same file as production reads, deliberately: one number, and dev
    # shows what production will show.
    location = /api/v1/support/stats.json {
        alias /srv/www/shared/support-stats.json;
        default_type application/json;
        # Repeated, not inherited: add_header at location level replaces the
        # whole set the server block sends. All three, or staging becomes
        # indexable.
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "public, max-age=3600" always;
        add_header Access-Control-Allow-Origin "*" always;

        # Before the file exists, and between the write and the rename.
        error_page 404 = @no_support_stats;
    }

    # The wizard's command blocks, one document per SoC (#164), built by the
    # firmware role from the current builds and cached there until the next
    # build is pushed. The page is prerendered and its commands are not: what a
    # bootloader is told to do depends on what upstream has published.
    location ^~ /api/v1/wizard/ {
        proxy_pass http://127.0.0.1:3013;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By go always;
    }

    # The firmware explorer's data (/firmware-explorer): the pushed builds,
    # read back by the web role. Cached for five minutes and revalidated by
    # ETag, which only changes when a build is pushed.
    location ^~ /api/v1/explorer/ {
        proxy_pass http://127.0.0.1:3012;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By go always;
    }

    # The board catalogue (/cameras/boards, firmware#659): the tree of makers,
    # models, units and files, and the search over their U-Boot consoles and
    # notes, read by the web role from PostgreSQL. Revalidated by ETag, which
    # moves only when a board is added.
    location = /api/v1/boards {
        proxy_pass http://127.0.0.1:3012;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By go always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location = /api/v1/boards/search {
        limit_req zone=boards_search burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3012;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By go always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    # The catalogue's files: photos and their thumbnails, UART pinouts,
    # factory flash dumps, U-Boot console captures, board manuals. Written
    # once by `openipc boards import-openhisiipcam` and never rewritten, so a
    # month of cache is safe. The gallery asks for dozens of thumbnails at
    # once, so this carves itself out of the http-level `per_subnet 20` the way
    # /_astro/ does. Consoles and notes are text; a dump is a download.
    location ^~ /board-files/ {
        limit_conn per_subnet 100;
        limit_conn_status 429;
        alias /srv/www/shared/dev-boards/;
        types {
            image/jpeg jpg jpeg;
            image/png png;
            application/pdf pdf;
            application/vnd.openxmlformats-officedocument.wordprocessingml.document docx;
            text/plain uboot txt log;
            application/octet-stream bin;
        }
        charset utf-8;
        charset_types text/plain;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Content-Type-Options nosniff always;
        # Not `always`: a 404 cached for a month would outlive the file's arrival.
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    # Where OpenIPC's CI pushes each build, once (service/internal/builds/
    # PUSH.md). The web role verifies the GitHub Actions OIDC token itself; a
    # firmware build is about 1 MB gzipped, the limit is the service's 64 MB.
    location = /api/v1/builds {
        client_max_body_size 64m;
        proxy_request_buffering on;
        proxy_read_timeout 120;
        proxy_pass http://127.0.0.1:3012;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-Id $request_id;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Served-By go always;
    }

    location @no_support_stats {
        return 404 '{"error":"not available"}';
    }

    location = /api/a/c.js {
        proxy_pass http://127.0.0.1:8081/count.js;
        proxy_set_header Host analytics.openipc.org;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/a/count {
        # A plain GET with a query string: anything that can read the page can
        # replay it, without running any JavaScript. GoatCounter has a limit of
        # its own (4/s per address) and this one sits deliberately above it --
        # see conf.d/openipc-beacon-rate.conf. This keeps a flood off the Go
        # process; that keeps the numbers honest.
        limit_req zone=beacon burst=20 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8081/count;
        proxy_set_header Host analytics.openipc.org;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Never cached. A cached count is a count that happened once and was
        # then reported as many, or not reported at all.
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # Retired with the origin's, and for the same reason: frames leave over
    # the wall channel now, so there is no file here to serve. See the note in
    # sites-available/org.openipc.
    location ^~ /wall/ {
        return 410;
    }

    # The same three retired byte addresses production refuses. Dev had been
    # answering these 302 through the catch-all while production answered 410,
    # which makes dev a worse rehearsal than it looks: the whole point of the
    # environment is that a difference here is a difference there.
    # The gallery's older address, retired for readers (#165). See
    # conf.d/openipc-wall-shell.conf for the two maps, and for why only a read
    # is redirected: POST here is a camera uploading a frame.
    location ~ "^/(?:(?:ru|zh)/)?snapshots/?$" {
        # The concurrency pool the gallery location below applies, which this
        # one shadows for this address. Without it a burst of uploads -- the
        # POSTs that fall past the redirect -- reaches the service uncapped.
        limit_conn media_conc 12;
        limit_conn_status 429;

        if ($snapshots_alias_read) {
            # The query travels: `?locale=` has already been read by the map
            # that chose the target, and a campaign's utm parameters belong to
            # the reader rather than to the address.
            return 301 $snapshots_alias_read$is_args$args;
        }

        # A cutover's write freeze (#293): cameras are told 503 and retry on
        # their next cron. Only a POST reaches this line.
        if ($openipc_freeze_dev_upload) {
            return 503;
        }

        proxy_pass http://$openipc_up_dev_upload;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;

        # The upload limit, which is the origin's and is what a camera POSTs
        # against.
        client_max_body_size 1m;

        add_header X-Served-By $openipc_by_dev_upload always;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    # --- The Open Wall is files now (#165) ---------------------------------
    #
    # Five addresses, one shell per locale. `/open-wall` is a page of its own
    # in the bundle; every other wall address -- a page of the gallery, a
    # camera permalink, a snapshot, its archive, its slideshow -- carries an id
    # that changes by the hour and cannot be a file, so nginx serves them all
    # from `_shell/wall/index.html` and the island reads the address to learn
    # what it is. `$wall_shell` is the per-locale path; see
    # conf.d/openipc-wall-shell.conf.
    #
    # Ahead of the other wall locations below and stricter than any of them:
    # an id that is not twenty hex characters, a numeric one, and anything
    # ending .jpg all fall past these to the answers below.
    #
    # Both patterns are QUOTED. `{20}` is a repetition count to a regex and the
    # start of a block to nginx's parser, which truncates the pattern at the
    # brace and fails with "missing closing parenthesis" pointing at a regex
    # that plainly has one.
    #
    # The production vhost carries the concurrency and rate caps on these
    # locations; this one does not, because dev is behind basic auth and is not
    # the host anything floods.
    location ~ "^/(?:(?:ru|zh)/)?open-wall/?$" {
        root /srv/www/static/dev/current;
        try_files $wall_gallery_read @fallback;

        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Served-By static always;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location ~ "^/(?:(?:ru|zh)/)?open-wall/(?:[0-9]+|camera/[0-9a-f]{16})$" {
        root /srv/www/static/dev/current;
        try_files $wall_shell_read @fallback;

        # All of them repeated: add_header at location level replaces the
        # whole inherited set, and dropping the robots line here is how
        # staging becomes indexable.
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Served-By static always;
        # A shell is one file serving many addresses, and it changes on every
        # deploy. Revalidate rather than cache: a conditional request and a 304
        # off nginx's Last-Modified, which is what the bundle's pages do.
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location ~ "^/(?:(?:ru|zh)/)?snapshots/[0-9a-f]{20}(?:/(?:archive|oneday|slideshow))?$" {
        root /srv/www/static/dev/current;
        try_files $wall_shell_read @fallback;

        add_header Strict-Transport-Security max-age=15768000;
        # Staging's own, which already says more than #165 asks for on these
        # addresses.
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Served-By static always;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location ~ ^/(?:(?:ru|zh)/)?snapshots/[^/]+/download {
        return 410;
    }

    location ~ ^/(?:(?:ru|zh)/)?snapshots/camera(?:[./]|$) {
        return 410;
    }

    location ~ ^/(?:(?:ru|zh)/)?open-wall/camera/[^/]+\.jpg$ {
        return 410;
    }
    # The wall as data: the home page's mosaic, and the four addresses the
    # gallery's own pages are moving onto (#165).
    #
    # The pages are files, so a page cannot carry a grant of its own; it asks
    # these addresses for its frames and the grant that covers them.
    #
    # This location is every wall address EXCEPT the socket, which has its own
    # longer prefix below and wins on length whatever the order here. The split
    # is the whole point: the socket's block forbids caching and sets an hour's
    # timeout, which is right for a connection and wrong for a document, and
    # #165's four JSON addresses would otherwise have inherited it -- reaching
    # the service on every request and minting a grant each time, outside the
    # rate limit every wall page has. Found by review on #281.
    #
    # burst 48 and not the 8 this carried when it was the mosaic alone: these
    # addresses ARE the gallery pages now, one fetch per page view, and 48 is
    # the number conf.d/openipc-snapshot-rate.conf derives from the busiest
    # real reader ever measured. A smaller burst here would refuse readers the
    # pages they replace serve today.
    #
    # Microcached for a minute on the same key the pages use. One body serves
    # every reader, which is what the grant's cache-window bucketing exists for:
    # the same ids in the same five minutes sign to the same bytes, so a cached
    # response carries a grant that is still valid when it is served.
    # The availability feed (#298): the Go firmware process, which owns the
    # release data it is computed from. A trailing slash is accepted too: the Go
    # route is the canonical path alone, so the URI is rewritten to it before
    # proxying.
    location ~ ^/api/v1/hardware/availability\.json/*$ {
        rewrite ^ /api/v1/hardware/availability.json break;
        proxy_pass http://$openipc_up_dev_availability;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        add_header X-Served-By $openipc_by_dev_availability always;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location ^~ /api/v1/wall/ {
        # The Go web process (#296); see conf.d/openipc-routes.conf. The socket
        # below has its own location.
        proxy_pass http://$openipc_up_dev_wall;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The wall's own per-address budget, shared with the gallery pages,
        # because a reader who loads a wall page and a reader who fetches its
        # data are the same reader. The cache absorbs the rest, except for a
        # request carrying a session cookie -- which anybody can send, and
        # which bypasses it.
        limit_req zone=snapshot_pages burst=48 nodelay;
        limit_req_status 429;

        proxy_cache openipc_micro;
        # $locale_key even though this body carries no language: the ids, the
        # grant and the SoC names read the same in every one. The rule it obeys
        # is the one that exists because ignoring Vary served the Russian Open
        # Wall to English visitors for a minute at a time, and three entries
        # holding identical bytes is a cheaper thing to keep than an exemption
        # somebody has to re-derive.
        proxy_cache_key $scheme$host|$locale_key|$uri;
        proxy_cache_valid 200 60s;
        proxy_cache_lock on;

        # HSTS is repeated because add_header at location level replaces the
        # whole inherited set. Cache-Control and Access-Control-Allow-Origin
        # are NOT repeated: they come from the service, pass through this proxy,
        # and are replayed from the cache with the rest of the response. Adding
        # them here too sent each one twice, and the second of them would be
        # nginx deciding a lifetime the service already declared.
        add_header X-Served-By $openipc_by_dev_wall always;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }


    # The frame channel on dev. Same shape as production -- upgrade headers,
    # buffering off, a long read timeout, its own per-address connection pool
    # -- because a socket that works here and not there, or the reverse, is
    # exactly what dev exists to catch.
    location ^~ /api/v1/wall/socket {
        limit_conn wall_sockets 16;
        limit_conn_status 429;

        # The Go web process's frame socket (#297), routed by
        # conf.d/openipc-routes.conf. Established sockets stay where they
        # are on a flip: a reload does not close them.
        proxy_pass http://$openipc_up_dev_socket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        proxy_no_cache 1;
        proxy_cache_bypass 1;

        add_header X-Served-By $openipc_by_dev_socket always;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

   # The browsable listing of assembled images that used to be at /files/ is
   # gone; images leave through /firmware-cache/.
   location /files/ {
       return 404;
   }

    # No URI part on proxy_pass: nginx forbids one in a regex location, and the
    # full original URI is what should reach the service anyway.
    location ~ ^/(?:(?:ru|zh)/)?cameras/vendors/[^/]+/socs/[^/]+/download_full_image {
        # Same limits as production, sharing the same zones, so that a change
        # to them can be exercised here before it reaches anyone. Dev has no
        # limit_conn of its own and gains none.
        limit_req zone=fw_start burst=8 nodelay;
        limit_req zone=fw_all burst=30 nodelay;

        proxy_buffer_size 128k;
        proxy_buffers 8 128k;

        # The Go firmware process (#299), or 503 while the surface is frozen
        # (conf.d/openipc-routes.conf). It answers with an X-Accel-Redirect
        # into /firmware-cache/.
        proxy_pass http://$openipc_up_dev_firmware;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;

        proxy_connect_timeout 120;
        proxy_send_timeout 120;
        proxy_read_timeout 180;

        add_header X-Served-By $openipc_by_dev_firmware always;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

     # Badges and logos embedded on pages this project does not control, as
    # production serves them (deploy/legacy-images).
    location /images/ {
        alias /srv/www/shared/images/;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }


    # The Go firmware process's image cache (#299): one version of each image,
    # built on first request. Reachable only through its X-Accel-Redirect.
    location /firmware-cache/ {
        internal;
        alias /srv/www/shared/dev-firmware/;
        add_header X-Served-By go always;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    # Fingerprinted assets, carved out of the http-level `limit_conn
    # per_subnet 20` that every location without one of its own inherits.
    # That cap counts concurrent HTTP/2 streams, and the homepage alone asks
    # for the partner logos and social icons together -- more than twenty on a
    # cold visit -- so dev was shedding its own images and rendering with gaps.
    # Production carves the same prefix out for the same reason; dev had been
    # left behind.
    # The web fonts are the bundle's (#304), and the pages' stylesheet asks
    # for them here.
    # Named by face and weight, never rewritten, so a year of cache is safe.
    location ^~ /fonts/ {
        root /srv/www/static/dev/current;
        try_files $uri =404;
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Served-By static always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # The old asset pipeline's address, retired (#304).
    location ^~ /assets/ {
        return 410 "Gone\n";
    }

    # The bundle's own hashed assets (#159). Astro fingerprints every file it
    # writes under /_astro/, so the name changes whenever the bytes do and the
    # old name is never reused -- which is the condition `immutable` asks for.
    # Without this they inherited no Cache-Control at all.
    #
    # ^~ so it wins over the regex locations below, and so these never take a
    # site_conc slot: an HTTP/2 page load opens several in parallel and they
    # must not compete with page renders.
    #
    # try_files ends at @fallback rather than =404, so a miss is answered the
    # way every other miss is.
    location ^~ /_astro/ {
        root /srv/www/static/dev/current;
        try_files $uri @fallback;

        # All three inherited headers repeated: add_header at location level
        # replaces the server block's entire set, and dropping X-Robots-Tag
        # would quietly make staging indexable.
        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Served-By static always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # The seam between the static bundle and everything else (#157), the same shape as
    # production and against a bundle of its own -- a rollback rehearsal on dev
    # must not touch what openipc.org serves. See the long note in
    # sites-available/org.openipc for why the try_files elements are these two
    # and not `$uri $uri/`.
    location / {
        root /srv/www/static/dev/current;
        try_files $uri $uri/index.html @fallback;

        # BOTH inherited headers repeated, not just HSTS. add_header at
        # location level replaces the server block's entire set, and dropping
        # X-Robots-Tag would quietly make staging indexable -- the same trap
        # the production vhost documents for HSTS, with a worse outcome.
        add_header Strict-Transport-Security max-age=15768000 always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Served-By static always;

        # Pages, unlike the hashed assets above, keep their address when their
        # content changes -- a deploy rewrites /donate/index.html in place. So
        # they may be cached but never used without asking: max-age=0 with
        # must-revalidate means a conditional request and, almost always, a
        # 304 off nginx's Last-Modified.
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    location @fallback {
        # Everything the bundle does not hold (#304) is answered from
        # conf.d/openipc-redirects.conf -- the redirects, the retired addresses
        # and the catch-all -- and anything else is a page the bundle should
        # have held, which is a 404. `return` is the one thing `if` is safe
        # for. One line each: the deploy tests read this block as ending at
        # the first bare `}`.
        # The error page itself, missing from the bundle: a bare 404 rather
        # than the route map's catch-all redirect home.
        if ($uri = /404.html)                 { return 404; }
        if ($openipc_route_action = 410)      { return 410 "Gone\n"; }
        if ($openipc_route_action = 301)      { return 301 $openipc_route_target; }
        if ($openipc_route_action = 302)      { return 302 $openipc_route_target; }
        if ($openipc_route_action = catchall) { return 302 $openipc_route_target; }
        # The bundle's own 404 page (src/pages/404.astro), with the 404
        # status, through `location /`. If the bundle has none, the line at
        # the top of this block answers, and nginx does not recurse into
        # error_page a second time.
        error_page 404 /404.html;
        return 404;

        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-Served-By $openipc_route_by always;
        add_header Cache-Control $openipc_route_cache always;
    }

}
