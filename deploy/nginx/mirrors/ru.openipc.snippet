# The Open Wall's frame channel, and the root redirect, through the mirror.
#
# Applied by hand on 194.58.109.202 (openipc.ru). See README.md in this
# directory for why these hosts are not managed by push-nginx.sh.
#
# WHAT GOES WHERE
#
# 1. At http level -- /etc/nginx/conf.d/openipc-upgrade.conf, which is included
#    by the stock `include /etc/nginx/conf.d/*.conf;` in nginx.conf:
#
#        map $http_upgrade $connection_upgrade {
#            default upgrade;
#            ''      close;
#        }
#
# 2. In the openipc.ru server block, BEFORE `location /`, so the prefix match
#    wins: the block below.
#
# The host already sets proxy_http_version 1.1 in `location /` -- which is why
# only the headers and the timeout are new -- but a prefix location does not
# inherit anything from a sibling, so every directive it needs is repeated
# here.

location ^~ /api/v1/wall/socket {
    proxy_pass https://openipc.org;

    # Without these two the handshake degrades silently: nginx forwards the
    # request, the origin answers a normal 200 or 400 instead of 101, and the
    # reader sees an empty gallery with nothing in any log to say why.
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Same TLS arrangement as `location /`: the origin hosts several sites on
    # one address, so it needs the name in the handshake.
    proxy_ssl_server_name         on;
    proxy_ssl_name                openipc.org;
    proxy_ssl_verify              on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth        3;

    # The server block sets its own HSTS; the origin's would be a second copy
    # of the header on every response (as kz/snippets/openipc-mirror.conf).
    proxy_hide_header Strict-Transport-Security;

    # A socket is idle most of its life. The default would close it mid-session
    # and the reader would lose their frames with no error.
    proxy_buffering    off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}

# The root goes to the Russian pages -- except for a reader already on this
# site. The language picker's English entry is a link to `/`, and until
# 2026-09-29 this redirect sent them straight back to /ru: English could not
# be chosen on openipc.ru at all. The origin's home page makes the same
# exception (frontend/apps/site/src/pages/index.astro). Applied by hand on
# 2026-09-29, in the openipc.ru server block, replacing the unconditional
# `location = / { return 302 ...; }`. The same day `location /` on that host
# was given `proxy_hide_header Strict-Transport-Security;` too, for the reason
# given in the socket location above.

location = / {
    if ($http_referer !~* "^https://openipc\.ru/") {
        return 302 https://openipc.ru/ru$is_args$args;
    }
    proxy_pass https://openipc.org;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Accept-Encoding   "";   # for the sub_filter below
    proxy_ssl_server_name         on;
    proxy_ssl_name                openipc.org;
    proxy_ssl_verify              on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth        3;
    proxy_http_version 1.1;
    proxy_hide_header Strict-Transport-Security;
}

# openipc.ru is the main address of the Russian pages (#179). openipc.org sits
# on Hetzner addresses that Russian providers filter, and every Russian page
# served through this mirror named openipc.org as its canonical -- asking
# Yandex, whose audience is here, to send readers to an address they may not be
# able to open. Pages served through this mirror now name openipc.ru for the
# Russian tree: the canonical, the ru alternate, og:url and the sitemap's
# entries. English and Chinese keep openipc.org, and openipc.org itself is
# unchanged, so Google's picture of the site does not move. Applied by hand on
# 2026-09-30, at server level in the openipc.ru server block, and the sitemap
# submitted to Yandex Webmaster for https:openipc.ru:443 the same day.
#
# sub_filter cannot read a compressed body, so BOTH proxying locations that
# serve pages -- `location = /` above and `location /` below -- carry
# `proxy_set_header Accept-Encoding "";` (a location that sets any
# proxy_set_header inherits none from its server). The mirror still gzips HTML
# to the reader itself.

sub_filter_once  off;
sub_filter_types text/xml application/xml;
sub_filter 'rel="canonical" href="https://openipc.org/ru'      'rel="canonical" href="https://openipc.ru/ru';
sub_filter 'hreflang="ru" href="https://openipc.org/ru'        'hreflang="ru" href="https://openipc.ru/ru';
sub_filter 'property="og:url" content="https://openipc.org/ru' 'property="og:url" content="https://openipc.ru/ru';
sub_filter '<loc>https://openipc.org/ru'                       '<loc>https://openipc.ru/ru';

# Owner reports and the Club's send form, with the origin's limits rather than
# the catch-all's 1m: a report carries photos, documents and a flash backup,
# and the origin takes it up to 300m with five minutes to arrive
# (sites-available/org.openipc, `location = /api/v1/reports` and
# `location ^~ /api/v1/club/`). Since the origin sends every Russian network
# here with a 301 (conf.d/openipc-blocked-nets.conf), this is the only way a
# reader in Russia can send one. Unbuffered, so a large body streams through
# instead of being spooled to this host's disk first. Applied by hand on
# 2026-10-03, in the openipc.ru server block, before `location /`.

location ~ ^/api/v1/(?:reports$|club/) {
    proxy_pass https://openipc.org;
    proxy_set_header Accept-Encoding   "";
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name         on;
    proxy_ssl_name                openipc.org;
    proxy_ssl_verify              on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth        3;
    proxy_http_version 1.1;
    proxy_hide_header Strict-Transport-Security;

    client_max_body_size 300m;
    client_body_timeout 300;
    proxy_request_buffering off;
    proxy_read_timeout 300;
    proxy_send_timeout 300;
}

# The host's catch-all, as it stands on 2026-09-30, recorded so the header the
# rewrite depends on is held by a test rather than by memory. It was on the
# host before this directory existed; only the Accept-Encoding line is new.

location / {
    proxy_pass https://openipc.org/;
    proxy_set_header Accept-Encoding   "";

    # Передаём основному серверу, кто на самом деле пришёл.
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Указываем имя узла в TLS-рукопожатии: на основном сервере
    # несколько сайтов на одном адресе.
    proxy_ssl_server_name on;
    proxy_ssl_name        openipc.org;

    # Проверка сертификата основного сервера
    proxy_ssl_verify              on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth        3;

    # По умолчанию nginx ходит к upstream по HTTP/1.0.
    proxy_http_version 1.1;

    # Тот же предел, что и на основном сервере. Через зеркала
    # камеры загружают снимки — пределы обязаны совпадать.
    client_max_body_size 1m;

    # Этот server сам ставит HSTS; копия с основного сервера -- вторая.
    proxy_hide_header Strict-Transport-Security;
}

# Stock camera firmware's plain HTTP, in the openipc.ru PORT 80 server block,
# before its `location / { return 301 https://...; }`. Applied by hand on
# 2026-10-05.
#
# A camera on stock firmware has no TLS, so the redirect to HTTPS that the rest
# of port 80 answers is a dead end for it, and in Russia the origin is no way
# round: the TSPU freezes a connection to it after ~20 KB, which ipctool
# (~200 KB) and a flash backup never get through. Both were seen on 2026-10-05:
# uget and NFS from a camera in Russia never finished, and its upload's body
# stopped arriving and timed out at 60 s. Through this host they get through,
# the way the Open Wall's uploads do (conf.d/openipc-blocked-nets.conf).
#
# The origin sends a cut-off network's GET /ipctool here with a 302, which
# wget follows; uget and ipctool follow none, so the report page read on
# openipc.ru names openipc.ru in its commands, `ipctool upload --host
# openipc.ru` included (frontend/apps/site/src/lib/reports.ts). NFS is not
# mirrored.
#
# The limits are the origin's own for the same locations
# (sites-available/org.openipc, port 80).

# From the origin's port 80, because that is the only place it is served:
# over HTTPS /ipctool is a redirect to the project on GitHub. This host's own
# connection to the origin is not frozen.
location ~ ^/(?:ipctool|ipctool-mips32|ipctool-arm64)$ {
    proxy_pass http://openipc.org;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_hide_header Strict-Transport-Security;
}

location ~ ^/api/v1/(?:reports|boards/identify)$ {
    # One failed verify of the origin's certificate, cached onto a reused TLS
    # session, fails every later handshake until nginx reloads: every report
    # from Russia answered 502 on 2026-10-09 ("unable to get local issuer
    # certificate" in ru.openipc.error.log) while the chain verified fine from
    # the shell. The 443 server has carried the same guard at server level
    # since 2026-09-27, for the pages; this server lacked it.
    proxy_ssl_session_reuse off;

    proxy_pass https://openipc.org;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name         on;
    proxy_ssl_name                openipc.org;
    proxy_ssl_verify              on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth        3;
    proxy_http_version 1.1;
    proxy_hide_header Strict-Transport-Security;

    client_max_body_size 300m;
    client_body_timeout 300;
    proxy_request_buffering off;
    proxy_read_timeout 300;
    proxy_send_timeout 300;
}
