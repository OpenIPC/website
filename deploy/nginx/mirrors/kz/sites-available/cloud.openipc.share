# Camera sharing links for everyone: share.openipc.cloud and
# <id>.share.openipc.cloud.
#
# openipc.org's addresses are filtered by some providers -- Russia's among
# them -- so the share names point here, a host both sides reach. The share
# relay runs here too (share-relay/ in this directory: the website's share
# role as a systemd service on 127.0.0.1:3004). Pages and cameras both come in
# through this nginx, so signalling between them never leaves the host: with
# the relay on the origin, an offer and its answer each crossed to it and
# back, 58 ms each way. Only signalling passes through -- a session's traffic
# goes peer to peer, or through a TURN relay.
#
# The origin keeps a share role of its own and the vhost that answers these
# names from this host alone (its sites-available/cloud.openipc.share and the
# geo beside set_real_ip_from in its nginx.conf): pointing share_relay back at
# it is the way back, should the relay here fail.
#
# The wildcard is issued on the origin over DNS-01 and handed over by its
# dehydrated hook (share-cert/ in this directory), because this host keeps no
# DNS token.

# Kept connections, not one per request: the share page makes its requests
# one after another, so a connection set up for each was paid in series on
# every open.
upstream share_relay {
    server 127.0.0.1:3004;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name share.openipc.cloud *.share.openipc.cloud;
    access_log /var/log/nginx/cloud.openipc.share.access.log;
    error_log  /var/log/nginx/cloud.openipc.share.error.log;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name share.openipc.cloud *.share.openipc.cloud;
    access_log /var/log/nginx/cloud.openipc.share.access.log;
    error_log  /var/log/nginx/cloud.openipc.share.error.log;

    ssl_certificate     /etc/nginx/certs/share.openipc.cloud/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/share.openipc.cloud/privkey.pem;
    include snippets/openipc-tls.conf;

    add_header Strict-Transport-Security "max-age=15768000" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    # Signalling is small; nothing here takes a body worth the name.
    client_max_body_size 64k;

    location / {
        # To the share relay on this host. The Host is kept: the relay reads
        # the share id from it, and the page's origin is checked against it.
        # The reader's address goes in X-Real-IP, which the relay's
        # per-address limits read.
        proxy_pass http://share_relay;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        # A camera holds its relay socket for as long as it has a share.
        # Anything else leaves its connection to the relay open for reuse.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade_keepalive;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_hide_header Strict-Transport-Security;
    }
}
