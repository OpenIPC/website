SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Hourly memory baseline for the migration epic (#143, feeds #148).
5 * * * *  root  /usr/local/sbin/openipc-sample-rss >>/var/log/openipc-rss.log 2>&1

# Yesterday's audience, people only, as an HTML page (#180). Runs after
# logrotate, which fires at 00:00, and before anyone is awake to ask.
17 3 * * *  root  /usr/local/sbin/openipc-audience-report >>/var/log/openipc-audience.log 2>&1

# The country database the report annotates addresses with. DB-IP publish a new
# one each month under a predictable name and the old one keeps working, so a
# failed fetch is not an outage.
41 4 3 * *  root  /usr/local/sbin/openipc-audience-report --refresh-country-db >>/var/log/openipc-audience.log 2>&1

# The backer count the donate page prints (#198). Hourly, at :23 so it does not
# land with the RSS sample at :05. A failed fetch leaves the previous file
# alone and the page keeps showing the last good number until it goes stale at
# 48 hours, after which the page renders without one.
23 * * * *  root  /usr/local/sbin/openipc-oc-stats >>/var/log/openipc-oc-stats.log 2>&1

# The monthly audience memo (#184): the fixed set of numbers for the month that
# just closed, so month three compares with month one. On the 1st at 05:30 --
# after the nightly report at 03:17 has written the last day's row, and well
# after logrotate. The memo lands in the reports directory; a person fills in
# the two commentary paragraphs and the manual sources, then sends it.
30 5 1 * *  root  /usr/local/sbin/openipc-audience-memo >>/var/log/openipc-audience-memo.log 2>&1

# What people searched for (#179): the search consoles' queries into a daily
# archive under the reports directory, which the monthly memo reads. Google
# finalises a day two to three days late and each run fills whatever is new, so
# the hour does not matter beyond running before the memo on the 1st.
47 4 * * *  root  /usr/local/sbin/openipc-search-queries fetch >>/var/log/openipc-search-queries.log 2>&1

# GitHub traffic to OpenIPC/firmware and OpenIPC/wiki (#318). GitHub keeps only
# the last 14 days and cannot push it, so it is fetched before it rolls off:
# every Monday, and on the 1st and 15th so there is always a referrer window
# ending on the 14th and one ending on the month's last day. Cron runs a line
# whose day-of-month and day-of-week are both set on EITHER, which is what this
# wants. Before the memo at 05:30 on the 1st.
53 4 1,15 * 1  root  /usr/local/sbin/openipc-github-traffic fetch >>/var/log/openipc-github-traffic.log 2>&1
