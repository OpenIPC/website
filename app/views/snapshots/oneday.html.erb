<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('nav.home'), locale_path('/') %></li>
    <li class="breadcrumb-item"><%= link_to t('nav.snapshots'), locale_path('/open-wall') %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= link_to t('nav.snapshot', number: @snapshot.public_id), snapshot_path(id: @snapshot) %></li>
  </ol>
</nav>

<article>
  <header>
    <h2><%= t('title.openwall') %></h2>
  </header>

  <%# The slideshow arrives in the frame, not in this page.
      Bootstrap is what advances a carousel, so without JavaScript all 96
      slides were one visible frame and 95 behind `display: none` -- nobody
      who could not run the script was ever served by having them here, and
      writing them out cost 104 KB carrying 96 full-HD URLs and 96 sibling
      snapshot addresses to anyone who fetched the page. A client that runs
      the script asks for them; this page shows the frame it is standing on
      and a link for one that does not. %>
  <%= turbo_frame_tag 'oneday-slideshow', src: slideshow_snapshot_path(id: @snapshot), loading: 'lazy' do %>
    <div class="ratio ratio-16x9 bg-light">
      <%= image_tag(@snapshot.wall_image(:fullhd) || default_image_path, alt: t('snapshots.slide.snapshot_alt'),
                    class: "d-block h-100 w-auto position-absolute top-50 start-50 translate-middle") %>
    </div>
    <p class="mt-3"><%= link_to t('.show_all_frames'), slideshow_snapshot_path(id: @snapshot) %></p>
  <% end %>
</article>
