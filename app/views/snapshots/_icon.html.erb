<div class="col">
  <div class="card text-bg-dark <%= icon.eql?(@snapshot) ? "bg-warning" : "bg-light" %>">
    <%= link_to wall_frame_tag(icon, :icon2, alt: t('.snapshot_alt'), css_class: "card-img"), snapshot_path(id: icon), class: 'stretched-link' %>
    <div class="card-img-overlay">
      <div class="text-center text-white fw-bold px-2 x-small" style="background-color: #00000099; text-shadow: 1px 1px 2px black">
        <span data-timestamp="<%= icon.created_at.to_i %>"><%= icon.created_at %></span>
      </div>
    </div>
  </div>
</div>
