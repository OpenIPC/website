<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('nav.home'), locale_path('/') %></li>
    <li class="breadcrumb-item"><%= link_to t('nav.snapshots'), locale_path('/open-wall') %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= link_to t('nav.snapshot', number: @snapshot.public_id), snapshot_path(id: @snapshot) %></li>
  </ol>
</nav>

<article>
  <%= wall_noscript %>
  <header>
    <h2><%= t('title.openwall') %></h2>
  </header>

  <div class="ratio ratio-16x9 bg-light mb-4">
    <%= wall_frame_tag(@snapshot, :fullhd, alt: t('.snapshot_alt'), css_class: "h-100 w-auto position-absolute top-50 start-50 translate-middle") %>
  </div>

  <%# The "view original HEIF" button was here, and what it put into the markup
      was rails_blob_path(@snapshot.file, disposition: 'inline') -- the
      ORIGINAL upload, at a signed id that never expires, on every HEIF
      snapshot page. It is gone with the rest of the byte addresses.
      ProcessImagesJob already renders HEIF uploads to JPEG variants, so the
      frame above shows the picture either way. %>

  <span class="float-end text-end text-muted">
    <span data-timestamp="<%= @snapshot.created_at.to_i %>"><%= @snapshot.created_at %></span><br>
    <%= @snapshot.image_dimensions %>, <%= @snapshot.file.byte_size %> bytes<br>
  </span>
  <p class="fw-bold mb-1"><%= @snapshot.soc.upcase %> + <%= @snapshot.sensor.upcase %></p>
  <p class="mb-2 text-secondary">OpenIPC <%= @snapshot.firmware %>, <%= @snapshot.streamer %></p>
  <p><span><%= t('.uptime') %>: <%= @snapshot.uptime %>.</span>
    <% unless @snapshot.soc_temperature.blank? %>
      <span><%= t('.temperature') %>: <%= @snapshot.soc_temperature %>°C.</span>
    <% end %></p>

  <p><%= @snapshot.caption %></p>

  <%# One link, and it goes to a page rather than to bytes. The two that are
      gone handed over the original upload and the camera's newest frame as
      files; between them they were the wall's largest leak. %>
  <p>
    <%= link_to t('site.snapshot.link_to_camera'), openwall_camera_path(id: @snapshot.camera_token) %>
  </p>

  <% if @snapshots && @snapshots.any? %>
    <h4><%= t('.last_24h') %></h4>
    <p><%= link_to t('.show_slideshow'), oneday_snapshot_path(id: @snapshot), class: "btn btn-primary" %></p>

    <%# The frame carries the first screenful and, for a client that runs the
        script, fetches the rest of the day when it scrolls into view. What is
        NOT here is the point of it: a camera at the 15-minute upload limit has
        96 frames in a day, and writing all of them into this page handed
        whoever fetched it 96 more snapshot addresses -- the supply line the
        Azure scraper re-armed on after the ids became opaque. The link below
        keeps every frame reachable without JavaScript. %>
    <%# target: '_top' or every icon in here navigates INTO this frame: Turbo
        scopes a link to its enclosing frame, the snapshot page it fetches has
        a frame of the same name, and the click would swap this grid for that
        page's strip instead of opening the snapshot. %>
    <%= turbo_frame_tag 'snapshot-archive', src: (@strip_more ? archive_snapshot_path(id: @snapshot) : nil),
                        loading: 'lazy', target: '_top' do %>
      <div class="archive row row-cols-2 row-cols-sm-3 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 row-cols-xxl-6 g-2">
        <%= render partial: 'icon', collection: @snapshots %>
      </div>
      <% if @strip_more %>
        <p class="mt-2"><%= link_to t('.show_all_frames'), archive_snapshot_path(id: @snapshot) %></p>
      <% end %>
    <% end %>
  <% end %>
</article>
