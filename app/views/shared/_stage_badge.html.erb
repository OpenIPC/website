<%# Project status badge. Locals: stage (neq/rnd/hlp/wip/mvp/done). %>
<% labels = { 'neq' => 'NEQ', 'rnd' => 'R&D', 'hlp' => 'HLP', 'wip' => 'WIP', 'mvp' => 'MVP', 'done' => 'DONE' } %>
<span class="stage-badge stage-badge--<%= stage %>" title="<%= t("pages.stages_of_firmware_development.#{stage}_info", default: '').truncate(120) %>"><%= labels[stage.to_s] %></span>
