<%# Dark call-to-action band. Locals: title, primary_label, primary_href,
    secondary_label/secondary_href (optional), note_html (optional),
    flush (optional).

    Most pages end with an article on white, where the band arriving with no
    gap reads as the text falling off a cliff. So there is one by default.
    flush: true removes it, for the page that puts the band directly under a
    full-bleed section -- there the gap is a stripe of white between two
    coloured bands, which is worse than no gap at all. %>
<section class="section--ink py-6 <%= 'mt-6' unless local_assigns[:flush] %>" data-bs-theme="dark">
  <div class="container text-center">
    <h2 class="mb-4"><%= title %></h2>
    <p class="d-flex flex-wrap gap-2 justify-content-center mb-0">
      <a href="<%= primary_href %>" class="btn btn-primary btn-lg"><%= primary_label %></a>
      <% if local_assigns[:secondary_label].present? %>
        <a href="<%= secondary_href %>" class="btn btn-outline-light btn-lg"><%= secondary_label %></a>
      <% end %>
    </p>
    <% if local_assigns[:note_html].present? %>
      <p class="small mt-4 mb-0 text-body-secondary"><%= note_html %></p>
    <% end %>
  </div>
</section>
