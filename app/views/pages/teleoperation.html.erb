<% content_for :fullwidth, 'yes' %>

<%# ---- Cover: the thesis, and the operator mirrored by the robot ---- %>
<section class="hero section--ink section--grid py-6 py-lg-7" data-bs-theme="dark">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6">
        <p class="small text-uppercase mb-3 eyebrow"><%= t('.eyebrow') %></p>
        <h1 class="mb-3"><%= t('.hero_title') %></h1>
        <p class="hero-lede lead mb-4"><%= t('.hero_lede') %></p>
        <p class="d-flex flex-wrap gap-2 mb-0">
          <%# The subject is what lets the mailbox count these without any analytics. %>
          <a href="mailto:business@openipc.org?subject=Teleoperation%20pilot" class="btn btn-primary btn-lg"><%= t('.hero_cta_pilot') %></a>
          <a href="<%= locale_path('/low-latency') %>" class="btn btn-outline-light btn-lg"><%= t('.hero_cta_link') %></a>
        </p>
      </div>
      <div class="col-lg-6">
        <%# The render carries its own alpha fade on all four edges and a
            background matched to $ink, so it sits on the dot grid without a
            rectangle. Regenerate from ~/reports/teleoperation-page if replaced. %>
        <%= image_tag 'teleoperation-hero.webp', class: 'hero-art', alt: t('.hero_art_alt'), width: 1672, height: 941 %>
      </div>
    </div>
  </div>
</section>

<%# ---- Three figures, each with its source under it ---- %>
<section class="border-bottom py-4">
  <div class="container">
    <div class="row g-4 text-center text-lg-start align-items-center">
      <% %w[market units latency].each do |key| %>
        <div class="col-md-4">
          <div class="stat">
            <span class="stat-n text-data"><%= t(".stat_#{key}_n") %></span>
            <span class="stat-l"><%= t(".stat_#{key}_l") %></span>
          </div>
        </div>
      <% end %>
    </div>
    <p class="small text-body-secondary text-center text-lg-start mt-3 mb-0"><%= t('.stats_source_html') %></p>
  </div>
</section>

<%# ---- The landscape: the strategy is settled, the rig is not ---- %>
<section class="py-6">
  <div class="container">
    <h2 class="h3 mb-4"><%= t('.landscape_title') %></h2>
    <div class="row g-5">
      <div class="col-lg-6">
        <p><%= t('.landscape_p1') %></p>
        <p class="mb-0"><%= t('.landscape_p2') %></p>
      </div>
      <div class="col-lg-6">
        <p><%= t('.landscape_p3') %></p>
        <p class="mb-0"><%= t('.landscape_p4') %></p>
      </div>
    </div>
    <blockquote class="pull-quote mt-5 mb-0"><p class="mb-0"><%= t('.pull_quote') %></p></blockquote>
  </div>
</section>

<%# ---- Four things the stack brings, in benefit language ---- %>
<section class="section--alt py-6">
  <div class="container">
    <h2 class="h3 mb-2"><%= t('.brings_title') %></h2>
    <p class="text-body-secondary mb-4" style="max-width: 70ch"><%= t('.brings_intro') %></p>
    <div class="row g-4 align-items-stretch">
      <% [%w[latency bi-stopwatch], %w[link bi-broadcast-pin], %w[time bi-clock-history], %w[stream bi-layers]].each do |key, icon| %>
        <div class="col-md-6 col-xl-3">
          <div class="card h-100 p-3">
            <i class="bi <%= icon %> fs-3 text-primary"></i>
            <h3 class="h6 mt-2"><%= t(".bring_#{key}_title") %></h3>
            <p class="text-body-secondary small mb-0"><%= t(".bring_#{key}_text") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- The flywheel, and what a pilot looks like ---- %>
<section class="py-6">
  <div class="container">
    <h2 class="h3 mb-2"><%= t('.loop_title') %></h2>
    <p class="text-body-secondary mb-5" style="max-width: 70ch"><%= t('.loop_intro') %></p>
    <div class="flow" role="list">
      <% nodes = [%w[operator bi-headset-vr], %w[link bi-broadcast-pin], %w[robot bi-robot], %w[recorder bi-record-circle], %w[dataset bi-database]] %>
      <% nodes.each_with_index do |(key, icon), i| %>
        <% if i.positive? %>
          <div class="flow-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></div>
        <% end %>
        <div class="flow-node" role="listitem">
          <i class="bi <%= icon %>"></i>
          <h3><%= t(".node_#{key}_title") %></h3>
          <p><%= t(".node_#{key}_text") %></p>
        </div>
      <% end %>
    </div>
    <p class="text-center text-body-secondary mt-3 mb-5"><i class="bi bi-arrow-repeat me-1"></i><%= t('.loop_return') %></p>

    <h3 class="h5 mb-4"><%= t('.pilot_title') %></h3>
    <div class="row g-4">
      <% (1..3).each do |i| %>
        <div class="col-md-4">
          <div class="story-step">
            <div class="story-index mb-2">0<%= i %></div>
            <h4 class="h6"><%= t(".pilot#{i}_title") %></h4>
            <p class="text-body-secondary mb-0"><%= t(".pilot#{i}_text") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- Why OpenIPC ---- %>
<section class="section--alt py-6">
  <div class="container">
    <h2 class="h3 mb-4"><%= t('.why_title') %></h2>
    <div class="row g-4">
      <% (1..3).each do |i| %>
        <div class="col-md-4">
          <h3 class="h6"><%= t(".why#{i}_title") %></h3>
          <p class="text-body-secondary small mb-0"><%= t(".why#{i}_text") %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- The ask. flush: the band follows a tinted full-bleed section, like the homepage. ---- %>
<section class="section--ink py-6" data-bs-theme="dark">
  <div class="container text-center">
    <h2 class="mb-3"><%= t('.cta_title') %></h2>
    <p class="text-body-secondary mx-auto mb-4" style="max-width: 62ch"><%= t('.cta_text') %></p>
    <p class="d-flex flex-wrap gap-2 justify-content-center mb-0">
      <%# The body opens with the four lines an engineer needs to answer with a plan. %>
      <a href="mailto:business@openipc.org?subject=Teleoperation%20design%20partner&amp;body=Robot%3A%20%0ACamera%20chip%3A%20%0AHeadset%3A%20%0AWhat%20you%20want%20to%20teach%20it%3A%20%0A" class="btn btn-primary btn-lg"><%= t('.cta_primary') %></a>
      <a href="https://t.me/openipc" class="btn btn-outline-light btn-lg"><%= t('.cta_secondary') %></a>
    </p>
    <p class="small mt-4 mb-0 text-body-secondary"><%= t('.cta_note_html') %></p>
  </div>
</section>
