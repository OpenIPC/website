<% content_for :fullwidth, 'yes' %>

<%# ---- Cover: the thesis, and the network converging on the car park ---- %>
<section class="hero section--ink section--grid py-6 py-lg-7" data-bs-theme="dark">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6">
        <p class="small text-uppercase mb-3 eyebrow"><%= t('.eyebrow') %></p>
        <h1 class="mb-3"><%= t('.hero_title') %></h1>
        <p class="hero-lede lead mb-4"><%= t('.hero_lede') %></p>
        <p class="d-flex flex-wrap gap-2 mb-0">
          <%# The subject and body are what let the mailbox count and triage these without analytics. %>
          <a href="mailto:business@openipc.org?subject=NPU%20feasibility%3A%20%5BSoC%5D%20%2F%20%5Bmodel%5D&amp;body=Model%20(format)%3A%20%0ATarget%20SoC%20and%20SDK%20version%3A%20%0AFrames%20from%20the%20camera%20(link)%3A%20%0ATarget%20fps%20and%20accuracy%20metric%3A%20%0A" class="btn btn-primary btn-lg"><%= t('.hero_cta_send') %></a>
          <a href="#engagement" class="btn btn-outline-light btn-lg"><%= t('.hero_cta_how') %></a>
        </p>
      </div>
      <div class="col-lg-6">
        <%# Cropped to its subject and faded on all four edges, background matched
            to $ink; the source and the script are in ~/reports/edge-ai-page. %>
        <%= image_tag 'edge-ai-hero.webp', class: 'hero-art', alt: t('.hero_art_alt'), width: 1199, height: 819 %>
      </div>
    </div>
  </div>
</section>

<%# ---- Three figures ---- %>
<section class="border-bottom py-4">
  <div class="container">
    <div class="row g-4 text-center text-lg-start align-items-center">
      <% %w[fps loss gap].each do |key| %>
        <div class="col-md-4">
          <div class="stat">
            <span class="stat-n text-data"><%= t(".stat_#{key}_n") %></span>
            <span class="stat-l"><%= t(".stat_#{key}_l") %></span>
          </div>
        </div>
      <% end %>
    </div>
    <p class="small text-body-secondary text-center text-lg-start mt-3 mb-0"><%= t('.stats_source') %></p>
  </div>
</section>

<%# ---- The reader's scar ---- %>
<section class="py-6">
  <div class="container">
    <h2 class="h3 mb-4"><%= t('.scar_title') %></h2>
    <div class="row g-5">
      <div class="col-lg-6"><p class="mb-0"><%= t('.scar_p1') %></p></div>
      <div class="col-lg-6"><p class="mb-0"><%= t('.scar_p2') %></p></div>
    </div>
    <blockquote class="pull-quote mt-5 mb-0"><p class="mb-0"><%= t('.pull_quote') %></p></blockquote>
  </div>
</section>

<%# ---- Four things we bring ---- %>
<section class="section--alt py-6">
  <div class="container">
    <h2 class="h3 mb-2"><%= t('.brings_title') %></h2>
    <p class="text-body-secondary mb-4" style="max-width: 70ch"><%= t('.brings_intro') %></p>
    <div class="row g-4 align-items-stretch">
      <% [%w[map bi-diagram-3], %w[driver bi-cpu], %w[fit bi-bullseye], %w[proven bi-check2-circle]].each do |key, icon| %>
        <div class="col-md-6 col-xl-3">
          <div class="card h-100 p-3">
            <i class="bi <%= icon %> fs-3 text-primary"></i>
            <h3 class="h6 mt-2"><%= t(".bring_#{key}_title") %></h3>
            <p class="text-body-secondary small mb-0"><%= t(".bring_#{key}_text") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- Results ---- %>
<section class="py-6">
  <div class="container">
    <h2 class="h3 mb-4"><%= t('.results_title') %></h2>
    <div class="row g-5">
      <% %w[plates faces cpu].each do |key| %>
        <div class="col-lg-4">
          <h3 class="h5"><%= t(".res_#{key}_title") %></h3>
          <p class="text-body-secondary mb-0"><%= t(".res_#{key}_text") %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- The platforms ---- %>
<section class="section--alt py-6">
  <div class="container">
    <h2 class="h3 mb-3"><%= t('.platforms_title') %></h2>
    <p class="platform-pills mb-3">
      <% %w[hisi sstar rk ingenic arm].each do |key| %>
        <span><%= t(".platform_#{key}") %></span>
      <% end %>
    </p>
    <p class="text-body-secondary mb-0" style="max-width: 70ch"><%= t('.platforms_text') %></p>
  </div>
</section>

<%# ---- The engagement ---- %>
<section class="py-6" id="engagement">
  <div class="container">
    <h2 class="h3 mb-4"><%= t('.engagement_title') %></h2>
    <div class="row g-4">
      <% (1..3).each do |i| %>
        <div class="col-md-4">
          <div class="story-step">
            <div class="story-index mb-2">0<%= i %></div>
            <h3 class="h6"><%= t(".step#{i}_title") %></h3>
            <p class="text-body-secondary mb-0"><%= t(".step#{i}_text") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- The ask. mt-6: the band follows an article on white. ---- %>
<section class="section--ink py-6 mt-6" data-bs-theme="dark">
  <div class="container text-center">
    <h2 class="mb-3"><%= t('.cta_title') %></h2>
    <p class="text-body-secondary mx-auto mb-4" style="max-width: 62ch"><%= t('.cta_text') %></p>
    <p class="d-flex flex-wrap gap-2 justify-content-center mb-0">
      <a href="mailto:business@openipc.org?subject=NPU%20feasibility%3A%20%5BSoC%5D%20%2F%20%5Bmodel%5D&amp;body=Model%20(format)%3A%20%0ATarget%20SoC%20and%20SDK%20version%3A%20%0AFrames%20from%20the%20camera%20(link)%3A%20%0ATarget%20fps%20and%20accuracy%20metric%3A%20%0A" class="btn btn-primary btn-lg"><%= t('.cta_primary') %></a>
      <a href="https://t.me/openipc" class="btn btn-outline-light btn-lg"><%= t('.cta_secondary') %></a>
    </p>
    <p class="small mt-4 mb-0 text-body-secondary"><%= t('.cta_note_html') %></p>
  </div>
</section>
