<%# One services whitepaper. Locals: key (the pages.<key> i18n block and the
    URL slug with underscores), icons (four Bootstrap Icons for the cards),
    pills (how many platform pills the block defines), mail_subject and
    mail_body (English, as on /edge-ai: the subject is what lets the mailbox
    count and triage enquiries without analytics). %>
<% t_ = ->(k) { t("pages.#{key}.#{k}") } %>
<% mailto = "mailto:business@openipc.org?subject=#{ERB::Util.url_encode(mail_subject)}&body=#{mail_body.map { |l| "#{ERB::Util.url_encode(l)}%3A%20" }.join('%0A')}" %>

<%# ---- Cover ---- %>
<section class="hero section--ink section--grid py-6 py-lg-7" data-bs-theme="dark">
  <div class="container">
    <div class="row">
      <div class="col-lg-9">
        <p class="small text-uppercase mb-3 eyebrow"><%= t_.('eyebrow') %></p>
        <h1 class="mb-3"><%= t_.('hero_title') %></h1>
        <p class="hero-lede lead mb-4" style="max-width: 62ch"><%= t_.('hero_lede') %></p>
        <p class="d-flex flex-wrap gap-2 mb-0">
          <a href="<%= mailto %>" class="btn btn-primary btn-lg"><%= t_.('hero_cta_send') %></a>
          <a href="#engagement" class="btn btn-outline-light btn-lg"><%= t_.('hero_cta_how') %></a>
        </p>
      </div>
    </div>
  </div>
</section>

<%# ---- Three figures ---- %>
<section class="border-bottom py-4">
  <div class="container">
    <div class="row g-4 text-center text-lg-start align-items-center">
      <% (1..3).each do |i| %>
        <div class="col-md-4">
          <div class="stat">
            <span class="stat-n text-data"><%= t_.("stat#{i}_n") %></span>
            <span class="stat-l"><%= t_.("stat#{i}_l") %></span>
          </div>
        </div>
      <% end %>
    </div>
    <p class="small text-body-secondary text-center text-lg-start mt-3 mb-0"><%= t_.('stats_source') %></p>
  </div>
</section>

<%# ---- The reader's problem ---- %>
<section class="py-6">
  <div class="container">
    <h2 class="h3 mb-4"><%= t_.('scar_title') %></h2>
    <div class="row g-5">
      <div class="col-lg-6"><p class="mb-0"><%= t_.('scar_p1') %></p></div>
      <div class="col-lg-6"><p class="mb-0"><%= t_.('scar_p2') %></p></div>
    </div>
    <blockquote class="pull-quote mt-5 mb-0"><p class="mb-0"><%= t_.('pull_quote') %></p></blockquote>
  </div>
</section>

<%# ---- Four things we bring ---- %>
<section class="section--alt py-6">
  <div class="container">
    <h2 class="h3 mb-2"><%= t_.('brings_title') %></h2>
    <p class="text-body-secondary mb-4" style="max-width: 70ch"><%= t_.('brings_intro') %></p>
    <div class="row g-4 align-items-stretch">
      <% icons.each_with_index do |icon, i| %>
        <div class="col-md-6 col-xl-3">
          <div class="card h-100 p-3">
            <i class="bi <%= icon %> fs-3 text-primary"></i>
            <h3 class="h6 mt-2"><%= t_.("bring#{i + 1}_title") %></h3>
            <p class="text-body-secondary small mb-0"><%= t_.("bring#{i + 1}_text") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- Results ---- %>
<section class="py-6">
  <div class="container">
    <h2 class="h3 mb-4"><%= t_.('results_title') %></h2>
    <div class="row g-5">
      <% (1..3).each do |i| %>
        <div class="col-lg-4">
          <h3 class="h5"><%= t_.("res#{i}_title") %></h3>
          <p class="text-body-secondary mb-0"><%= t_.("res#{i}_text") %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- Platforms / scope ---- %>
<section class="section--alt py-6">
  <div class="container">
    <h2 class="h3 mb-3"><%= t_.('platforms_title') %></h2>
    <p class="platform-pills mb-3">
      <% (1..pills).each do |i| %><span><%= t_.("pill#{i}") %></span><% end %>
    </p>
    <p class="text-body-secondary mb-0" style="max-width: 70ch"><%= t_.('platforms_text') %></p>
  </div>
</section>

<%# ---- The engagement ---- %>
<section class="py-6" id="engagement">
  <div class="container">
    <h2 class="h3 mb-4"><%= t_.('engagement_title') %></h2>
    <div class="row g-4">
      <% (1..3).each do |i| %>
        <div class="col-md-4">
          <div class="story-step">
            <div class="story-index mb-2">0<%= i %></div>
            <h3 class="h6"><%= t_.("step#{i}_title") %></h3>
            <p class="text-body-secondary mb-0"><%= t_.("step#{i}_text") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ---- The ask. mt-6: the band follows an article on white. ---- %>
<section class="section--ink py-6 mt-6" data-bs-theme="dark">
  <div class="container text-center">
    <h2 class="mb-3"><%= t_.('cta_title') %></h2>
    <p class="text-body-secondary mx-auto mb-4" style="max-width: 62ch"><%= t_.('cta_text') %></p>
    <p class="d-flex flex-wrap gap-2 justify-content-center mb-0">
      <a href="<%= mailto %>" class="btn btn-primary btn-lg"><%= t_.('cta_primary') %></a>
      <a href="https://t.me/openipc" class="btn btn-outline-light btn-lg"><%= t_.('cta_secondary') %></a>
    </p>
    <p class="small mt-4 mb-0 text-body-secondary"><%= t_.('cta_note_html') %></p>
  </div>
</section>
