<%# Shot from a lab hi3516av300 running a current build. The captions are the
    page titles as the camera prints them: the WebUI is not translated, so
    quoting them is what a reader will actually match against on the device.

    The two pages with a live player show a beach rather than the lab bench of
    cables the camera actually points at -- see the credit under the grid. The
    scene is laid over the <video> in the DOM at capture time, the same way the
    lab's address and MAC are rewritten out of the text.

    Two files per screenshot. The tile loads the 1200px one, and the zoom modal
    swaps in the 2560px original from data-zoom -- both are 2x for the size they
    are shown at, because a 1x capture is what made the old gallery look soft on
    every Retina display. %>
<article class="webinterface">
  <header>
    <h2><%= t('.title') %></h2>
  </header>

  <p class="lead col-lg-8"><%= t('.intro') %></p>

  <%
    screens = [
      ['status',                  'Device Status'],
      ['preview',                 'Camera Preview'],
      ['majestic-settings',       'Majestic Settings'],
      ['majestic-endpoints',      'Majestic Endpoints'],
      ['majestic-configuration',  'Majestic Configuration'],
      ['logs',                    'Logs'],
      ['network',                 'Network Settings'],
      ['time',                    'Time Settings'],
      ['firmware-update',         'Firmware Update'],
      ['console',                 'Console'],
      ['file-manager',            'File Manager'],
      ['telegram',                'Telegram'],
    ]
  %>

  <div id="screens" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
    <% screens.each do |slug, caption| %>
      <div class="col">
        <figure class="mb-0">
          <%= image_tag "webui/#{slug}-thumb.webp",
                        class: 'border img-fluid img-zoom',
                        alt: "#{caption} page of the OpenIPC web interface",
                        loading: 'lazy', decoding: 'async',
                        data: { zoom: image_path("webui/#{slug}.webp") } %>
          <figcaption class="small text-muted mt-1"><%= caption %></figcaption>
        </figure>
      </div>
    <% end %>
  </div>

  <p class="small text-muted mt-3 col-lg-8"><%= t('.scene_credit_html') %></p>
</article>

<%= render 'pages/zoom' %>
