<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
<% @entries.each do |entry| %>
  <% entry[:alternates].each do |code, path| %>
  <url>
    <loc><%= request.base_url %><%= path %></loc>
    <% entry[:alternates].each do |alt_code, alt_path| %>
    <xhtml:link rel="alternate" hreflang="<%= alt_code %>" href="<%= request.base_url %><%= alt_path %>"/>
    <% end %>
    <xhtml:link rel="alternate" hreflang="x-default" href="<%= request.base_url %><%= entry[:alternates][I18n.default_locale] %>"/>
  </url>
  <% end %>
<% end %>
</urlset>
