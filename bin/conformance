#!/usr/bin/env bash
# Run the black-box conformance suite (#291) against the Go service.
#
#   bin/conformance                  build service/bin/openipc, boot it on a scratch
#                                    PostgreSQL database, run service/conformance
#   bin/conformance --mutations      the check on the check: break the upload six
#                                    ways, and require the suite to fail every time
#
# The suite boots the binary itself: a scratch database on the PostgreSQL named
# by CONFORMANCE_PG_URL (an admin URL), its own wall root, throwaway keys.
# With Go on the PATH (CI) it runs directly; without it, in the Go image
# through service/run.sh and service/conformance/run.sh, which bring their own
# PostgreSQL.
#
# To point the suite at something already running -- dev or production --
# use service/conformance/run.sh <base-url>.
#
# The mutations below are six mistakes a port of the upload could make, made
# in the Go handler.
set -euo pipefail
cd "$(dirname "$0")/.."

[ "${1:-}" = "--target" ] && shift 2   # accepted for old invocations; Go is the only target

log() { printf '\033[1m%s\033[0m\n' "$*" >&2; }

if command -v go >/dev/null 2>&1; then
  build() { (cd service && CGO_ENABLED=0 go build -trimpath -o bin/openipc ./cmd/openipc); }
  suite() {
    (cd service && CONFORMANCE_BOOT_BIN="$PWD/bin/openipc" \
      CONFORMANCE_PG_URL="${CONFORMANCE_PG_URL:-postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable}" \
      go test -count=1 "$@" ./conformance/)
  }
else
  build() { service/run.sh build >/dev/null; }
  suite() { GO_TEST_FLAGS="$*" service/conformance/run.sh; }
fi

if [ "${1:-}" != "--mutations" ]; then
  build
  suite "${@:--v}"
  exit $?
fi

# --- the check on the check ------------------------------------------------
#
# A conformance suite is worthless until it has been shown to fail. Each entry
# is a name, then one or more file|from|to edits; every one of them is a
# plausible thing for a port to get wrong, and the suite has to go red for
# each. Applied to the working tree and reverted with git, so run this on a
# clean tree.
#
# The sixth is the exemption the fleet depends on: the whitelisted address
# that is never rate limited.
UPLOAD=service/internal/snapshots/upload.go
MUTATIONS=(
  "hysteresis 2 minutes -> 0|$UPLOAD|HysteresisSeconds = 120|HysteresisSeconds = 0"
  "X-Error dropped|$UPLOAD|w.Header().Set(\"X-Error\", strings.Join(errs, \". \"))|_ = strings.Join(errs, \". \")"
  "Retry-After constant 900|$UPLOAD|strconv.Itoa(IntervalSeconds-int(elapsed))|strconv.Itoa(IntervalSeconds+0*int(elapsed))"
  "403 -> 422|$UPLOAD|httpx.Empty(w, http.StatusForbidden)|httpx.Empty(w, http.StatusUnprocessableEntity)"
  "Location absolute|$UPLOAD|location := \"/snapshots/\" + id|location := \"https://openipc.org/snapshots/\" + id"
  "whitelist exemption dropped|$UPLOAD|exempt := contains(h.Whitelist, u.RemoteIP)|exempt := false && contains(h.Whitelist, u.RemoteIP)"
)

MUTATED=()
restore_mutated() {
  [ "${#MUTATED[@]}" -gt 0 ] || return 0
  git checkout -- "${MUTATED[@]}"
  MUTATED=()
}
# Restored on ANY exit: without this, a failure mid-run leaves the checkout
# carrying a broken upload.
trap 'restore_mutated; build >/dev/null 2>&1 || true' EXIT

git diff --quiet -- service/internal || { log "service/internal has uncommitted changes; refusing to mutate it"; exit 2; }

mkdir -p service/bin
survived=0
for mutation in "${MUTATIONS[@]}"; do
  IFS='|' read -r -a parts <<<"$mutation"
  name=${parts[0]}
  for ((i = 1; i < ${#parts[@]}; i += 3)); do
    file=${parts[i]} from=${parts[i + 1]} to=${parts[i + 2]}
    grep -qF -- "$from" "$file" || { log "mutation '$name': '$from' is not in $file"; exit 2; }
    MUTATED+=("$file")
    FROM="$from" TO="$to" perl -0pi -e 's/\Q$ENV{FROM}\E/$ENV{TO}/' "$file"
  done

  log "mutation: $name"
  if ! build >service/bin/conformance-mutation.log 2>&1; then
    log "  did not build -- a mutation that breaks the build proves nothing about the suite"
    survived=$((survived + 1))
  elif suite >>service/bin/conformance-mutation.log 2>&1; then
    log "  SURVIVED -- the suite passed against a broken server"
    survived=$((survived + 1))
  else
    log "  killed -- $(grep -cE '^\s*--- FAIL' service/bin/conformance-mutation.log) failing test(s)"
  fi
  restore_mutated
done

[ "$survived" -eq 0 ] && log "all ${#MUTATIONS[@]} mutations killed" && exit 0
log "$survived mutation(s) survived"; exit 1
